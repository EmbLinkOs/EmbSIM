{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The workbench window: start the engine sidecar, open and save files, report its errors.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/embsim",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
