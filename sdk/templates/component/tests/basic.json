{
  "schema_version": 1,
  "kind": "component_test",
  "name": "basic",
  "description": "3.3 V across the part gives the expected current.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {"id": "V1", "component": "emblink/vsource", "params": {"kind": "dc", "dc": 3.3}},
      {"id": "DUT", "component": "mylib/my_part", "params": {"resistance": "1k"}},
      {"id": "G", "component": "emblink/gnd"}
    ],
    "nets": {"VIN": ["V1.+", "DUT.1"], "GND": ["V1.-", "DUT.2", "G.GND"]}
  },
  "inputs": [],
  "expect": {"device:DUT.i": {"at": "0.5ms", "min": 0.0032, "max": 0.0034}}
}
