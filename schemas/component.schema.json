{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emblink.dev/embsim/schemas/component.schema.json",
  "title": "EmbSIM component description",
  "description": "A catalog component: pins with pin models, parameters, interactive inputs and displayable outputs, model bindings, symbol, artwork, fidelity and provenance (SPEC-005).",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "name",
    "category",
    "pins",
    "symbol",
    "fidelity",
    "provenance"
  ],
  "anyOf": [
    {
      "required": [
        "model"
      ]
    },
    {
      "required": [
        "functional"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "component"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/catalog_id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "passives",
        "sources",
        "diodes",
        "transistors",
        "switches",
        "inputs",
        "indicators",
        "logic",
        "analog",
        "power",
        "connectors",
        "instruments",
        "displays",
        "sensors",
        "mechanical",
        "misc",
        "amplifiers",
        "comparators",
        "optoelectronics",
        "timers"
      ]
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "family": {
      "$ref": "pin-model.schema.json#/$defs/family",
      "description": "Default logic family for the component's digital pins (SPEC-005 §4)."
    },
    "pins": {
      "description": "The part's pins; none for a part that reaches the circuit only through the air (a Wi-Fi access point across the room).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/param"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "model": {
      "$ref": "#/$defs/model",
      "description": "Behaviour for timed and electrical sessions."
    },
    "functional": {
      "$ref": "#/$defs/model",
      "description": "Behaviour under the functional policy when it differs from model."
    },
    "timed": {
      "$ref": "#/$defs/timing",
      "description": "Datasheet timing used by timed sessions (SPEC-003 §5)."
    },
    "symbol": {
      "$ref": "#/$defs/symbol"
    },
    "artwork": {
      "$ref": "#/$defs/artwork"
    },
    "ties": {
      "type": "array",
      "description": "Groups of this component's pins joined inside it by an ideal conductor: a breadboard's strips, a connector's shorted contacts (SPEC-005 §2).",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bench": {
      "$ref": "#/$defs/bench"
    },
    "fidelity": {
      "$ref": "common.schema.json#/$defs/fidelity"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fixture files or globs relative to the component directory."
    },
    "part": {
      "type": "object",
      "required": [
        "manufacturer",
        "mpn",
        "package",
        "datasheet"
      ],
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "mpn": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "datasheet": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://"
        }
      }
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "name",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/pin_name"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "$ref": "pin-model.schema.json"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/pin_name"
          },
          "uniqueItems": true
        },
        "doc": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "power_ref": {
          "$ref": "common.schema.json#/$defs/pin_name",
          "description": "For digital pins: the name of this component's supply pin, used by bridges."
        },
        "ground_ref": {
          "$ref": "common.schema.json#/$defs/pin_name"
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "enum",
            "table"
          ]
        },
        "unit": {
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/si_number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "min": {
          "$ref": "common.schema.json#/$defs/si_number"
        },
        "max": {
          "$ref": "common.schema.json#/$defs/si_number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "doc": {
          "type": "string"
        },
        "advanced": {
          "type": "boolean"
        },
        "presets": {
          "type": "object",
          "description": "For enum parameters: values of other parameters applied when this value is chosen (a named part sets its device parameters).",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/param_values"
          }
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Without a default, require an instance value unless false. Optional absent values let model bindings inherit other parameters."
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean",
            "number",
            "integer",
            "enum",
            "string",
            "bytes"
          ]
        },
        "default": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "doc": {
          "type": "string"
        },
        "world": {
          "type": "string",
          "enum": [
            "temperature",
            "humidity",
            "pressure",
            "illuminance",
            "sound",
            "wind",
            "distance",
            "motion"
          ],
          "description": "The world's field the input reads while it is not set (ADR-026): its value in the input's unit (degC, %, hPa, lx, dB, m/s; distance, the nearest body along bench.sense, in mm, cm or m); the input's default while the world does not declare the field."
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean",
            "number",
            "integer",
            "enum",
            "string",
            "bytes",
            "bitmap"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "model": {
      "oneOf": [
        {
          "$ref": "#/$defs/primitive_model"
        },
        {
          "$ref": "#/$defs/composite_model"
        },
        {
          "$ref": "#/$defs/script_model"
        },
        {
          "$ref": "#/$defs/native_model"
        }
      ]
    },
    "primitive_model": {
      "type": "object",
      "required": [
        "primitive"
      ],
      "additionalProperties": false,
      "properties": {
        "primitive": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "bind": {
          "type": "object",
          "description": "primitive parameter or input name -> this component's parameter or input name; omitted names bind by identity.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "params": {
          "description": "Fixed primitive parameters not exposed by the component (a preset).",
          "$ref": "common.schema.json#/$defs/param_values"
        }
      }
    },
    "composite_model": {
      "type": "object",
      "required": [
        "composite"
      ],
      "additionalProperties": false,
      "properties": {
        "composite": {
          "type": "object",
          "required": [
            "components",
            "nets",
            "ports"
          ],
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "component"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "common.schema.json#/$defs/instance_id"
                  },
                  "component": {
                    "$ref": "common.schema.json#/$defs/catalog_id"
                  },
                  "version": {
                    "$ref": "common.schema.json#/$defs/version_range"
                  },
                  "params": {
                    "$ref": "common.schema.json#/$defs/param_values"
                  }
                }
              }
            },
            "nets": {
              "$ref": "common.schema.json#/$defs/nets"
            },
            "ports": {
              "type": "object",
              "description": "This component's pin name -> internal pin reference.",
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/pin_ref"
              }
            }
          }
        }
      }
    },
    "script_model": {
      "type": "object",
      "required": [
        "script",
        "api"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "pattern": "\\.lua$"
        },
        "api": {
          "const": 1
        }
      }
    },
    "native_model": {
      "type": "object",
      "required": [
        "native"
      ],
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "object",
          "required": [
            "plugin",
            "model",
            "abi"
          ],
          "additionalProperties": false,
          "properties": {
            "plugin": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "abi": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tpd": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "tplh": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "tphl": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "tco": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "setup": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "hold": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "min_pulse": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "rise": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "fall": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "transport": {
          "type": "boolean",
          "description": "Transport instead of inertial delay."
        }
      }
    },
    "symbol": {
      "type": "object",
      "required": [
        "svg",
        "width",
        "height",
        "pins"
      ],
      "additionalProperties": false,
      "properties": {
        "svg": {
          "type": "string",
          "pattern": "\\.svg$"
        },
        "width": {
          "type": "integer",
          "minimum": 10,
          "multipleOf": 10
        },
        "height": {
          "type": "integer",
          "minimum": 10,
          "multipleOf": 10
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "x",
              "y",
              "side"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "multipleOf": 10
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "multipleOf": 10
              },
              "side": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "label": {
                "type": "boolean",
                "description": "Draw the pin name beside the pin (default false)."
              }
            }
          },
          "description": "Pin name -> its position; every pin has one, except a wiring aid's (SPEC-005 §2.1)."
        },
        "states": {
          "$ref": "#/$defs/artwork/properties/states"
        },
        "hotspots": {
          "$ref": "#/$defs/artwork/properties/hotspots"
        }
      }
    },
    "artwork": {
      "type": "object",
      "required": [
        "svg"
      ],
      "additionalProperties": false,
      "properties": {
        "svg": {
          "type": "string",
          "pattern": "\\.svg$"
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input",
              "selector",
              "gesture"
            ],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "gesture": {
                "type": "string",
                "enum": [
                  "hold",
                  "toggle",
                  "drag"
                ]
              },
              "axis": {
                "type": "string",
                "enum": [
                  "x",
                  "y",
                  "angle"
                ],
                "description": "drag only."
              },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                },
                "description": "drag only: input values at the two ends of the travel."
              },
              "travel": {
                "type": "number",
                "description": "drag only: pixels (x, y) or degrees (angle) of travel across the range."
              },
              "key": {
                "type": "string",
                "description": "Keyboard equivalent."
              }
            }
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "output",
              "selector"
            ],
            "additionalProperties": false,
            "properties": {
              "output": {
                "type": "string",
                "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?[a-z][a-z0-9_]*$",
                "description": "An output of the component, or MEMBER.OUTPUT for a composite's member (a board's LED)"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "attr": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "true": {
                "type": "string"
              },
              "false": {
                "type": "string"
              },
              "scale": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "to": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "map": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "enum or integer output value -> attribute value."
              },
              "precision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "format": {
                "type": "string",
                "description": "A template whose \"{}\" takes the output's value (after scale for numbers): rotate({} 30 30), a colour, a path. attr \"text\" sets the element's text."
              }
            }
          }
        }
      }
    },
    "bench": {
      "type": "object",
      "description": "The part as it sits on the bench (SPEC-005 §2.1): its package, its size and where its legs or pins are, in millimetres from its top-left corner seen from above.",
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "enum": [
            "breadboard",
            "axial",
            "radial",
            "led",
            "to92",
            "to220",
            "sot23",
            "sot223",
            "dip",
            "tactile",
            "switch",
            "pot",
            "module",
            "board",
            "box"
          ],
          "description": "The body the 3D bench builds."
        },
        "size_mm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Width (x), depth (y) and height above the bench (z)."
        },
        "pins": {
          "type": "object",
          "description": "Pin name -> [x, y] of its leg in mm.",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "wiring_aid": {
          "type": "boolean",
          "description": "A part that only connects (a breadboard): the schematic shows the connections it makes, not the part."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "The body's colour."
        },
        "label": {
          "type": "string",
          "description": "The marking printed on the body."
        },
        "sense": {
          "type": "object",
          "additionalProperties": false,
          "description": "A distance sensor's beam: from `at` along `dir`, in the part's own coordinates (mm from its centre: x right, y towards the viewer, z up), turned with the part.",
          "properties": {
            "at": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "dir": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "led": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "diameter_mm",
            "flange_mm",
            "body_height_mm",
            "standoff_mm"
          ],
          "properties": {
            "diameter_mm": {
              "type": "number",
              "minimum": 1,
              "maximum": 20
            },
            "flange_mm": {
              "type": "number",
              "minimum": 1,
              "maximum": 25
            },
            "body_height_mm": {
              "type": "number",
              "minimum": 1,
              "maximum": 30
            },
            "standoff_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            }
          }
        },
        "model3d": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "source",
            "license"
          ],
          "description": "A 3D model drawn instead of the body the bench builds (docs/engineering/bench-3d.md, stage 3): a VRML file beside the description, placed so its legs land on the pins. Its licence and source are recorded here (ADR-029).",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "\\.wrl$",
              "description": "The model's file, relative to the description (VRML 2.0, as KiCad's library ships)."
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Millimetres per model unit (KiCad's VRML: 2.54)."
            },
            "offset_mm": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "Where the model's origin goes, mm from the part's centre: x right, y towards the viewer, z up."
            },
            "rotation_deg": {
              "type": "number",
              "description": "A turn about the vertical, degrees, after the model is stood Z-up."
            },
            "source": {
              "type": "string",
              "description": "Where the model comes from (its library, file and revision)."
            },
            "license": {
              "type": "string",
              "description": "The model's licence."
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "temperature_c",
        "current_a",
        "voltage_tolerance_v",
        "source",
        "curves"
      ],
      "properties": {
        "scope": {
          "const": "nominal-dc"
        },
        "temperature_c": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "current_a": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 1
          }
        },
        "voltage_tolerance_v": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "revision",
            "sha256",
            "pages"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "curves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pin",
              "reference_current_a",
              "pdf_path_indices",
              "axes_pdf_pt",
              "axis_voltage_v",
              "axis_max_current_a",
              "points",
              "page"
            ],
            "properties": {
              "pin": {
                "type": "string",
                "minLength": 1
              },
              "reference_current_a": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 1
              },
              "pdf_path_indices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "axes_pdf_pt": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                }
              },
              "axis_voltage_v": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "axis_max_current_a": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 1
              },
              "points": {
                "type": "array",
                "minItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "current_a",
                    "voltage_v",
                    "role",
                    "fixture"
                  ],
                  "properties": {
                    "current_a": {
                      "type": "number",
                      "minimum": 1e-06,
                      "maximum": 1
                    },
                    "voltage_v": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 10
                    },
                    "role": {
                      "enum": [
                        "calibration",
                        "holdout"
                      ]
                    },
                    "fixture": {
                      "type": "string",
                      "pattern": "^tests/[a-z0-9_-]+\\.json$"
                    }
                  }
                }
              },
              "page": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
