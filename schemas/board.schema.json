{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emblink.dev/embsim/schemas/board.schema.json",
  "title": "EmbSIM board description",
  "description": "A board: its MCU and package, oscillators, on-board components and nets, exposed ports, quick controls, artwork and toolchain settings (SPEC-006 §3).",
  "type": "object",
  "required": ["schema_version", "kind", "id", "version", "name", "mcu", "components", "nets", "ports", "fidelity", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "board"},
    "id": {"$ref": "common.schema.json#/$defs/catalog_id"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "revision": {"type": "string"},
    "mcu": {
      "type": "object",
      "required": ["ref", "package", "instance"],
      "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "common.schema.json#/$defs/catalog_id"},
        "version": {"$ref": "common.schema.json#/$defs/version_range"},
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "instance": {"$ref": "common.schema.json#/$defs/instance_id"}
      }
    },
    "oscillators": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["hz", "source"],
        "additionalProperties": false,
        "properties": {
          "hz": {"type": "integer", "minimum": 1},
          "source": {"type": "string", "enum": ["external_crystal", "external_clock", "oscillator_module", "none"]},
          "component": {"$ref": "common.schema.json#/$defs/instance_id"}
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/instance_id"},
          "component": {"$ref": "common.schema.json#/$defs/catalog_id"},
          "version": {"$ref": "common.schema.json#/$defs/version_range"},
          "params": {"$ref": "common.schema.json#/$defs/param_values"},
          "doc": {"type": "string"},
          "todo": {"type": "boolean", "description": "Importer placeholder; validation refuses it (SPEC-006 §4)."}
        }
      }
    },
    "nets": {"$ref": "common.schema.json#/$defs/nets"},
    "ports": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_+\\-/.~#]+$"},
      "additionalProperties": {
        "type": "object",
        "required": ["net"],
        "additionalProperties": false,
        "properties": {
          "net": {"type": "string", "minLength": 1},
          "connector": {"$ref": "common.schema.json#/$defs/instance_id"},
          "pin": {"type": "integer", "minimum": 1},
          "doc": {"type": "string"}
        }
      }
    },
    "leds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "component"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "component": {"$ref": "common.schema.json#/$defs/instance_id"},
          "gpio": {"type": "string", "pattern": "^(P[A-Z][0-9]+|R[A-K][0-9]+|GPIO[0-9]+)$"},
          "active": {"type": "string", "enum": ["low", "high"]},
          "color": {"type": "string"},
          "doc": {"type": "string"}
        }
      }
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "component"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "component": {"$ref": "common.schema.json#/$defs/instance_id"},
          "signal": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "gpio": {"type": "string", "pattern": "^(P[A-Z][0-9]+|R[A-K][0-9]+|GPIO[0-9]+)$"},
          "active": {"type": "string", "enum": ["low", "high"]},
          "doc": {"type": "string"}
        }
      }
    },
    "console": {
      "type": "object",
      "required": ["peripheral"],
      "additionalProperties": false,
      "properties": {
        "peripheral": {"type": "string"},
        "tx": {"type": "string", "pattern": "^(P[A-Z][0-9]+|R[A-K][0-9]+|GPIO[0-9]+)$"},
        "rx": {"type": "string", "pattern": "^(P[A-Z][0-9]+|R[A-K][0-9]+|GPIO[0-9]+)$"},
        "baud": {"type": "integer", "minimum": 1}
      }
    },
    "artwork": {
      "type": "object",
      "required": ["svg"],
      "additionalProperties": false,
      "properties": {
        "svg": {"type": "string", "pattern": "\\.svg$"},
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0},
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["selector"],
            "oneOf": [{"required": ["component"]}, {"required": ["port"]}],
            "additionalProperties": false,
            "properties": {
              "component": {"$ref": "common.schema.json#/$defs/instance_id"},
              "port": {"type": "string"},
              "selector": {"type": "string", "minLength": 1},
              "input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            }
          }
        }
      }
    },
    "toolchains": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {"type": "string"},
          "cpu": {"type": "string"},
          "arch": {"type": "string"},
          "abi": {"type": "string"},
          "mcu": {"type": "string"},
          "part": {"type": "string"},
          "flags": {"type": "array", "items": {"type": "string"}},
          "link": {"type": "array", "items": {"type": "string"}},
          "defines": {"type": "array", "items": {"type": "string"}},
          "linker_script": {"type": "string"},
          "f_cpu": {"type": "integer", "minimum": 1}
        }
      }
    },
    "fidelity": {"$ref": "common.schema.json#/$defs/fidelity"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "tests": {"type": "array", "items": {"type": "string"}}
  }
}
