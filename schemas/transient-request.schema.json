{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "transient_request"
    },
    "start": {
      "type": "string",
      "minLength": 1
    },
    "stop": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(net|pin):.+$",
        "maxLength": 191
      }
    }
  },
  "required": [
    "start",
    "stop",
    "step",
    "probes"
  ],
  "$id": "https://emblink.dev/embsim/schemas/transient-request.schema.json",
  "title": "Isolated uniform native transient capture request"
}
