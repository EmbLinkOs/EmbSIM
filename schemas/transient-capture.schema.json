{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "transient_capture"
    },
    "method": {
      "const": "reset_uniform_sample"
    },
    "source": {
      "$ref": "engineering-manifest.schema.json"
    },
    "request": {
      "$ref": "transient-request.schema.json"
    },
    "ok": {
      "type": "boolean"
    },
    "ended_at_ps": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "failure": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 4097,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at_ps": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "measurements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "logic": {
                  "enum": [
                    "0",
                    "1",
                    "X",
                    "Z"
                  ]
                },
                "voltage": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "target",
                "logic",
                "voltage"
              ]
            }
          }
        },
        "required": [
          "at_ps",
          "measurements"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "method",
    "source",
    "request",
    "ok",
    "ended_at_ps",
    "failure",
    "diagnostics",
    "samples"
  ],
  "$id": "https://emblink.dev/embsim/schemas/transient-capture.schema.json",
  "title": "Native uniformly sampled transient prefix with exact source evidence"
}
