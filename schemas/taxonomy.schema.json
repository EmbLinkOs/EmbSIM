{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emblink.dev/embsim/schemas/taxonomy.schema.json",
  "title": "EmbSIM catalog taxonomy",
  "description": "The catalog's categories and sub-categories (after Proteus's device categories), named in each interface language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "categories",
    "legacy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "taxonomy"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "subcategories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "fr",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "name": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "fr",
                    "es"
                  ],
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "es": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "legacy": {
      "description": "Categories of the catalog before the taxonomy, still accepted (a warning), and the category each is shown under.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
