{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emblink.dev/embsim/schemas/project.schema.json",
  "title": "EmbSIM project",
  "description": "A project: libraries, policy, boards with firmware, component instances, nets (the electrical truth), presentation layout, probes, scenarios and settings (SPEC-007 §1).",
  "type": "object",
  "required": ["schema_version", "kind", "name", "policy", "nets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "project"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "libraries": {"type": "array", "items": {"type": "string"}, "description": "Library directories relative to the project file (SPEC-014 §2)."},
    "policy": {"$ref": "common.schema.json#/$defs/policy"},
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "board"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/instance_id"},
          "board": {"$ref": "common.schema.json#/$defs/catalog_id"},
          "version": {"$ref": "common.schema.json#/$defs/version_range"},
          "firmware": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "image": {"type": "string", "minLength": 1},
              "format": {"type": "string", "enum": ["elf", "hex", "bin"], "description": "bin: a flash image from offset 0, for a part whose flash no address reaches (an ESP32-C3's, as esptool's merge_bin writes it)"},
              "toolchain": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "sources": {"type": "array", "items": {"type": "string"}},
              "flags": {"type": "array", "items": {"type": "string"}},
              "link_flags": {"type": "array", "items": {"type": "string"}, "description": "Flags for the link alone, after the profile's (SPEC-010 §2): a freestanding program's -nostartfiles"},
              "defines": {"type": "array", "items": {"type": "string"}},
              "include": {"type": "array", "items": {"type": "string"}},
              "linker_script": {"type": "string", "minLength": 1, "description": "The linker script, relative to the project; without one, the board's for the profile (SPEC-006 §3)"}
            }
          },
          "layout": {"$ref": "common.schema.json#/$defs/layout"},
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sram_size": {"$ref": "common.schema.json#/$defs/hex_or_size", "description": "Resize of the MCU's main RAM region."},
              "flash_size": {"$ref": "common.schema.json#/$defs/hex_or_size"},
              "mac": {"type": "string", "pattern": "^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$", "description": "The chip's factory MAC address, for a part that keeps one (an ESP32-C3's eFuse BLOCK1): two boards of a project are two chips. Without it, the part description's."}
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/instance_id"},
          "component": {"$ref": "common.schema.json#/$defs/catalog_id"},
          "version": {"$ref": "common.schema.json#/$defs/version_range"},
          "params": {"$ref": "common.schema.json#/$defs/param_values"},
          "layout": {"$ref": "common.schema.json#/$defs/layout"},
          "doc": {"type": "string"}
        }
      }
    },
    "nets": {"$ref": "common.schema.json#/$defs/nets"},
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["net", "points"],
            "additionalProperties": false,
            "properties": {
              "net": {"type": "string"},
              "points": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
            }
          }
        },
        "buses": {
          "type": "array",
          "description": "Presentation only: a named group of nets drawn as one line; the nets stay in `nets`. The first net is bit 0 of the bus's value.",
          "items": {
            "type": "object",
            "required": ["name", "nets", "points"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "nets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "points": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
            }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["net", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "net": {"type": "string"},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "rotation": {"type": "number", "enum": [0, 90, 180, 270]}
            }
          }
        },
        "groups": {
          "type": "array",
          "description": "Presentation groups of top-level instances; a part belongs to at most one group.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "members"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "sheet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "bench": {
          "type": "object",
          "description": "The bench (ADR-027, SPEC-007 §2): where the boards and parts sit, in millimetres, the jumper wires between their pins and the breadboards' holes, and notes. The connections are in `nets`; a jumper's ends are in the same net.",
          "additionalProperties": false,
          "properties": {
            "parts": {
              "type": "object",
              "description": "Instance id -> the centre of the part on the bench and its turn, clockwise.",
              "additionalProperties": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "rotation": {"type": "number", "enum": [0, 90, 180, 270]}
                }
              }
            },
            "wires": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "additionalProperties": false,
                "properties": {
                  "from": {"$ref": "common.schema.json#/$defs/pin_ref"},
                  "to": {"$ref": "common.schema.json#/$defs/pin_ref"},
                  "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "text"],
                "additionalProperties": false,
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "text": {"type": "string", "minLength": 1},
                  "to": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "Where the note points, on the bench."}
                }
              }
            }
          }
        }
      }
    },
    "world": {
      "type": "object",
      "description": "The room the circuit sits in (ADR-026, SPEC-007 §2): the fields it declares, which every sensor bound to them reads, and bodies on the bench that distance sensors see. A field not declared leaves each sensor at its own default.",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {"type": "number", "minimum": -273.15, "description": "degC"},
            "humidity": {"type": "number", "minimum": 0, "maximum": 100, "description": "% relative humidity"},
            "pressure": {"type": "number", "exclusiveMinimum": 0, "description": "hPa"},
            "illuminance": {"type": "number", "minimum": 0, "description": "lx"},
            "sound": {"type": "number", "description": "dB SPL"},
            "wind": {"type": "number", "minimum": 0, "description": "m/s"}
          }
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "at", "size"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
              "name": {"type": "string"},
              "shape": {"type": "string", "enum": ["box", "sphere"]},
              "at": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}, "description": "Centre on the bench, mm: x right, y towards the viewer, z up."},
              "size": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}, "description": "Width, depth, height, mm (a sphere's diameter first)."},
              "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
            }
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
          "target": {"type": "string", "pattern": "^(net|pin|device|reg|mem|var|serial|output):.+$"},
          "kind": {"type": "string", "enum": ["digital", "analog", "serial", "value"]},
          "rate_hz": {"type": "number", "exclusiveMinimum": 0},
          "decode": {
            "type": "object",
            "required": ["protocol"],
            "additionalProperties": false,
            "properties": {
              "protocol": {"type": "string", "enum": ["uart", "spi", "i2c"]},
              "params": {"type": "object"}
            }
          },
          "doc": {"type": "string"}
        }
      }
    },
    "scenarios": {"type": "array", "items": {"type": "string", "pattern": "\\.json$"}},
    "settings": {"$ref": "common.schema.json#/$defs/settings"}
  }
}
