{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "ac_sweep"
    },
    "method": {
      "const": "linear_phasor_mna"
    },
    "unit": {
      "enum": [
        "V/V",
        "ohm"
      ]
    },
    "excitation": {
      "const": "unit_real_source_phasor"
    },
    "ok": {
      "const": true
    },
    "source": {
      "$ref": "engineering-manifest.schema.json"
    },
    "request": {
      "$ref": "ac-sweep-request.schema.json"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frequency_hz": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000000000.0
          },
          "responses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 191
                },
                "real": {
                  "type": "number"
                },
                "imag": {
                  "type": "number"
                },
                "magnitude": {
                  "type": "number",
                  "minimum": 0
                },
                "db": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "phase_deg": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "target",
                "real",
                "imag",
                "magnitude",
                "db",
                "phase_deg"
              ]
            }
          }
        },
        "required": [
          "frequency_hz",
          "responses"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "method",
    "unit",
    "excitation",
    "ok",
    "source",
    "request",
    "points"
  ],
  "$id": "https://emblink.dev/embsim/schemas/ac-sweep.schema.json"
}
