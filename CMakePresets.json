{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {"name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}",
     "cacheVariables": {"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}},
    {"name": "dev", "inherits": "base", "displayName": "Development (default compiler, debug)",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "release", "inherits": "base", "displayName": "Release (default compiler)",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "ci-gcc", "inherits": "base", "generator": "Ninja",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_C_COMPILER": "gcc"}},
    {"name": "ci-clang", "inherits": "base", "generator": "Ninja",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_C_COMPILER": "clang"}},
    {"name": "ci-tcc", "inherits": "base", "generator": "Ninja",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "tcc"}},
    {"name": "ci-msvc", "inherits": "base", "generator": "Ninja",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_C_COMPILER": "cl"}},
    {"name": "asan", "inherits": "base", "generator": "Ninja", "displayName": "Address and UB sanitizers (GCC, whose runtime ships with it)",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "gcc",
       "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
       "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"}}
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "release", "configurePreset": "release"},
    {"name": "ci-gcc", "configurePreset": "ci-gcc"},
    {"name": "ci-clang", "configurePreset": "ci-clang"},
    {"name": "ci-tcc", "configurePreset": "ci-tcc"},
    {"name": "ci-msvc", "configurePreset": "ci-msvc"},
    {"name": "asan", "configurePreset": "asan"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "ci-gcc", "configurePreset": "ci-gcc", "output": {"outputOnFailure": true}},
    {"name": "ci-clang", "configurePreset": "ci-clang", "output": {"outputOnFailure": true}},
    {"name": "ci-tcc", "configurePreset": "ci-tcc", "output": {"outputOnFailure": true}},
    {"name": "ci-msvc", "configurePreset": "ci-msvc", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}}
  ]
}
