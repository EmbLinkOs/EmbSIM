{
 "schema_version": 1,
 "kind": "project",
 "name": "uno-blink-serial",
 "description": "An Arduino Uno running firmware/main.c (bare registers, no Arduino core): the L LED blinks at 1 Hz from Timer0's 1 ms tick, a potentiometer on A0 is read by the ADC every 250 ms and printed at 9600 baud on a virtual terminal, and sets the brightness of a blue LED on D9 through Timer1's PWM; a button on D2 interrupts on INT0 and is counted.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "firmware/blink-serial.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "firmware/startup.S",
     "firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "linker_script": "firmware/atmega328p.ld"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "POT",
   "component": "emblink/potentiometer",
   "params": {
    "resistance": "10k"
   },
   "layout": {
    "x": 700,
    "y": 180
   }
  },
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 700,
    "y": 300
   }
  },
  {
   "id": "R1",
   "component": "emblink/resistor",
   "params": {
    "resistance": 330
   },
   "layout": {
    "x": 700,
    "y": 400
   }
  },
  {
   "id": "D1",
   "component": "emblink/led",
   "params": {
    "color": "blue"
   },
   "layout": {
    "x": 840,
    "y": 400
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 9600
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  }
 ],
