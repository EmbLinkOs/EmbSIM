{
 "schema_version": 1,
 "kind": "project",
 "name": "uno-breadboard",
 "description": "The uno-blink-serial circuit built on an 830-point breadboard as on a desk: the potentiometer, the button, the resistor and the blue LED plugged into its strips, the rails fed from the Uno's 5V and GND, jumpers to D2, D9 and A0, a USB-serial adapter on D0 and D1. The same firmware and the same scenario as uno-blink-serial pass on it.",
 "policy": "electrical",
