   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "../uno-blink-serial/firmware/blink-serial.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "../uno-blink-serial/firmware/startup.S",
     "../uno-blink-serial/firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "link_flags": [
     "-nostartfiles"
    ],
    "linker_script": "../uno-blink-serial/firmware/atmega328p.ld"
   }
  }
 ],
