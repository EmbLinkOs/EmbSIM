{
  "schema_version": 1,
  "kind": "scenario",
  "name": "firmware-rgb-pwm",
  "description": "Registers programmed by firmware: 1 kHz, 25/50/75% duty, physical mode button selects off/full/mixed. Time-weighted electrical averages use captured samples, not GUI frames.",
  "until": "330ms",
  "inputs": [
    {
      "at": "270ms",
      "target": "MODE",
      "input": "pressed",
      "value": true
    },
    {
      "at": "275ms",
      "target": "MODE",
      "input": "pressed",
      "value": false
    },
    {
      "at": "290ms",
      "target": "MODE",
      "input": "pressed",
      "value": true
    },
    {
      "at": "295ms",
      "target": "MODE",
      "input": "pressed",
      "value": false
    },
    {
      "at": "310ms",
      "target": "MODE",
      "input": "pressed",
      "value": true
    },
    {
      "at": "315ms",
      "target": "MODE",
      "input": "pressed",
      "value": false
    }
  ],
  "assertions": [
    {
      "id": "mixed_duty_R",
      "probe": "pwm_R",
      "between": [
        "255ms",
        "265ms"
      ],
      "expect": {
        "equals": 0.25,
        "tolerance": 0.002
      },
      "measure": "duty_cycle"
    },
    {
      "id": "mixed_frequency_R",
      "probe": "pwm_R",
      "between": [
        "255ms",
        "265ms"
      ],
      "expect": {
        "frequency_hz": 1000,
        "tolerance": 0.01
      }
    },
    {
      "id": "off_duty_R",
      "probe": "pwm_R",
      "between": [
        "280ms",
        "288ms"
      ],
      "expect": {
        "equals": 0,
        "tolerance": 0.002
      },
      "measure": "duty_cycle"
    },
    {
      "id": "full_duty_R",
      "probe": "pwm_R",
      "between": [
        "300ms",
        "308ms"
      ],
      "expect": {
        "equals": 1,
        "tolerance": 0.002
      },
      "measure": "duty_cycle"
    },
    {
      "id": "restored_duty_R",
      "probe": "pwm_R",
      "between": [
        "320ms",
        "328ms"
      ],
      "expect": {
        "equals": 0.25,
        "tolerance": 0.002
      },
      "measure": "duty_cycle"
    },
    {
      "id": "restored_frequency_R",
      "probe": "pwm_R",
      "between": [
        "320ms",
        "328ms"
      ],
      "expect": {
        "frequency_hz": 1000,
        "tolerance": 0.01
      }
    },
    {
      "id": "mixed_duty_G",
      "probe": "pwm_G",
      "between": [
        "255ms",
        "265ms"
      ],
      "expect": {
        "equals": 0.5,
        "tolerance": 0.002
      },
      "measure": "duty_cycle"
    },
    {
      "id": "mixed_frequency_G",
