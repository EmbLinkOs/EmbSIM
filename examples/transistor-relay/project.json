{
  "schema_version": 1,
  "kind": "project",
  "name": "transistor-relay",
  "description": "A 2N3904 drives a G5LE-1 5 V relay coil; a 1N4007 freewheel diode clamps inductive turn-off. Contacts switch a separate 12 V load.",
