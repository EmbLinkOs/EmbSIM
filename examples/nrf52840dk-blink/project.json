{
 "schema_version": 1,
 "kind": "project",
 "name": "nrf52840dk-blink",
 "description": "An nRF52840 DK running firmware/main.c on its nRF52840 (Cortex-M4F): LED1 blinks at 1 Hz from RTC1's compare on the 32.768 kHz crystal, a button on D2 is GPIOTE's falling edge and is counted, the FPU computes sqrt(2) for the banner, and what a virtual terminal on the virtual COM port's pins sends at 115200 baud comes back in upper case through UARTE0's EasyDMA.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nrf52840dk",
   "layout": {
    "x": 320,
    "y": 120
   },
   "firmware": {
    "image": "firmware/blink.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "firmware/startup.c",
     "firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "linker_script": "firmware/nrf52840.ld"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 760,
    "y": 100
   }
  },
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 60,
    "y": 200
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 40,
    "y": 380
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 760,
    "y": 300
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "SW1.2",
   "VT1.GND"
  ],
  "BTN": [
   "B1.D2",
   "SW1.1"
  ],
  "UART_TX": [
   "B1.P0_06",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.P0_08",
   "VT1.TX"
  ]
