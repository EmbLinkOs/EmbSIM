      "U2.D",
      "U3.CLK"
    ],
    "Q2": [
      "U2.Q"
    ],
    "T3": [
      "U3.QN",
      "U3.D"
    ],
    "Q3": [
      "U3.Q"
    ],
    "RSTIN": [
      "HI.OUT",
      "RESET.1"
    ],
    "RST": [
      "RESET.2",
      "RP.1",
      "U0.R",
      "U1.R",
      "U2.R",
      "U3.R"
    ]
  },
