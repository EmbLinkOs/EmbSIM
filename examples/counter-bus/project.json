{
  "schema_version": 1,
  "kind": "project",
  "name": "counter-bus",
  "description": "A 4-bit ripple counter of D flip-flops on a 1 kHz clock. Each stage toggles (D from its inverted output) and clocks the next; the outputs Q0..Q3 are drawn as the bus Q, which shows the count while it runs. The clock's first edge comes 0.5 ms after power-up; RESET clears the count at any time.",
  "policy": "functional",
  "components": [
    {
      "id": "CLK",
      "component": "emblink/clock_source",
      "params": {
        "freq": "1k",
        "td": "0.5m"
      },
      "layout": {
        "x": 40,
        "y": 100
      }
    },
    {
      "id": "U0",
      "component": "emblink/dff",
      "layout": {
        "x": 160,
        "y": 80
      }
    },
    {
      "id": "U1",
      "component": "emblink/dff",
      "layout": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "U2",
      "component": "emblink/dff",
      "layout": {
        "x": 440,
        "y": 80
      }
    },
    {
      "id": "U3",
      "component": "emblink/dff",
      "layout": {
        "x": 580,
        "y": 80
      }
    },
    {
      "id": "HI",
      "component": "emblink/logic_level",
      "params": {
        "level": 1
      },
      "layout": {
        "x": -60,
        "y": 190
      }
    },
    {
      "id": "RESET",
      "component": "emblink/push_button",
      "layout": {
        "x": 0,
        "y": 190
      }
    },
    {
      "id": "RP",
      "component": "emblink/pull_down",
      "layout": {
        "x": 70,
        "y": 200
      }
    }
  ],
  "nets": {
    "CLK": [
      "CLK.OUT",
      "U0.CLK"
    ],
    "T0": [
      "U0.QN",
      "U0.D",
      "U1.CLK"
    ],
    "Q0": [
      "U0.Q"
    ],
    "T1": [
      "U1.QN",
      "U1.D",
      "U2.CLK"
    ],
    "Q1": [
      "U1.Q"
    ],
    "T2": [
