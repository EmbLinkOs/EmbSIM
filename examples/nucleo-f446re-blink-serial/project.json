{
 "schema_version": 1,
 "kind": "project",
 "name": "nucleo-f446re-blink-serial",
 "description": "A NUCLEO-F446RE running firmware/main.c on its STM32F446RE (Cortex-M4F): HSE in bypass from the ST-LINK's 8 MHz MCO, the PLL and over-drive to 180 MHz, LD2 on PA5 blinking at 1 Hz from SysTick, the blue USER button B1 on PC13 counted through EXTI13, and the ST-LINK's virtual COM port (USART2 at 115200 baud) echoing what it receives in upper case. The board runs from its USB connector's 5 V.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446re",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "firmware/blink-serial.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "firmware/startup.c",
     "firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "linker_script": "firmware/stm32f446re.ld"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PA5",
   "kind": "digital"
  },
  {
   "id": "btn",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "vdd",
   "target": "net:B1.VDD",
   "kind": "analog",
   "rate_hz": 1000
  }
 ],
 "scenarios": [
  "scenarios/blink.json"
 ]
}
