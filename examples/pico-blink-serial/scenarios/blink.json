{
  "schema_version": 1,
  "kind": "scenario",
  "name": "blink",
  "until": "2.2s",
  "description": "The banner with clk_sys as the frequency counter measures it; the LED's 1 Hz blink from the timer's alarm; a button press through IO_BANK0; the terminal's text echoed in upper case.",
  "inputs": [
    {
      "at": "1.2s",
      "target": "SW1",
      "input": "pressed",
      "value": true
    },
    {
      "at": "1.25s",
      "target": "SW1",
      "input": "pressed",
      "value": false
    },
    {
      "at": "1.5s",
      "target": "VT1",
      "input": "tx_text",
      "value": "pico w"
    }
  ],
  "assertions": [
    {
      "id": "banner",
      "at": "20ms",
      "probe": "console",
      "expect": {
        "contains": "pico: RP2040 B2, clk_sys 125000 kHz"
      }
    },
    {
      "id": "terminal-banner",
      "at": "20ms",
      "probe": "terminal",
      "expect": {
        "contains": "clk_sys 125000 kHz"
      }
    },
    {
      "id": "led-off",
      "at": "0.4s",
      "probe": "led",
      "expect": {
        "logic": "0"
      }
    },
    {
      "id": "led-on",
      "at": "0.6s",
      "probe": "led",
      "expect": {
        "logic": "1"
      }
    },
    {
      "id": "blink",
      "between": [
        "100ms",
        "2.2s"
      ],
      "probe": "led",
      "expect": {
        "edges": 4
      }
    },
    {
      "id": "button",
      "at": "1.3s",
      "probe": "console",
      "expect": {
        "contains": "button 1"
      }
    },
    {
      "id": "echo",
      "at": "1.6s",
      "probe": "terminal",
      "expect": {
        "contains": "PICO W"
      }
    }
  ]
}
