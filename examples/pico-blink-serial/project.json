{
 "schema_version": 1,
 "kind": "project",
 "name": "pico-blink-serial",
 "description": "A Raspberry Pi Pico running firmware/main.c on its RP2040 (Cortex-M0+), booted from flash through boot2: the PLL takes clk_sys to 125 MHz, the LED on GPIO25 blinks at 1 Hz from the timer's alarm, a button on GP15 interrupts through IO_BANK0 and is counted, and what a virtual terminal on GP0/GP1 sends at 115200 baud comes back in upper case.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/pico",
   "layout": {
    "x": 300,
    "y": 120
   },
   "firmware": {
    "image": "firmware/blink-serial.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "firmware/boot2.c",
     "firmware/startup.c",
     "firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "linker_script": "firmware/rp2040.ld"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 640,
    "y": 500
   }
  },
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 100,
    "y": 520
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 40,
    "y": 140
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 640,
    "y": 340
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "SW1.2",
   "VT1.GND"
  ],
  "BTN": [
   "B1.GP15",
   "SW1.1"
  ],
  "UART_TX": [
   "B1.GP0",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.GP1",
   "VT1.TX"
  ]
 },
