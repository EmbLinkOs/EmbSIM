{
  "schema_version": 1,
  "kind": "project",
  "name": "instrument-loading",
  "description": "Four analytic before/after comparisons: voltmeter input resistance, ammeter burden, 50 Ω generator termination and scope input capacitance. Generic configurable equivalents; no commercial instrument accuracy or protection qualification.",
  "policy": "electrical",
  "components": [
    {
      "id": "V10",
      "component": "emblink/vsource",
      "params": {
        "dc": 10
      },
      "layout": {
        "x": 50,
        "y": 80
      }
    },
    {
      "id": "R_VM",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1meg"
      },
      "layout": {
        "x": 180,
        "y": 70
      }
    },
    {
      "id": "VM",
      "component": "emblink/voltmeter",
      "layout": {
        "x": 310,
        "y": 50
      }
    },
    {
      "id": "R_REF",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1meg"
      },
      "layout": {
        "x": 180,
        "y": 180
      }
    },
    {
      "id": "V5",
      "component": "emblink/vsource",
      "params": {
        "dc": 5
      },
      "layout": {
        "x": 570,
        "y": 80
      }
    },
    {
      "id": "AM",
      "component": "emblink/ammeter",
      "params": {
        "shunt_resistance": 10
      },
      "layout": {
        "x": 690,
        "y": 50
      }
    },
    {
      "id": "LOAD",
      "component": "emblink/resistor",
      "params": {
        "resistance": 100
      },
      "layout": {
        "x": 850,
        "y": 70
      }
    },
    {
      "id": "REF_LOAD",
      "component": "emblink/resistor",
      "params": {
        "resistance": 100
      },
      "layout": {
        "x": 690,
        "y": 180
      }
    },
    {
      "id": "GEN",
      "component": "emblink/function_generator",
      "params": {
        "dc": 2
      },
      "layout": {
        "x": 50,
        "y": 360
      }
    },
    {
      "id": "MATCH",
      "component": "emblink/resistor",
      "params": {
        "resistance": 50
      },
      "layout": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "GEN_REF",
      "component": "emblink/function_generator",
      "params": {
        "dc": 2
      },
      "layout": {
        "x": 50,
        "y": 460
      }
    },
    {
      "id": "HIGH_Z",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1G"
      },
      "layout": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "STEP",
      "component": "emblink/vsource",
      "params": {
        "kind": "pulse",
        "v1": 0,
        "v2": 10,
        "td": "1u",
        "tr": "1n",
        "tf": "1n",
        "pw": "1m",
        "per": "2m"
      },
      "layout": {
        "x": 570,
        "y": 350
      }
    },
    {
      "id": "RS",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1meg"
      },
      "layout": {
        "x": 690,
        "y": 340
      }
    },
    {
      "id": "SCOPE",
      "component": "emblink/scope_input",
      "params": {
        "input_capacitance": "20p"
      },
      "layout": {
        "x": 820,
        "y": 320
      }
    },
    {
      "id": "RS_REF",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1meg"
      },
      "layout": {
        "x": 690,
        "y": 450
      }
    },
    {
      "id": "RESISTIVE",
      "component": "emblink/scope_input",
      "params": {
        "input_capacitance": 0
      },
      "layout": {
        "x": 820,
        "y": 430
      }
    },
    {
      "id": "GROUND",
      "component": "emblink/gnd",
      "layout": {
        "x": 480,
        "y": 560
      }
    }
  ],
  "nets": {
    "SUPPLY_10V": [
      "V10.+",
      "R_VM.1",
      "R_REF.1"
    ],
    "METER_LOADED": [
      "R_VM.2",
      "VM.+"
    ],
    "UNLOADED_REFERENCE": [
      "R_REF.2"
    ],
    "SUPPLY_5V": [
      "V5.+",
      "AM.+",
      "REF_LOAD.1"
    ],
    "AMMETER_LOAD": [
      "AM.-",
      "LOAD.1"
    ],
    "MATCHED_50": [
      "GEN.+",
      "MATCH.1"
    ],
    "HIGH_Z_OUTPUT": [
      "GEN_REF.+",
      "HIGH_Z.1"
    ],
    "STEP_SOURCE": [
      "STEP.+",
      "RS.1",
      "RS_REF.1"
    ],
    "CAPACITIVE_INPUT": [
      "RS.2",
      "SCOPE.+"
    ],
    "RESISTIVE_INPUT": [
      "RS_REF.2",
      "RESISTIVE.+"
    ],
    "GND": [
      "V10.-",
      "VM.-",
      "V5.-",
      "LOAD.2",
      "REF_LOAD.2",
      "GEN.-",
      "MATCH.2",
      "GEN_REF.-",
      "HIGH_Z.2",
      "STEP.-",
      "SCOPE.-",
      "RESISTIVE.-",
      "GROUND.GND"
    ]
  },
  "probes": [
    {
      "id": "meter-voltage",
      "target": "device:VM.voltage",
      "kind": "value",
      "rate_hz": 1000000
    },
    {
      "id": "meter-current",
