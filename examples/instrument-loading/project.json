      "rate_hz": 1000000
    },
    {
      "id": "scope-step",
      "target": "device:SCOPE.voltage",
      "kind": "value",
      "rate_hz": 1000000
    },
    {
      "id": "resistive-step",
      "target": "device:RESISTIVE.voltage",
      "kind": "value",
      "rate_hz": 1000000
    }
  ],
  "scenarios": [
