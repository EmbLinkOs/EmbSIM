      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "coll",
      "target": "net:COLL",
      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "console",
      "target": "serial:B1",
      "kind": "serial"
    },
    {
      "id": "tx",
      "target": "net:UART_TX",
      "kind": "digital"
    },
    {
      "id": "terminal",
      "target": "serial:VT1",
      "kind": "serial"
    }
  ],
  "scenarios": [
