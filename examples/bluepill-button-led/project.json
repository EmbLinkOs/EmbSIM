{
  "schema_version": 1,
  "kind": "project",
  "name": "bluepill-button-led",
  "description": "The M1 acceptance circuit: a Blue Pill running firmware/main.c. USB 5 V feeds the board's regulator; a push button from A0 to ground; an external red LED with a 1 k series resistor from C13 to ground. The firmware lights the external LED while the button is held, by EXTI interrupt, and reports each change on USART1, which a virtual terminal on A9 and A10 reads and talks to; the firmware echoes what it receives in upper case.",
  "policy": "electrical",
  "boards": [
    {
      "id": "B1",
      "board": "emblink/bluepill",
      "layout": {
        "x": 300,
        "y": 120
      },
      "firmware": {
        "image": "firmware/button-led.elf",
        "format": "elf",
        "toolchain": "clang",
        "sources": [
          "firmware/startup.c",
          "firmware/main.c"
        ],
        "flags": [
          "-O2",
          "-g"
        ]
      }
    }
  ],
  "components": [
    {
      "id": "USB",
      "component": "emblink/vcc",
      "params": {
        "voltage": 5
      },
      "layout": {
        "x": 100,
        "y": 40
      }
    },
    {
      "id": "SW1",
      "component": "emblink/push_button",
      "layout": {
        "x": 700,
        "y": 180,
        "rotation": 90
      }
    },
    {
      "id": "R1",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      },
      "layout": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "D1",
      "component": "emblink/led",
      "params": {
        "color": "red"
      },
      "layout": {
        "x": 820,
        "y": 300,
        "rotation": 90
      }
    },
    {
      "id": "GND1",
      "component": "emblink/gnd",
      "layout": {
        "x": 700,
        "y": 420
      }
    },
    {
      "id": "VT1",
      "component": "emblink/virtual_terminal",
      "layout": {
        "x": 900,
        "y": 60
      }
    }
  ],
  "nets": {
    "USB5V": [
      "USB.VCC",
      "B1.5V"
    ],
    "BTN": [
      "B1.A0",
      "SW1.1"
    ],
    "GND": [
      "B1.GND",
      "SW1.2",
      "D1.K",
      "GND1.GND",
      "VT1.GND"
    ],
    "LED_IN": [
      "B1.C13",
      "R1.1"
    ],
    "LED_A": [
      "R1.2",
      "D1.A"
    ],
    "UART_TX": [
      "B1.A9",
      "VT1.RX"
    ],
    "UART_RX": [
      "B1.A10",
      "VT1.TX"
    ]
  },
  "probes": [
    {
      "id": "rail3v3",
      "target": "net:B1.3V3",
      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "btn",
      "target": "net:BTN",
      "kind": "digital"
    },
    {
      "id": "pc13",
      "target": "net:LED_IN",
      "kind": "digital"
    },
    {
      "id": "led",
      "target": "device:D1.i",
      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "console",
      "target": "serial:B1",
      "kind": "serial"
    },
    {
      "id": "tx",
      "target": "net:UART_TX",
      "kind": "digital"
    },
    {
      "id": "terminal",
      "target": "serial:VT1",
      "kind": "serial"
    }
  ],
  "scenarios": [
    "scenarios/press.json"
  ]
}
