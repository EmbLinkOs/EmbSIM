{
 "schema_version": 1,
 "kind": "project",
 "name": "explorer16-pic32mx",
 "description": "An Explorer 16/32 with its PIC32MX795F512L PIM running firmware/main.c on the MIPS32 M4K: the 8 MHz crystal through the PLL to an 80 MHz SYSCLK (40 MHz PBCLK), D3 blinking at 1 Hz from Timer1's interrupt, S3 counted through the change notice and shown on D4-D10, and what a virtual terminal on UART2 (RF5/RF4) sends at 115200 baud echoed in upper case.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/explorer16-32",
   "layout": {
    "x": 300,
    "y": 120
   },
   "firmware": {
    "image": "firmware/blink-serial.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "firmware/crt0.S",
     "firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "linker_script": "firmware/pic32mx795f512l.ld"
   }
  }
 ],
 "components": [
  {
   "id": "PSU",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 40,
    "y": 140
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 760,
    "y": 300
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 40,
    "y": 420
   }
  }
 ],
 "nets": {
