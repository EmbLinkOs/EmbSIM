{
  "schema_version": 1,
  "kind": "scenario",
  "name": "blink",
  "until": "2.2s",
  "description": "The banner with SYSCLK and PBCLK as OSCCON and the configuration words give them; D3's 1 Hz blink from Timer1; S3 pressed through the change notice, counted on D4; the terminal's text echoed in upper case.",
  "inputs": [
    {
      "at": "1.2s",
      "target": "B1.S3",
      "input": "pressed",
      "value": true
    },
    {
      "at": "1.25s",
      "target": "B1.S3",
      "input": "pressed",
      "value": false
    },
    {
      "at": "1.5s",
      "target": "VT1",
      "input": "tx_text",
      "value": "pic32 mips"
    }
  ],
  "assertions": [
    {
      "id": "banner",
      "at": "20ms",
      "probe": "console",
      "expect": {
        "contains": "explorer16: PIC32MX795F512L, SYSCLK 80000 kHz, PBCLK 40000 kHz"
      }
    },
    {
      "id": "terminal-banner",
      "at": "20ms",
      "probe": "terminal",
      "expect": {
        "contains": "SYSCLK 80000 kHz"
      }
    },
    {
      "id": "led-off",
      "at": "0.4s",
      "probe": "d3",
      "expect": {
        "logic": "0"
      }
    },
    {
      "id": "led-on",
      "at": "0.6s",
      "probe": "d3",
      "expect": {
        "logic": "1"
      }
    },
    {
      "id": "blink",
      "between": [
        "100ms",
        "2.2s"
      ],
      "probe": "d3",
      "expect": {
        "edges": 4
      }
    },
    {
      "id": "button",
      "at": "1.3s",
      "probe": "console",
      "expect": {
        "contains": "S3 pressed 1"
      }
    },
    {
      "id": "count",
      "at": "1.3s",
      "probe": "d4",
      "expect": {
        "logic": "1"
      }
    },
    {
      "id": "echo",
      "at": "1.6s",
      "probe": "terminal",
      "expect": {
        "contains": "PIC32 MIPS"
      }
    }
  ]
}
