{
  "schema_version": 1,
  "kind": "project",
  "name": "temperature-divider",
  "description": "A 10 kohm Vishay NTC divider feeds LM393P; a 3296W trimmer sets the alarm threshold and the comparator sinks an LED.",
  "libraries": [
    "../../catalog"
  ],
  "policy": "electrical",
  "components": [
    {
      "id": "V1",
      "component": "emblink/vsource",
      "params": {
        "dc": 5
      },
      "layout": {
        "x": 60,
        "y": 120
      }
    },
    {
      "id": "R1",
      "component": "emblink/resistor",
      "params": {
        "resistance": 10000
      },
      "layout": {
        "x": 230,
        "y": 150
      }
    },
    {
      "id": "NTC1",
      "component": "emblink/ntcle100e3103jb0",
      "layout": {
        "x": 360,
        "y": 160
      }
    },
    {
      "id": "P1",
      "component": "emblink/bourns_3296w_103",
      "layout": {
        "x": 230,
        "y": 320
      }
    },
    {
      "id": "U1",
      "component": "emblink/lm393p",
      "layout": {
        "x": 610,
        "y": 190
      }
    },
    {
      "id": "RL",
      "component": "emblink/resistor",
      "params": {
        "resistance": 1000
      },
      "layout": {
        "x": 870,
        "y": 150
      }
    },
    {
      "id": "LED1",
      "component": "emblink/led",
      "layout": {
        "x": 870,
        "y": 250
      }
    },
    {
      "id": "G",
      "component": "emblink/gnd",
      "layout": {
        "x": 610,
        "y": 450
      }
    }
  ],
  "nets": {
    "VCC": [
      "V1.+",
      "R1.1",
      "P1.2",
      "U1.VCC",
      "RL.1"
    ],
    "TEMP": [
      "R1.2",
      "NTC1.1",
      "U1.IN1+"
    ],
    "REFERENCE": [
      "P1.W",
      "U1.IN1-"
    ],
    "LED_A": [
      "RL.2",
      "LED1.A"
    ],
    "ALARM": [
      "LED1.K",
      "U1.OUT1"
    ],
    "UNUSED": [
      "U1.OUT2"
    ],
    "GND": [
      "V1.-",
      "NTC1.2",
      "P1.1",
      "U1.GND",
      "U1.IN2+",
      "U1.IN2-",
      "G.GND"
    ]
  },
  "probes": [
    {
      "id": "temp",
      "target": "net:TEMP",
      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "reference",
      "target": "net:REFERENCE",
      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "alarm",
      "target": "net:ALARM",
      "kind": "analog",
      "rate_hz": 100000
    }
  ],
  "scenarios": [
    "scenarios/interact.json"
