{
  "schema_version": 1,
  "kind": "scenario",
  "name": "temperature-divider interaction",
  "description": "The divider's bounds allow R1's 5 % tolerance (ADR-034): at 25 degC it sits within 2.5 V +/- 70 mV, at 85 degC within 0.48 V +/- 30 mV, either side of the 2 V threshold.",
  "until": "5ms",
  "inputs": [
    {
      "at": "0us",
      "target": "P1",
      "input": "position",
      "value": 0.4
    },
    {
      "at": "1ms",
      "target": "NTC1",
      "input": "temperature",
      "value": 85
    },
    {
      "at": "3ms",
      "target": "NTC1",
      "input": "temperature",
      "value": 25
    }
  ],
  "assertions": [
    {
      "id": "ambient",
      "probe": "temp",
      "at": "500us",
      "expect": {
        "min_v": 2.43,
        "max_v": 2.57
      }
    },
    {
      "id": "threshold",
      "probe": "reference",
      "at": "500us",
      "expect": {
        "min_v": 1.99,
        "max_v": 2.01
      }
    },
    {
      "id": "hot",
      "probe": "temp",
      "at": "2ms",
      "expect": {
        "min_v": 0.45,
        "max_v": 0.51
      }
    },
    {
      "id": "hot-led",
      "probe": "alarm",
      "at": "2ms",
      "expect": {
        "min_v": 0,
        "max_v": 0.3
      }
    },
    {
      "id": "cool-again",
      "probe": "alarm",
      "at": "4ms",
      "expect": {
        "min_v": 4.0,
        "max_v": 5.01
      }
    },
    {
      "id": "solver-health",
      "always": true,
      "diagnostics": {
        "forbid": [
          "analog.no_convergence",
          "analog.timestep_too_small",
          "sched.delta_overflow"
        ]
      }
    }
  ]
}
