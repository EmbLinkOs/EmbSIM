{
 "schema_version": 1,
 "kind": "project",
 "name": "nucleo-f446ze-blink-serial",
 "description": "A NUCLEO-F446ZE running firmware/main.c on its STM32F446ZE (Cortex-M4F): HSE in bypass from the ST-LINK's 8 MHz MCO, the PLL and over-drive to 180 MHz, LD1 on PB0 blinking at 1 Hz from SysTick, the blue USER button B1 on PC13 (active high) counted through EXTI13's rising edge and toggling LD2 on PB7, and the ST-LINK's virtual COM port (USART3 on PD8/PD9 at 115200 baud) echoing what it receives in upper case. The board runs from its ST-LINK USB connector's 5 V.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446ze",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "firmware/blink-serial.elf",
    "format": "elf",
    "toolchain": "clang",
    "sources": [
     "firmware/startup.c",
     "firmware/main.c"
    ],
    "flags": [
     "-ffreestanding",
     "-fno-builtin"
    ],
    "linker_script": "firmware/stm32f446ze.ld"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PB0",
   "kind": "digital"
  },
  {
   "id": "led2",
   "target": "net:B1.PB7",
   "kind": "digital"
  },
  {
   "id": "led3",
   "target": "net:B1.PB14",
   "kind": "digital"
  },
  {
   "id": "btn",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "vdd",
   "target": "net:B1.VDD",
   "kind": "analog",
   "rate_hz": 1000
  },
  {
   "id": "presses",
   "target": "var:B1:presses",
   "kind": "value"
  },
  {
   "id": "cfgr",
   "target": "reg:B1.RCC.CFGR",
   "kind": "value"
  },
  {
   "id": "flash_size",
   "target": "mem:B1:0x1FFF7A22:2",
   "kind": "value"
  }
 ],
 "scenarios": [
  "scenarios/blink.json"
 ]
}
