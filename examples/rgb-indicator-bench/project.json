{
  "schema_version": 1,
  "kind": "project",
  "name": "rgb-indicator-bench",
  "description": "Three physical switches feed an RGB LED through separate current-limiting resistors. Press while running; light and loading come from the electrical solver.",
  "policy": "electrical",
  "components": [
    {
      "id": "V1",
      "component": "emblink/vsource",
      "params": {
        "dc": 5
      },
      "layout": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "D1",
      "component": "emblink/rgb_led",
      "layout": {
        "x": 650,
        "y": 220
      }
    },
    {
      "id": "G1",
      "component": "emblink/gnd",
      "layout": {
        "x": 770,
        "y": 350
      }
    },
    {
      "id": "SWR",
      "component": "emblink/push_button",
      "layout": {
        "x": 240,
        "y": 100
      }
    },
    {
      "id": "RR",
      "component": "emblink/resistor",
      "params": {
        "resistance": 159
      },
      "layout": {
        "x": 420,
        "y": 100
      }
    },
    {
      "id": "SWG",
      "component": "emblink/push_button",
      "layout": {
        "x": 240,
        "y": 200
      }
    },
    {
      "id": "RG",
      "component": "emblink/resistor",
      "params": {
        "resistance": 144
      },
      "layout": {
        "x": 420,
        "y": 200
      }
    },
    {
      "id": "SWB",
      "component": "emblink/push_button",
      "layout": {
        "x": 240,
        "y": 300
      }
    },
    {
      "id": "RB",
      "component": "emblink/resistor",
      "params": {
        "resistance": 104
      },
      "layout": {
        "x": 420,
        "y": 300
      }
    }
  ],
  "nets": {
    "V5": [
      "V1.+",
      "SWR.1",
      "SWG.1",
      "SWB.1"
    ],
    "GND": [
      "V1.-",
      "G1.GND",
      "D1.COM"
    ],
    "SW_R": [
      "SWR.2",
      "RR.1"
    ],
    "LED_R": [
      "RR.2",
      "D1.R"
    ],
    "SW_G": [
