{
  "schema_version": 1,
  "kind": "project",
  "name": "optocoupled-input",
  "description": "A D2F-01L lever switches the LED side of a VO617A-3; the output is pulled up to 3.3 V on a separate reference.",
  "libraries": [
    "../../catalog"
  ],
  "policy": "electrical",
  "components": [
    {
      "id": "V1",
      "component": "emblink/vsource",
      "params": {
        "dc": 5
      },
      "layout": {
        "x": 70,
        "y": 120
      }
    },
    {
      "id": "V2",
      "component": "emblink/vsource",
      "params": {
        "dc": 3.3
      },
      "layout": {
        "x": 900,
        "y": 80
      }
    },
    {
      "id": "OFFSET",
      "component": "emblink/vsource",
      "params": {
        "dc": 2
      },
      "layout": {
        "x": 70,
        "y": 300
      }
    },
    {
      "id": "SW1",
      "component": "emblink/d2f_01l",
      "layout": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "RI",
      "component": "emblink/resistor",
      "params": {
        "resistance": 390
      },
      "layout": {
        "x": 410,
        "y": 130
      }
    },
    {
      "id": "U1",
      "component": "emblink/vo617a_3",
      "layout": {
        "x": 570,
        "y": 120
      }
    },
    {
      "id": "RP",
      "component": "emblink/resistor",
      "params": {
        "resistance": 10000
      },
      "layout": {
        "x": 800,
        "y": 130
      }
    },
    {
      "id": "G",
      "component": "emblink/gnd",
      "layout": {
        "x": 900,
        "y": 340
      }
    }
  ],
  "nets": {
    "INPUT_VCC": [
      "V1.+",
      "SW1.COM"
    ],
    "INPUT_ON": [
      "SW1.NO",
      "RI.1"
    ],
    "INPUT_NC": [
      "SW1.NC"
    ],
    "ANODE": [
      "RI.2",
      "U1.A"
    ],
    "INPUT_GND": [
      "V1.-",
      "U1.K",
      "OFFSET.+"
    ],
    "OUTPUT_VCC": [
      "V2.+",
      "RP.2"
    ],
    "OUTPUT": [
      "RP.1",
      "U1.C"
    ],
    "GND": [
      "V2.-",
      "OFFSET.-",
      "U1.E",
      "G.GND"
    ]
  },
  "probes": [
    {
      "id": "out",
      "target": "net:OUTPUT",
      "kind": "analog",
      "rate_hz": 100000
    },
    {
      "id": "input-ground",
      "target": "net:INPUT_GND",
      "kind": "analog",
      "rate_hz": 100000
    }
  ],
