{
  "schema_version": 1,
  "kind": "toolchain",
  "id": "xc16",
  "name": "Microchip MPLAB XC16",
  "description": "Microchip XC16 (GCC-based) for 16-bit PIC24 and dsPIC; ELF with DWARF plus Intel HEX through xc16-bin2hex.",
  "detect": {
    "command": [
      "xc16-gcc",
      "--version"
    ],
    "version_regex": "\\) v?([0-9.]+)",
    "min_version": "1.70"
  },
  "targets": {
    "pic24fj64ga002": {
      "cc": [
        "xc16-gcc",
        "-mcpu=24FJ64GA002"
      ],
      "link_flags": [
        "-Wl,--gc-sections",
        "-Wl,--local-stack",
        "-Wl,-Map=${map}"
      ]
    },
    "pic24fj256ga7": {
      "cc": [
        "xc16-gcc",
        "-mcpu=24FJ256GA705"
      ],
      "link_flags": [
        "-Wl,--gc-sections",
        "-Wl,--local-stack",
        "-Wl,-Map=${map}"
      ]
    },
    "dspic33ck256mp508": {
      "cc": [
        "xc16-gcc",
        "-mcpu=33CK256MP508"
      ],
      "link_flags": [
        "-Wl,--gc-sections",
        "-Wl,--local-stack",
        "-Wl,-Map=${map}"
      ]
    },
    "pic24fj1024gb610": {
      "cc": [
        "xc16-gcc",
        "-mcpu=24FJ1024GB610"
      ],
      "link_flags": [
        "-Wl,--script=p24FJ1024GB610.gld",
        "-Wl,--gc-sections",
        "-Wl,--local-stack",
        "-Wl,-Map=${map}"
      ]
    }
  },
  "steps": {
    "compile": [
      "${cc}",
      "${cflags}",
      "${defines}",
      "${include}",
      "-g",
      "-O1",
      "-ffunction-sections",
      "-fdata-sections",
      "-Wall",
      "-c",
      "${source}",
      "-o",
      "${object}"
    ],
    "link": [
      "${cc}",
      "${cflags}",
      "${link_flags}",
      "-T${linker_script}",
      "${objects}",
      "-o",
      "${image}"
    ],
    "convert": [
      "xc16-bin2hex",
      "${image}",
      "-a"
    ]
  },
  "outputs": {
    "image": "elf",
    "debug": "dwarf",
    "map": true
  },
  "environment": {
    "PATH_hint": [
      "/opt/microchip/xc16/*/bin",
      "/Applications/microchip/xc16/*/bin",
      "C:/Program Files/Microchip/xc16/*/bin"
    ]
  }
}
