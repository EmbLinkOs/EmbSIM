{
  "schema_version": 1,
  "kind": "toolchain",
  "id": "gcc-xtensa",
  "name": "Espressif's GNU Xtensa toolchain (xtensa-esp32-elf-gcc)",
  "description": "Espressif's crosstool-NG GCC for the ESP32's Xtensa LX6 cores, the one ESP-IDF installs (idf_tools.py, ~/.espressif/tools/xtensa-esp-elf): xtensa-esp32-elf-gcc is the ESP32's configuration (core-isa.h's), with newlib. ESP-IDF's own build (idf.py) makes the flash images the vendor scenarios run; this profile compiles a project's sources into an ELF.",
  "detect": {
    "command": [
      "xtensa-esp32-elf-gcc",
      "--version"
    ],
    "version_regex": "\\) ([0-9.]+)",
    "min_version": "12.2",
    "prefix": "xtensa-esp32-elf-"
  },
  "targets": {
    "esp32": {
      "cc": [
        "xtensa-esp32-elf-gcc",
        "-mlongcalls"
      ],
      "link_flags": [
        "-nostartfiles",
        "-Wl,--gc-sections",
        "--specs=nosys.specs"
      ]
    }
  },
  "steps": {
    "compile": [
      "${cc}",
      "${cflags}",
      "${defines}",
      "${include}",
      "-g",
      "-O2",
      "-ffunction-sections",
      "-fdata-sections",
      "-Wall",
      "-c",
      "${source}",
      "-o",
      "${object}"
    ],
    "link": [
      "${cc}",
      "${cflags}",
      "${link_flags}",
      "-T${linker_script}",
      "-Wl,-Map=${map}",
      "${objects}",
      "-o",
      "${image}"
    ],
    "convert": null
  },
  "outputs": {
    "image": "elf",
    "debug": "dwarf",
    "map": true
  },
  "environment": {
    "PATH_hint": [
      "~/.espressif/tools/xtensa-esp-elf/*/xtensa-esp-elf/bin",
      "C:/Espressif/tools/xtensa-esp-elf/*/xtensa-esp-elf/bin",
      "/opt/esp/tools/xtensa-esp-elf/*/xtensa-esp-elf/bin"
    ]
  }
}
