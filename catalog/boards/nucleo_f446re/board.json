{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/nucleo_f446re",
  "version": "1.0.0",
  "name": "NUCLEO-F446RE (STM32F446RE)",
  "description": "ST's NUCLEO-F446RE (MB1136 C-03): an STM32F446RET6 clocked from the ST-LINK's 8 MHz MCO, with a 32.768 kHz crystal, the green user LED LD2 on PA5, the blue USER button on PC13, the black RESET button, the power LED LD3, JP5 choosing the ST-LINK's USB (U5V) or E5V/VIN, JP6 (IDD) to measure the MCU's current, the Arduino Uno V3 headers and the two ST morpho headers. The ST-LINK/V2-1's virtual COM port is the session's serial console on USART2 (PA2/PA3), and a serial port on the host (embsim serve --serial).",
  "keywords": [
    "nucleo",
    "nucleo-64",
    "stm32f446",
    "stm32f446re",
    "stm32",
    "cortex-m4",
    "st-link"
  ],
  "revision": "MB1136 C-03",
  "mcu": {
    "ref": "st/stm32f446re",
    "package": "lqfp64",
    "instance": "U5"
  },
  "oscillators": {
    "hse": {
      "hz": 8000000,
      "source": "external_clock"
    },
    "lse": {
      "hz": 32768,
      "source": "external_crystal",
      "component": "X2"
    }
  },
  "components": [
    {
      "id": "U3",
      "component": "emblink/regulator",
      "params": {
        "part": "LD1117S50"
      },
      "doc": "LD1117S50TR: 5 V from VIN to E5V through D4"
    },
    {
      "id": "D4",
      "component": "emblink/stps2l30a",
      "doc": "STPS2L30A Schottky: keeps E5V from feeding U3 backwards"
    },
    {
      "id": "T2",
      "component": "emblink/sts7pf30l",
      "doc": "STS7PF30L P-MOSFET: joins U5V to JP5 once the ST-LINK pulls PWR_ENn low"
    },
    {
      "id": "R28",
      "component": "emblink/resistor",
      "params": {
        "resistance": "4.7k"
      },
      "doc": "T2's gate pull-up to U5V: T2 off until the ST-LINK enables it"
    },
    {
      "id": "R_PWREN",
      "component": "emblink/resistor",
      "params": {
        "resistance": 40
      },
      "doc": "The ST-LINK's PB15 driving PWR_ENn low (it has enumerated and the host granted 300 mA)"
    },
    {
      "id": "JP5_U5V",
      "component": "emblink/toggle_switch",
      "params": {
        "initially_closed": true
      },
      "doc": "JP5 (PWR) on pins 1-2, U5V: the board runs from the ST-LINK's USB (the factory position)"
    },
    {
      "id": "JP5_E5V",
      "component": "emblink/toggle_switch",
      "doc": "JP5 (PWR) on pins 2-3, E5V: the board runs from E5V or VIN"
    },
    {
      "id": "U4",
      "component": "emblink/regulator",
      "params": {
        "part": "LD39050PU33R"
      },
      "doc": "LD39050PU33R: +3.3V from +5V (500 mA)"
    },
    {
      "id": "JP6",
      "component": "emblink/toggle_switch",
      "params": {
        "initially_closed": true
      },
      "doc": "JP6 (IDD): +3.3V to the STM32's VDD; remove it and put an ammeter across IDD_3V3 and IDD_VDD"
    },
    {
      "id": "LD3",
      "component": "emblink/led",
      "params": {
        "color": "red"
      },
      "doc": "LD3 (PWR): +5V is present"
    },
    {
      "id": "R32",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      }
    },
    {
      "id": "LD2",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "LD2 (USER, green): PA5 high lights it (SB21 on)"
    },
    {
      "id": "R31",
      "component": "emblink/resistor",
      "params": {
        "resistance": 510
      }
    },
    {
      "id": "B1",
      "component": "emblink/push_button",
      "doc": "B1 USER (blue): pulls PC13 low"
    },
    {
      "id": "R30",
      "component": "emblink/resistor",
      "params": {
        "resistance": "4.7k"
      },
      "doc": "B1's pull-up to VDD"
    },
    {
      "id": "R29",
      "component": "emblink/resistor",
      "params": {
        "resistance": 100
      },
      "doc": "B1's series resistor to PC13 (with C15, a 10 us filter)"
    },
    {
      "id": "C15",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "100n"
      },
      "doc": "B1's filter capacitor on PC13 (10 us with R29)"
    },
    {
      "id": "B2",
      "component": "emblink/push_button",
      "doc": "B2 RESET (black): pulls NRST low"
    },
    {
      "id": "C14",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "100n"
      },
      "doc": "NRST's capacitor: with the STM32's internal pull-up, it holds the part in reset for about 1.5 ms at power-on"
    },
    {
      "id": "C26",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "4.7u",
        "esr": 0.01
      },
      "doc": "VCAP_1: the low-ESR ceramic the STM32's core regulator needs"
    },
    {
      "id": "R33",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      },
      "doc": "BOOT0 pull-down: the part boots its flash"
    },
    {
      "id": "X2",
      "component": "emblink/crystal",
      "params": {
        "hz": 32768,
        "c0": "1.5p",
        "cm": "3f",
        "lm": "7.8k",
        "rm": "50k"
      },
      "doc": "X2 ABS25-32.768KHZ-6-T (6 pF load, 50 kOhm ESR maximum), with C31/C32 4.3 pF and R34/R36 0 ohm"
    },
    {
      "id": "CN6",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Arduino power: NC IOREF RESET +3.3V +5V GND GND VIN"
    },
    {
      "id": "CN8",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "Arduino analog: A0..A5"
    },
    {
      "id": "CN5",
      "component": "emblink/header",
      "params": {
        "pins": 10
      },
      "doc": "Arduino digital: D8..D13 GND AREF D14 D15"
    },
    {
      "id": "CN9",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Arduino digital: D0..D7"
    },
    {
      "id": "CN7",
      "component": "emblink/header",
      "params": {
        "pins": 38
      },
      "doc": "ST morpho, left (2 x 19)"
    },
    {
      "id": "CN10",
      "component": "emblink/header",
      "params": {
        "pins": 38
      },
      "doc": "ST morpho, right (2 x 19)"
    },
    {
      "id": "SB57",
      "component": "emblink/resistor",
      "params": {
        "resistance": 0.001
      },
      "doc": "SB57 (on): VDDA/VREF+ joined to VDD"
    }
  ],
