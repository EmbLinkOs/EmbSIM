      "connector": "J_ANA",
      "pin": 4
    },
    "IOREF": {
      "net": "3V3",
      "connector": "J_PWR",
      "pin": 2,
      "doc": "The I/O voltage, 3.3 V"
    },
    "RESET": {
      "net": "RESET",
      "connector": "J_PWR",
      "pin": 3
    },
    "3V3": {
      "net": "3V3",
      "connector": "J_PWR",
      "pin": 4
    },
    "5V": {
      "net": "5V",
      "connector": "J_PWR",
      "pin": 5,
      "doc": "5 V in (USB's on a real board)"
    },
    "GND": {
      "net": "GND",
      "connector": "J_PWR",
      "pin": 6
    },
    "GND_2": {
      "net": "GND",
      "connector": "J_PWR",
      "pin": 7
    }
  },
  "leds": [
    {
      "name": "red",
      "component": "LED_R",
      "gpio": "GPIO22",
      "active": "low",
      "color": "red"
    },
    {
      "name": "green",
      "component": "LED_G",
      "gpio": "GPIO19",
      "active": "low",
      "color": "green"
    },
    {
      "name": "blue",
      "component": "LED_B",
      "gpio": "GPIO21",
      "active": "low",
      "color": "blue"
    }
  ],
  "buttons": [
