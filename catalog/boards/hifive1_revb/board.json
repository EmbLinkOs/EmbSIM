      "name": "reset",
      "component": "SW_RESET",
      "signal": "NRST",
      "active": "low"
    }
  ],
  "console": {
    "peripheral": "UART0",
    "tx": "GPIO17",
    "rx": "GPIO16",
    "baud": 115200
  },
