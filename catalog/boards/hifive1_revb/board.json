    "D13": {
      "net": "GPIO5",
      "connector": "J_DHI",
      "pin": 6
    },
    "GND_D": {
      "net": "GND",
      "connector": "J_DHI",
      "pin": 7
    },
    "D15": {
      "net": "GPIO9",
      "connector": "J_DHI",
      "pin": 8
    },
    "D18": {
      "net": "GPIO12",
      "connector": "J_DHI",
      "pin": 9,
      "doc": "SDA"
    },
    "D19": {
      "net": "GPIO13",
      "connector": "J_DHI",
      "pin": 10,
