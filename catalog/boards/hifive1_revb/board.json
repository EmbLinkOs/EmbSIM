  "fidelity": {
    "functional": {
      "claims": "Nets, ports, the RGB LED and the reset button as logic-level parts; the FE310 runs its firmware from 0x20010000 (see its description).",
      "omissions": [
        "the J-Link OB debugger and USB bridge (the console is UART0 itself)",
        "the ESP32-SOLO-1 Wi-Fi module",
        "the bootloader in the first 64 KiB of flash",
        "the 1.8 V core regulator"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional.",
      "omissions": [
        "as functional"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "electrical": {
      "claims": "The 3.3 V regulator, the RGB LED with series resistors, the reset pull-up and the crystal as a BVD equivalent; GPIO bridges use the MCU's pin-model defaults.",
      "omissions": [
        "decoupling",
        "the 1.8 V rail (the core supply pin sits on 3.3 V here)",
        "ESD diodes"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
