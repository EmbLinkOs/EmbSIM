{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/hifive1_revb",
  "version": "1.0.0",
  "name": "HiFive1 Rev B (FE310-G002)",
  "description": "SiFive's HiFive1 Rev B: the FE310-G002 RISC-V MCU with 4 MiB of QSPI flash, a 16 MHz crystal, an RGB LED (red GPIO22, green GPIO19, blue GPIO21, active low), the reset button and Arduino Uno-style headers. USB comes in as the 5V pin; the J-Link OB bridge's serial port is the session's console on UART0.",
  "keywords": [
    "hifive1",
    "sifive",
    "fe310",
    "risc-v",
    "riscv"
  ],
  "revision": "Rev B",
  "mcu": {
    "ref": "sifive/fe310_g002",
    "package": "qfn48",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 16000000,
      "source": "external_crystal",
      "component": "Y1"
    }
  },
  "components": [
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "AMS1117-3.3"
      },
      "doc": "3.3 V regulator from the 5 V rail (the Rev B's SPX3819)"
    },
    {
      "id": "Y1",
      "component": "emblink/crystal",
      "params": {
        "hz": "16meg"
      },
      "doc": "16 MHz crystal on HFXOSC"
    },
    {
      "id": "LED_R",
      "component": "emblink/led",
      "params": {
        "color": "red"
      },
      "doc": "RGB LED, red: cathode on GPIO22 (active low)"
    },
    {
      "id": "LED_G",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "RGB LED, green: cathode on GPIO19 (active low)"
    },
    {
      "id": "LED_B",
      "component": "emblink/led",
      "params": {
        "color": "blue"
      },
      "doc": "RGB LED, blue: cathode on GPIO21 (active low)"
    },
    {
      "id": "R_R",
      "component": "emblink/resistor",
      "params": {
        "resistance": "470"
      }
    },
    {
      "id": "R_G",
      "component": "emblink/resistor",
      "params": {
        "resistance": "470"
      }
    },
    {
      "id": "R_B",
      "component": "emblink/resistor",
      "params": {
        "resistance": "470"
      }
    },
    {
      "id": "SW_RESET",
      "component": "emblink/push_button",
      "doc": "Reset, pulls ERST_N low"
    },
    {
      "id": "R_RESET",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "10k",
        "voltage": 3.3
      },
      "doc": "ERST_N pull-up"
    },
    {
      "id": "J_PWR",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Power: NC IOREF RESET 3V3 5V GND GND VIN"
    },
    {
      "id": "J_DLO",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Digital: D0..D7"
    },
    {
      "id": "J_DHI",
      "component": "emblink/header",
      "params": {
        "pins": 10
      },
      "doc": "Digital: D8..D13, GND, D15 (as AREF on an Uno), D18 (SDA), D19 (SCL)"
    },
    {
      "id": "J_ANA",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "Analog-header positions: D14..D19 (no ADC on the FE310)"
    },
    {
      "id": "U3",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "The IS25LP032 QSPI flash's pins: SCK, CS, DQ0..DQ3 (the flash's contents are the MCU's flash region; no flash device is modelled)"
    },
    {
      "id": "J_JTAG",
      "component": "emblink/header",
      "params": {
        "pins": 4
      },
      "doc": "JTAG to the J-Link OB debugger: TCK, TMS, TDI, TDO"
    },
    {
      "id": "R_WAKE",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "100k",
        "voltage": 3.3
      },
      "doc": "DWAKEUP_N held high"
    },
    {
      "id": "R_LFALT",
      "component": "emblink/pull_down",
      "params": {
        "resistance": "100k"
      },
      "doc": "LFALTCLK: the 32.768 kHz clock source is not drawn (the CLINT counts the MCU description's 32.768 kHz)"
    }
  ],
  "nets": {
    "5V": [
      "U2.IN",
      "J_PWR.5"
    ],
    "3V3": [
      "U2.OUT",
      "U1.VDD",
      "U1.VDD_CORE",
      "U1.AON_VDD",
      "R_R.1",
      "R_G.1",
      "R_B.1",
      "J_PWR.2",
      "J_PWR.4"
    ],
    "GND": [
      "U2.GND",
      "U1.GND",
      "SW_RESET.2",
      "J_PWR.6",
      "J_PWR.7",
      "J_DHI.7"
    ],
    "RESET": [
      "U1.NRST",
      "SW_RESET.1",
      "R_RESET.1",
      "J_PWR.3"
    ],
    "OSC_IN": [
      "U1.OSC_IN",
      "Y1.1"
    ],
    "OSC_OUT": [
      "U1.OSC_OUT",
      "Y1.2"
    ],
    "LED_R_A": [
      "R_R.2",
      "LED_R.A"
    ],
    "LED_G_A": [
      "R_G.2",
      "LED_G.A"
    ],
    "LED_B_A": [
      "R_B.2",
      "LED_B.A"
    ],
    "QSPI_SCK": [
      "U1.QSPI_SCK",
      "U3.1"
    ],
    "QSPI_CS": [
      "U1.QSPI_CS",
      "U3.2"
    ],
    "QSPI_DQ0": [
      "U1.QSPI_DQ0",
      "U3.3"
    ],
    "QSPI_DQ1": [
      "U1.QSPI_DQ1",
      "U3.4"
    ],
    "QSPI_DQ2": [
      "U1.QSPI_DQ2",
      "U3.5"
    ],
    "QSPI_DQ3": [
      "U1.QSPI_DQ3",
      "U3.6"
    ],
    "JTAG_TCK": [
      "U1.JTAG_TCK",
      "J_JTAG.1"
    ],
    "JTAG_TMS": [
      "U1.JTAG_TMS",
      "J_JTAG.2"
    ],
    "JTAG_TDI": [
      "U1.JTAG_TDI",
      "J_JTAG.3"
    ],
    "JTAG_TDO": [
      "U1.JTAG_TDO",
      "J_JTAG.4"
    ],
    "DWAKEUP_N": [
      "U1.DWAKEUP_N",
      "R_WAKE.1"
    ],
    "LFALTCLK": [
      "U1.OSC32_IN",
      "R_LFALT.1"
    ],
    "GPIO0": [
      "U1.GPIO0",
      "J_DHI.1"
    ],
    "GPIO1": [
      "U1.GPIO1",
      "J_DHI.2"
    ],
    "GPIO2": [
      "U1.GPIO2",
      "J_DHI.3"
    ],
    "GPIO3": [
      "U1.GPIO3",
      "J_DHI.4"
    ],
    "GPIO4": [
      "U1.GPIO4",
      "J_DHI.5"
    ],
    "GPIO5": [
      "U1.GPIO5",
      "J_DHI.6"
    ],
    "GPIO9": [
      "U1.GPIO9",
      "J_DHI.8"
    ],
    "GPIO10": [
      "U1.GPIO10",
      "J_ANA.3"
    ],
    "GPIO11": [
      "U1.GPIO11",
      "J_ANA.4"
    ],
    "GPIO12": [
      "U1.GPIO12",
      "J_DHI.9"
    ],
    "GPIO13": [
      "U1.GPIO13",
      "J_DHI.10"
    ],
    "GPIO16": [
      "U1.GPIO16",
      "J_DLO.1"
    ],
    "GPIO17": [
      "U1.GPIO17",
      "J_DLO.2"
    ],
    "GPIO18": [
      "U1.GPIO18",
      "J_DLO.3"
    ],
    "GPIO19": [
      "U1.GPIO19",
      "LED_G.K",
      "J_DLO.4"
    ],
    "GPIO20": [
      "U1.GPIO20",
      "J_DLO.5"
    ],
    "GPIO21": [
      "U1.GPIO21",
      "LED_B.K",
      "J_DLO.6"
    ],
    "GPIO22": [
      "U1.GPIO22",
      "LED_R.K",
      "J_DLO.7"
    ],
    "GPIO23": [
      "U1.GPIO23",
      "J_DLO.8"
    ]
  },
  "ports": {
    "D0": {
      "net": "GPIO16",
      "connector": "J_DLO",
      "pin": 1,
      "doc": "UART0 RX (the USB bridge's TX)"
    },
    "D1": {
      "net": "GPIO17",
      "connector": "J_DLO",
      "pin": 2,
      "doc": "UART0 TX"
    },
    "D2": {
      "net": "GPIO18",
      "connector": "J_DLO",
      "pin": 3
    },
    "D3": {
      "net": "GPIO19",
      "connector": "J_DLO",
      "pin": 4,
      "doc": "Also the RGB LED's green"
    },
    "D4": {
      "net": "GPIO20",
      "connector": "J_DLO",
      "pin": 5
    },
    "D5": {
