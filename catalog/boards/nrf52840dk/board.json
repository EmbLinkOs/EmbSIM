{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/nrf52840dk",
  "version": "1.0.0",
  "name": "nRF52840 DK (PCA10056)",
  "description": "Nordic's nRF52840 DK: the nRF52840 with its 32 MHz and 32.768 kHz crystals, four LEDs (P0.13-P0.16, active low), four buttons (P0.11, P0.12, P0.24, P0.25, to ground), the reset button on P0.18, Arduino Uno-style headers and the interface MCU's virtual COM port on P0.06 (TXD) and P0.08 (RXD). USB comes in as the 5V pin; the session's console is UARTE0.",
  "keywords": [
    "nrf52840",
    "nrf52840dk",
    "pca10056",
    "nordic",
    "bluetooth",
    "cortex-m4f"
  ],
  "revision": "PCA10056 3.0.0",
  "mcu": {
    "ref": "nordic/nrf52840",
    "package": "aqfn73",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 32000000,
      "source": "external_crystal",
      "component": "Y1"
    }
  },
  "components": [
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "generic",
        "vout": 3.0,
        "dropout": 0.2,
        "imax": 0.5,
        "quiescent": 0
      },
      "doc": "VDD at 3.0 V from USB's 5 V"
    },
    {
      "id": "Y1",
      "component": "emblink/crystal",
      "params": {
        "hz": "32meg"
      },
      "doc": "The 32 MHz crystal on XC1 and XC2"
    },
    {
      "id": "Y2",
      "component": "emblink/crystal",
      "params": {
        "hz": "32.768k"
      },
      "doc": "The 32.768 kHz crystal on P0.00 and P0.01 (XL1, XL2)"
    },
    {
      "id": "LED1",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "LED1 on P0.13, active low"
    },
    {
      "id": "LED2",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "LED2 on P0.14, active low"
    },
    {
      "id": "LED3",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "LED3 on P0.15, active low"
    },
    {
      "id": "LED4",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "LED4 on P0.16, active low"
    },
    {
      "id": "R_LED1",
      "component": "emblink/resistor",
      "params": {
        "resistance": "330"
      }
    },
    {
      "id": "R_LED2",
      "component": "emblink/resistor",
      "params": {
        "resistance": "330"
      }
    },
    {
      "id": "R_LED3",
      "component": "emblink/resistor",
      "params": {
        "resistance": "330"
      }
    },
    {
      "id": "R_LED4",
      "component": "emblink/resistor",
      "params": {
        "resistance": "330"
      }
    },
    {
      "id": "BUTTON1",
      "component": "emblink/push_button",
      "doc": "BUTTON1 on P0.11 to ground (the pin's pull-up holds it high)"
    },
    {
      "id": "BUTTON2",
      "component": "emblink/push_button",
      "doc": "BUTTON2 on P0.12 to ground (the pin's pull-up holds it high)"
    },
    {
      "id": "BUTTON3",
      "component": "emblink/push_button",
      "doc": "BUTTON3 on P0.24 to ground (the pin's pull-up holds it high)"
    },
    {
      "id": "BUTTON4",
      "component": "emblink/push_button",
      "doc": "BUTTON4 on P0.25 to ground (the pin's pull-up holds it high)"
    },
    {
      "id": "SW_RESET",
      "component": "emblink/push_button",
      "doc": "RESET on P0.18 to ground (nRESET once UICR.PSELRESET selects it)"
    },
    {
      "id": "J_DLO",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Arduino digital: D0..D7 (P1.01..P1.08)"
    },
    {
      "id": "J_DHI",
      "component": "emblink/header",
      "params": {
        "pins": 10
      },
      "doc": "Arduino digital: D8..D13 (P1.10..P1.15), GND, AREF (P0.02), SDA (P0.26), SCL (P0.27)"
    },
    {
      "id": "J_ANA",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "Arduino analog: A0..A5 (P0.03, P0.04, P0.28..P0.31)"
    },
    {
      "id": "J_PWR",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "Power: VDD, 5V, GND, GND, the reset line (P0.18), VBUS"
    },
    {
      "id": "J_VCOM",
      "component": "emblink/header",
      "params": {
        "pins": 4
      },
      "doc": "The interface MCU's virtual COM port: TXD P0.06, RXD P0.08, RTS P0.05, CTS P0.07"
    },
    {
      "id": "J_SWD",
      "component": "emblink/header",
      "params": {
        "pins": 2
      },
      "doc": "Serial wire debug to the interface MCU: SWDIO, SWDCLK"
    },
    {
      "id": "J_USB",
      "component": "emblink/header",
      "params": {
        "pins": 2
      },
      "doc": "The nRF USB connector's data lines (USB is not modelled)"
    },
    {
      "id": "J_ANT",
      "component": "emblink/header",
      "params": {
        "pins": 1
      },
      "doc": "The 2.4 GHz antenna (the radio is not modelled)"
    }
  ],
