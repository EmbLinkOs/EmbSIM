{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/pico",
  "version": "1.0.0",
  "name": "Raspberry Pi Pico (RP2040)",
  "description": "The Raspberry Pi Pico: the RP2040 with 2 MiB of W25Q16JV QSPI flash, a 12 MHz crystal, the user LED on GPIO25 (active high), the BOOTSEL button, a 3.3 V buck-boost regulator from VSYS and the 40-pin edge. USB comes in as VBUS; the session's console is UART0 on GP0 (TX) and GP1 (RX).",
  "keywords": [
    "pico",
    "raspberry pi",
    "rp2040",
    "cortex-m0+"
  ],
  "revision": "Rev 3",
  "mcu": {
    "ref": "raspberrypi/rp2040",
    "package": "qfn56",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 12000000,
      "source": "external_crystal",
      "component": "Y1"
    }
  },
  "components": [
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "generic",
        "vout": 3.3,
        "dropout": 0.05,
        "imax": 0.8,
        "quiescent": 0
      },
      "doc": "3.3 V from VSYS (the Pico's RT6150 buck-boost: it regulates with VSYS above or below 3.3 V)"
    },
    {
      "id": "D1",
      "component": "emblink/diode_schottky",
      "doc": "VBUS to VSYS (MBR120)"
    },
    {
      "id": "Y1",
      "component": "emblink/crystal",
      "params": {
        "hz": "12meg"
      },
      "doc": "12 MHz crystal on XOSC"
    },
    {
      "id": "LED1",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "The user LED on GPIO25, active high"
    },
    {
      "id": "R_LED",
      "component": "emblink/resistor",
      "params": {
        "resistance": "470"
      }
    },
    {
      "id": "SW_BOOTSEL",
      "component": "emblink/push_button",
      "doc": "BOOTSEL: pulls the flash's chip select low through R_BOOT (read by the bootrom at reset; the stand-in boots from flash whatever it reads)"
    },
    {
      "id": "R_BOOT",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      }
    },
    {
      "id": "R_SS",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "10k",
        "voltage": 3.3
      },
      "doc": "The flash's chip select pulled up"
    },
    {
      "id": "R_ADC",
      "component": "emblink/resistor",
      "params": {
        "resistance": "200"
      },
      "doc": "ADC_AVDD filtered from 3.3 V (ADC_VREF on pin 35)"
    },
    {
      "id": "R_VB1",
      "component": "emblink/resistor",
      "params": {
        "resistance": "5.6k"
      },
      "doc": "VBUS sense divider to GPIO24"
    },
    {
      "id": "R_VB2",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      }
    },
    {
      "id": "R_VS1",
      "component": "emblink/resistor",
      "params": {
        "resistance": "200k"
      },
      "doc": "VSYS / 3 to GPIO29 (ADC3)"
    },
    {
      "id": "R_VS2",
      "component": "emblink/resistor",
      "params": {
        "resistance": "100k"
      }
    },
    {
      "id": "R_PS",
      "component": "emblink/pull_down",
      "params": {
        "resistance": "100k"
      },
      "doc": "GPIO23: the SMPS's power-save select (low: PFM)"
    },
    {
      "id": "R_EN",
      "component": "emblink/resistor",
      "params": {
        "resistance": "100k"
      },
      "doc": "3V3_EN pulled up to VSYS"
    },
    {
      "id": "J1",
      "component": "emblink/header",
      "params": {
        "pins": 20
      },
      "doc": "Pins 1-20 (GP0..GP15)"
    },
    {
      "id": "J2",
      "component": "emblink/header",
      "params": {
        "pins": 20
      },
      "doc": "Pins 21-40 (GP16..VBUS)"
    },
    {
      "id": "U3",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "The W25Q16JV QSPI flash's pins: SCLK, SS, SD0..SD3 (its contents are the MCU's flash region; the SSI answers for it)"
    },
    {
      "id": "J_USB",
      "component": "emblink/header",
      "params": {
        "pins": 2
      },
      "doc": "The micro-USB connector's data lines (USB is not modelled)"
    },
    {
      "id": "J_SWD",
      "component": "emblink/header",
      "params": {
        "pins": 3
      },
      "doc": "The debug pads: SWCLK, GND, SWDIO"
    }
  ],
  "nets": {
