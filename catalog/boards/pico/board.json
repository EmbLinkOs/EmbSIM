  "fidelity": {
    "functional": {
      "claims": "Nets, ports, the user LED and the BOOTSEL button as logic-level parts; the RP2040 boots boot2 from the first 256 bytes of flash (see its description).",
      "omissions": [
        "USB (the connector's data lines go nowhere)",
        "the BOOTSEL button's effect (the USB boot)",
        "the SMPS's power-save mode and enable"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional.",
      "omissions": [
        "as functional"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "electrical": {
      "claims": "VBUS through the Schottky diode to VSYS, the 3.3 V regulator, the LED with its series resistor, the VBUS and VSYS sense dividers on GPIO24 and GPIO29, the ADC_AVDD filter and the crystal as a BVD equivalent; GPIO bridges use the MCU's pin-model defaults.",
      "omissions": [
        "decoupling",
        "the buck-boost's switching (an ideal regulator stands for it)",
        "the 1.1 V core rail (the core supply pins sit on 3.3 V here)",
        "ESD diodes"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
