{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/explorer16-32",
  "version": "1.0.0",
  "name": "Explorer 16/32 (PIC32MX795F512L PIM)",
  "description": "Microchip's Explorer 16/32 development board with the PIC32MX795F512L plug-in module: an 8 MHz crystal on the primary oscillator and a 32.768 kHz one on the secondary, eight LEDs D3 to D10 on RA0 to RA7 (active high), the push buttons S3 (RD6), S6 (RD7) and S4 (RD13) to ground with pull-ups, MCLR's S1, a 3.3 V regulator from VIN, and UART2 on RF5 (TX) and RF4 (RX) to the USB-UART bridge, the session's console.",
  "keywords": [
    "explorer 16",
    "explorer 16/32",
    "dm240001-2",
    "pic32",
    "pic32mx",
    "pim"
  ],
  "revision": "DM240001-2 with MA320003",
  "mcu": {
    "ref": "microchip/pic32mx795f512l",
    "package": "tqfp100",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 8000000,
      "source": "external_crystal",
      "component": "Y1"
    }
  },
  "components": [
