      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "generic",
        "vout": 3.3,
        "dropout": 0.3,
        "imax": 1.0,
        "quiescent": 0
      },
      "doc": "3.3 V from VIN (the board's MCP1727 LDO, fed from the USB-C 5 V or the 9 V barrel)"
    },
    {
      "id": "Y1",
      "component": "emblink/crystal",
      "params": {
        "hz": "8meg"
      },
