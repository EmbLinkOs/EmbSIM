  "fidelity": {
    "functional": {
      "claims": "Nets, ports, the eight LEDs, the buttons with their pull-ups and MCLR's S1 as logic-level parts; the console is UART2 on the USB-UART bridge's pins.",
      "omissions": [
        "the potentiometer R6 on RB5 and the ADC it is read with",
        "the LCD, the 25LC256 EEPROM, the TC1047A temperature sensor and the mikroBUS sockets",
        "S5 (on RA7 with D10 on the real board)",
        "the USB-UART bridge itself (the session's serial port stands for it)",
        "the PIM's other parts (the USB connector, the second crystal's load capacitors)"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional.",
      "omissions": [
        "as functional"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "electrical": {
      "claims": "The 3.3 V regulator from VIN, the LEDs with their series resistors, the buttons' and MCLR's pull-ups and the crystals as BVD equivalents; GPIO bridges use the MCU's pin-model defaults.",
      "omissions": [
        "decoupling",
        "the supply selection (USB-C, barrel jack, the PICkit)",
        "ESD diodes"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
