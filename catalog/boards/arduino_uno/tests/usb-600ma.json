{
  "schema_version": 1,
  "kind": "component_test",
  "name": "usb-600ma",
  "description": "600 mA drawn from the 5V pin: the rail sags by the cable (0.25 ohm), F1 (0.3 ohm) and T1 to about 4.6 V.",
  "policy": "electrical",
  "until": "3s",
  "circuit": {
    "boards": [
      {
        "id": "B1",
        "board": "emblink/arduino_uno"
      }
    ],
    "components": [
      {
        "id": "HOST",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5.0
        }
      },
      {
        "id": "CABLE",
        "component": "emblink/resistor",
        "params": {
          "resistance": 0.25
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 8.0
        }
      }
    ],
    "nets": {
      "HOSTV": [
        "HOST.+",
        "CABLE.1"
      ],
      "VBUS": [
        "CABLE.2",
        "B1.USB_VBUS"
      ],
      "GND": [
        "HOST.-",
        "G.GND",
        "B1.GND",
        "RL.2"
      ],
      "R5": [
        "B1.5V",
        "RL.1"
      ]
    }
  },
  "inputs": [],
  "expect": {
    "net:R5": {
      "at": "1s",
      "min_v": 4.55,
      "max_v": 4.72
    }
  }
}
