{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/arduino_uno",
  "version": "1.0.0",
  "name": "Arduino Uno R3 (ATmega328P)",
  "description": "The Arduino Uno R3: an ATmega328P at 16 MHz, 5 V and 3.3 V regulators, the 'L' LED on D13, the power LED, the reset button, and the digital, analog and power headers. USB comes in as the 5 V pin; the ATmega16U2 USB-to-serial bridge is the session's serial console on USART0, and a serial port on the host (embsim serve --serial), whose DTR resets the ATmega328P as the board's 100 nF auto-reset capacitor does.",
  "keywords": [
    "arduino",
    "uno",
    "atmega328p",
    "avr"
  ],
  "revision": "R3",
  "mcu": {
    "ref": "microchip/atmega328p",
    "package": "dip28",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 16000000,
      "source": "external_crystal",
      "component": "Y1"
    }
  },
  "components": [
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "LM1117-5.0"
      },
      "doc": "5 V regulator from VIN (an NCP1117ST50 on the R3)"
    },
    {
      "id": "U3",
      "component": "emblink/regulator",
      "params": {
        "part": "LM1117-3.3"
      },
      "doc": "3.3 V regulator for the 3V3 pin (an LP2985-33 on the R3)"
    },
    {
      "id": "Y1",
      "component": "emblink/crystal",
      "params": {
        "hz": "16meg"
      },
      "doc": "16 MHz resonator (CSTCE16M0V53)"
    },
    {
      "id": "LED_L",
      "component": "emblink/led",
      "params": {
        "color": "yellow"
      },
      "doc": "The 'L' LED on D13 (the R3 drives it through an LMV358 follower; here directly through R_L)"
    },
    {
      "id": "R_L",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      }
    },
    {
      "id": "LED_ON",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "The 'ON' power LED"
    },
    {
      "id": "R_ON",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      }
    },
    {
      "id": "SW_RESET",
      "component": "emblink/push_button",
      "doc": "Reset, pulls RESET low"
    },
    {
      "id": "DTR_RESET",
      "component": "emblink/push_button",
      "params": {
        "bounce": false
      },
      "doc": "The 16U2's auto-reset: DTR falling pulls RESET low through the 100 nF capacitor until the pull-up recharges it (the console bridge's dtr_reset). An electronic pulse, not a contact: it does not bounce"
    },
    {
      "id": "R_RESET",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "10k",
        "voltage": 5.0
      },
      "doc": "RESET pull-up (the 16U2's auto-reset through 100 nF is the console bridge's dtr_reset)"
    },
    {
      "id": "J_PWR",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Power: NC IOREF RESET 3V3 5V GND GND VIN"
    },
    {
      "id": "J_ANA",
      "component": "emblink/header",
      "params": {
        "pins": 6
      },
      "doc": "Analog in: A0..A5"
    },
    {
      "id": "J_DLO",
      "component": "emblink/header",
      "params": {
        "pins": 8
      },
      "doc": "Digital: D0..D7"
    },
    {
      "id": "J_DHI",
      "component": "emblink/header",
      "params": {
        "pins": 10
      },
      "doc": "Digital: D8..D13 GND AREF SDA SCL"
    },
    {
      "id": "F1",
      "component": "emblink/mf_msmf050",
      "doc": "USB's 500 mA resettable fuse (MF-MSMF050-2) on VBUS"
    },
    {
      "id": "T1",
      "component": "emblink/fdn340p",
      "doc": "Connects USB's 5 V (USBVCC) to +5V unless VIN supplies the board"
    },
    {
      "id": "U5",
      "component": "emblink/lmv358",
      "doc": "LMV358: half A compares VIN/2 with 3.3 V to switch T1; half B buffers D13 (its output's LED is driven from D13 here)"
    },
    {
      "id": "RN1A",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      },
      "doc": "VIN/2 divider, upper"
    },
    {
      "id": "RN1B",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      },
      "doc": "VIN/2 divider, lower"
    }
  ],
