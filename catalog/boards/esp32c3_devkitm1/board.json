{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/esp32c3_devkitm1",
  "version": "1.0.0",
  "name": "ESP32-C3-DevKitM-1",
  "description": "Espressif's ESP32-C3-DevKitM-1 (V1.0): an ESP32-C3-MINI-1 module (the ESP32-C3FN4 with its 40 MHz crystal and 4 MB of flash), the SGM2212 regulator making 3.3 V from the micro-USB's 5 V through a 1N5819HW, the red 5 V LED, the addressable RGB LED (SK68XXMINI-HS) on GPIO8, the BOOT button on GPIO9, the RST button on CHIP_PU and two 15-pin headers. The CP2102N's USB-to-UART bridge on UART0 (GPIO21/GPIO20) is the session's serial console, and a serial port on the host (embsim serve --serial). The firmware is a flash image (bin), as idf.py and esptool write it.",
  "keywords": [
    "esp32-c3",
    "esp32c3",
    "devkitm-1",
    "esp32-c3-mini-1",
    "risc-v",
    "espressif",
    "cp2102n",
    "sk6812"
  ],
  "revision": "V1.0",
  "mcu": {
    "ref": "espressif/esp32c3",
    "package": "mini1",
    "instance": "U4"
  },
  "oscillators": {
    "hse": {
      "hz": 40000000,
      "source": "external_crystal"
    }
  },
  "components": [
    {
      "id": "D1",
      "component": "emblink/diode_schottky",
      "params": {
        "part": "1N5819"
      },
      "doc": "1N5819HW-7-F: the USB's VBUS to the board's 5 V, so 5 V fed at the header does not reach the host (the SOD-123 1N5819's model)"
    },
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "SGM2212-3.3"
      },
      "doc": "SGM2212-3.3XKC3G/TR: 3.3 V from 5 V for the module, the LED and the bridge"
    },
    {
      "id": "C7",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "10u"
      },
      "doc": "U2's input capacitor, 10 uF/25 V"
    },
    {
      "id": "R11",
      "component": "emblink/resistor",
      "params": {
        "resistance": "5.1k"
      },
      "doc": "D5's resistor"
    },
    {
      "id": "D5",
      "component": "emblink/led",
      "params": {
        "color": "red"
      },
      "doc": "The 5 V power-on LED"
    },
    {
      "id": "R5",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      },
      "doc": "CHIP_PU's pull-up to 3V3"
    },
    {
      "id": "C6",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "1u"
      },
      "doc": "CHIP_PU's 1 uF/16 V: with R5 it delays the chip's start after power-up (the RC the datasheet asks for)"
    },
    {
      "id": "SW2",
      "component": "emblink/push_button",
      "doc": "RST (NTC013-AT1J-A160T): joins CHIP_PU to ground"
    },
    {
      "id": "SW1",
      "component": "emblink/push_button",
      "doc": "BOOT (NTC013-AT1J-A160T): joins GPIO9 to ground; held through a reset, the ROM waits for a download"
    },
    {
      "id": "R20",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      },
      "doc": "GPIO8's pull-up to 3V3: the strapping pin high, as download mode needs"
    },
    {
      "id": "D6",
      "component": "emblink/sk6812mini_hs",
      "doc": "The addressable RGB LED (SK68XXMINI-HS) on GPIO8, through R17 (0 ohm), supplied from 3V3"
    },
    {
      "id": "J1",
