  "fidelity": {
    "functional": {
      "claims": "Nets, ports, LEDs, reset button and boot jumpers as logic-level parts; the MCU has no behavioural model yet (M1).",
      "omissions": [
        "USB",
        "decoupling",
        "firmware execution"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional.",
      "omissions": [
        "USB",
        "decoupling"
      ],
      "validation": []
    },
    "electrical": {
      "claims": "LDO, LEDs with series resistors, pull-ups and pull-downs, the 100 nF NRST capacitor (with the 10k pull-up it holds NRST low about 0.8 ms after power-up and through the reset button's bounce), crystals as BVD equivalents, headers; GPIO bridges use the MCU pin-model defaults.",
      "omissions": [
        "decoupling",
        "USB",
        "ESD diodes",
        "trace impedance"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
