{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/bluepill",
  "version": "1.0.0",
  "name": "Blue Pill (STM32F103C8T6)",
  "description": "The generic 'Blue Pill' STM32F103C8T6 development board: 3.3 V LDO, 8 MHz and 32.768 kHz crystals, user LED on PC13, reset button, BOOT0/BOOT1 jumpers, two 20-pin headers and a 4-pin SWD header.",
  "keywords": [
    "blue pill",
    "stm32f103",
    "stm32",
    "cortex-m3"
  ],
  "revision": "generic 2019",
  "mcu": {
    "ref": "st/stm32f103c8",
    "package": "lqfp48",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 8000000,
      "source": "external_crystal",
      "component": "Y1"
    },
    "lse": {
      "hz": 32768,
      "source": "external_crystal",
      "component": "Y2"
    }
  },
  "components": [
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "AMS1117-3.3"
      },
      "doc": "3.3 V LDO fed from the 5 V pin or USB"
    },
    {
      "id": "LED1",
      "component": "emblink/led",
      "params": {
        "color": "green"
      },
      "doc": "User LED, cathode on PC13 (active low)"
    },
    {
      "id": "R1",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      }
    },
    {
      "id": "LED_PWR",
      "component": "emblink/led",
      "params": {
        "color": "red"
      },
      "doc": "Power LED on the 3.3 V rail"
    },
    {
      "id": "R_PWR",
      "component": "emblink/resistor",
      "params": {
        "resistance": "1k"
      }
    },
    {
      "id": "SW_RESET",
      "component": "emblink/push_button",
      "doc": "Reset, pulls NRST low"
    },
    {
      "id": "R_RESET",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "10k",
        "voltage": 3.3
      },
      "doc": "NRST pull-up"
    },
    {
      "id": "C_RESET",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "100n"
      },
      "doc": "The 100 nF NRST capacitor: with the 10k pull-up it holds NRST low through the reset button's bounce"
    },
    {
      "id": "Y1",
      "component": "emblink/crystal",
      "params": {
        "hz": "8meg"
      }
    },
    {
      "id": "Y2",
      "component": "emblink/crystal",
      "params": {
        "hz": 32768,
        "c0": "1.5p",
        "cm": "3f",
        "lm": "7.8k",
        "rm": "35k"
      }
    },
    {
      "id": "SW_BOOT0",
      "component": "emblink/toggle_switch",
      "doc": "BOOT0 jumper: closed = BOOT0 high (system memory boot)"
    },
    {
      "id": "R_BOOT0",
      "component": "emblink/pull_down",
      "params": {
        "resistance": "100k"
      }
    },
    {
      "id": "SW_BOOT1",
      "component": "emblink/toggle_switch",
      "doc": "BOOT1 (PB2) jumper: closed = high"
    },
    {
      "id": "R_BOOT1",
      "component": "emblink/pull_down",
      "params": {
        "resistance": "100k"
      }
    },
    {
      "id": "R_BOOTV",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "100k",
        "voltage": 3.3
      },
      "doc": "Jumper high side (3.3 V through 100 k)"
    },
    {
      "id": "R_USB",
      "component": "emblink/pull_up",
      "params": {
        "resistance": "1.5k",
        "voltage": 3.3
      },
      "doc": "USB D+ pull-up on PA12 (clones often fit 10 k)"
    },
    {
      "id": "J1",
      "component": "emblink/header",
      "params": {
        "pins": 20
      },
      "doc": "Top row (USB on the left): VB C13 C14 C15 A0..A7 B0 B1 B10 B11 R 3.3 G G"
    },
    {
      "id": "J2",
      "component": "emblink/header",
      "params": {
        "pins": 20
      },
      "doc": "Bottom row: B12..B15 A8..A12 A15 B3..B9 5V G 3.3"
    },
    {
      "id": "J3",
      "component": "emblink/header",
      "params": {
        "pins": 4
      },
      "doc": "SWD header: 3.3 DIO CLK G"
    }
  ],
  "nets": {
