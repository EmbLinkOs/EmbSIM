{
  "schema_version": 1,
  "kind": "component_test",
  "name": "vin-needs-jp3",
  "description": "9 V on VIN with JP3 still on U5V: U3 makes its 5 V, but nothing joins it to +5V, so the board stays dark (UM1974: JP3 must be moved to VIN).",
  "policy": "electrical",
  "until": "10ms",
  "circuit": {
    "boards": [
      {
        "id": "B1",
        "board": "emblink/nucleo_f446ze"
      }
    ],
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 9.0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "VS.+",
        "B1.VIN"
      ],
      "GND": [
        "VS.-",
        "G.GND",
        "B1.GND"
      ],
      "R5": [
        "B1.5V"
      ],
      "VDD": [
        "B1.CN11_5"
      ]
    }
  },
  "inputs": [],
  "expect": {
    "net:R5": {
      "at": "9ms",
      "max_v": 0.3
    },
    "net:VDD": {
      "at": "9ms",
      "max_v": 0.3
    },
    "output:B1.LD6.luminance": {
      "at": "9ms",
      "max": 0.001
    }
  }
}
