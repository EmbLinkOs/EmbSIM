{
  "schema_version": 1,
  "kind": "component_test",
  "name": "usb-powered",
  "description": "Plugged into a computer's USB port through a 0.25 ohm cable: D2 passes VBUS to 5V less its Schottky drop, U2 (AMS1117-3.3) makes 3V3, D1 glows (about 0.6 mA through R2's 2 k) and R11 holds EN high.",
  "policy": "electrical",
  "until": "60ms",
  "circuit": {
    "boards": [
      {
        "id": "B1",
        "board": "emblink/esp32_devkitc"
      }
    ],
    "components": [
      {
        "id": "HOST",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5.0
        }
      },
      {
        "id": "CABLE",
        "component": "emblink/resistor",
        "params": {
          "resistance": 0.25
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "HOSTV": [
        "HOST.+",
        "CABLE.1"
      ],
      "VBUS": [
        "CABLE.2",
        "B1.VBUS"
      ],
      "GND": [
        "HOST.-",
        "G.GND",
        "B1.GND1"
      ],
      "V5": [
        "B1.5V"
      ],
      "V33": [
        "B1.3V3"
      ],
      "EN": [
        "B1.EN"
      ]
    }
  },
  "expect": {
    "net:V5": {
      "at": "50ms",
      "min_v": 4.5,
      "max_v": 4.95
    },
    "net:V33": {
      "at": "50ms",
      "min_v": 3.25,
      "max_v": 3.35
    },
    "net:EN": {
      "at": "50ms",
      "min_v": 3.2,
      "max_v": 3.35
    },
    "output:B1.D1.luminance": {
      "at": "50ms",
      "min": 0.01
    }
  }
}