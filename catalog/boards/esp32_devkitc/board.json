  "fidelity": {
    "functional": {
      "claims": "Nets, ports, the power LED and the two buttons as parts; the ESP32 runs its firmware from the flash image (see its description): Espressif's own ROM, the second-stage bootloader and the app, as on the board. EN pulls CHIP_PU low and the chip starts again with rst:0x1 (POWERON_RESET); Boot held through it makes the ROM wait for a download. The CP2102N's port is the session's console on UART0 (GPIO1/GPIO3) and a serial port on the host.",
      "omissions": [
        "the CP2102N itself: its USB enumeration, its modem lines and so the auto-program circuit (Q1, Q2 and R21, R22 that let esptool's DTR and RTS drive EN and GPIO0): pressing Boot and EN does what they do",
        "the ESD diodes on the USB lines (LESD5D5.0CT1G) and the USB connector",
        "the flash pins GPIO6-11 on the headers (D0-D3, CMD, CLK): the module keeps them for its flash and the ports leave them out",
        "the artwork and the bench model"
      ],
      "validation": []
    },
    "electrical": {
      "claims": "The power path from the schematic: VBUS through the Schottky to 5 V, the AMS1117-3.3 to 3.3 V, the LED, the EN RC.",
      "omissions": [],
      "validation": []
    }
  },
