{
  "schema_version": 1,
  "kind": "board",
  "id": "emblink/esp32_devkitc",
  "version": "1.0.0",
  "name": "ESP32-DevKitC V4",
  "description": "Espressif's ESP32-DevKitC V4 with an ESP32-WROOM-32E module (the ESP32-D0WD-V3 with its 40 MHz crystal and 4 MB of flash), the AMS1117-3.3 regulator making 3.3 V from the micro-USB's 5 V through a BAT760 Schottky, the red power LED, the Boot button on GPIO0, the EN button on CHIP_PU with its RC, and two 19-pin headers. The CP2102N's USB-to-UART bridge on UART0 (GPIO1/GPIO3) is the session's serial console, and a serial port on the host (embsim serve --serial). The firmware is a flash image (bin), as idf.py and esptool write it.",
  "keywords": [
    "esp32",
    "devkitc",
    "esp32-devkitc-v4",
    "esp32-wroom-32e",
    "xtensa",
    "espressif",
    "cp2102n"
  ],
  "revision": "V4",
  "mcu": {
    "ref": "espressif/esp32",
    "package": "wroom32e",
    "instance": "U1"
  },
  "oscillators": {
    "hse": {
      "hz": 40000000,
      "source": "external_crystal"
    }
  },
  "components": [
    {
      "id": "D2",
      "component": "emblink/diode_schottky",
      "params": {
        "part": "generic"
      },
      "doc": "BAT760-7: the USB's VBUS to the board's 5 V (EXT_5V), so 5 V fed at the header does not reach the host (the generic Schottky's model)"
    },
    {
      "id": "U2",
      "component": "emblink/regulator",
      "params": {
        "part": "AMS1117-3.3"
      },
      "doc": "AMS1117-3.3: 3.3 V from 5 V for the module and the bridge"
    },
    {
      "id": "C21",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "22u"
      },
      "doc": "U2's input capacitor, 22 uF/10 V"
    },
    {
      "id": "C22",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "100n"
      },
      "doc": "U2's input decoupling, 0.1 uF/50 V"
    },
    {
      "id": "C1",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "22u"
      },
      "doc": "U2's output capacitor, 22 uF/10 V"
    },
    {
      "id": "C3",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "22u"
      },
      "doc": "The 3.3 V rail's bulk capacitor at the module, 22 uF/10 V"
    },
    {
      "id": "R2",
      "component": "emblink/resistor",
      "params": {
        "resistance": "2k"
      },
      "doc": "D1's resistor"
    },
    {
      "id": "D1",
      "component": "emblink/led",
      "params": {
        "color": "red"
      },
      "doc": "The power-on LED"
    },
    {
      "id": "R11",
      "component": "emblink/resistor",
      "params": {
        "resistance": "10k"
      },
      "doc": "EN's pull-up to 3.3 V"
    },
    {
      "id": "C9",
      "component": "emblink/capacitor",
      "params": {
        "capacitance": "100n"
      },
      "doc": "EN's 0.1 uF: with R11 it delays the chip's start after power-up (the RC the datasheet asks for)"
    },
    {
      "id": "SW2",
      "component": "emblink/push_button",
      "doc": "EN: joins EN to ground (reset)"
    },
    {
      "id": "SW1",
      "component": "emblink/push_button",
      "doc": "Boot: joins GPIO0 to ground; held through a reset, the ROM waits for a download"
    },
    {
      "id": "J2",
      "component": "emblink/header",
      "params": {
        "pins": 19
      },
      "doc": "The left header (CON19X1_2P54)"
    },
    {
      "id": "J3",
      "component": "emblink/header",
      "params": {
        "pins": 19
      },
      "doc": "The right header (CON19X1_2P54)"
    }
  ],
