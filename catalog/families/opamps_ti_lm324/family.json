    "i18n": {
      "fr": {
        "description": "Texas Instruments ${mpn}, l'amplificateur opérationnel quadruple ${device} en ${pkg} (${temp_fr}, jusqu'à ${vmax} V) : gain en boucle ouverte de 100 V/mV, produit gain-bande de 1,2 MHz, vitesse de balayage de 0,5 V/us, ${note_fr}. Quatre canaux sur le brochage quadruple standard, VCC+ en broche 4 et VCC- en broche 11.",
        "fidelity": {
          "electrical": {
            "claims": "Quatre amplificateurs opérationnels (opamp de SPEC-004) au gain en boucle ouverte typique de la fiche technique (100 V/mV), un pôle unique à son produit gain-bande de 1,2 MHz, sa vitesse de balayage de 0,5 V/us et l'excursion de sa sortie depuis chaque rail ; cas de test pour un suiveur, l'excursion positive, la vitesse de balayage et la bande passante, sur des canaux différents.",
            "omissions": [
              "la tension de décalage d'entrée, les courants de polarisation et de décalage, et leur dérive",
              "la plage d'entrée en mode commun (jusqu'à VCC+ moins 1,5 V) : une entrée au-delà n'est pas signalée",
              "les pôles suivants, la marge de phase et la stabilité sur charge capacitive",
              "la limite de courant de sortie (20 à 60 mA), la distorsion de croisement de la sortie classe B et son puits de 50 uA au rail négatif",
              "le bruit (35 nV/rtHz)",
              "le courant d'alimentation (0,7 mA pour les quatre)",
              "la dépendance à la température",
              "la dispersion d'un exemplaire à l'autre"
            ]
          }
        }
