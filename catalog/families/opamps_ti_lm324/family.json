    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Four op-amps (SPEC-004 opamp) at the datasheet's typical open-loop gain (100 V/mV), a single pole at its 1.2 MHz gain-bandwidth, its 0.5 V/us slew rate and its output swing from each rail; fixtures for a follower, the positive swing, the slew rate and the bandwidth, on different channels.",
        "omissions": [
          "input offset voltage, bias and offset currents, and their drift",
          "the common-mode input range (to VCC+ minus 1.5 V): inputs above it are not diagnosed",
          "further poles, the phase margin and the capacitive-load stability",
          "the output current limit (20 to 60 mA), the class-B output's crossover distortion and its 50 uA pull-down sink at the negative rail",
          "noise (35 nV/rtHz)",
          "supply current (0.7 mA for the four)",
          "temperature dependence",
          "device-to-device spread"
        ],
