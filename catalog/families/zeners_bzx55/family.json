{
  "schema_version": 1,
  "kind": "family",
  "name": "BZX55 zener diodes",
  "datasheets": {
    "vishay-85604": {
      "title": "Vishay BZX55 series datasheet (document 85604)",
      "url": "https://www.vishay.com/docs/85604/bzx55.pdf",
      "rev": "2.0, 7 November 2024",
      "date": "2026-11-03",
      "hash": "sha256:f32a337b23a25f8ce84cdeec8a532ddeed894b7982848d1ed78be29fb7f34902",
      "notes": "Pages 1 to 3: the electrical characteristics table (VZ minimum, nominal and maximum at IZT1, IR at VR, ZZ and ZZK) for the C (5 %) and B (2 %) grades; VF 1.5 V max at 200 mA; Ptot 500 mW. DO-35, the band at the cathode; A2/K1 numbering is an ECAD convention."
    }
  },
  "evidence": [
    "Small Signal Zener Diodes",
    "Forward voltage \\(max\\.\\) IF = 200 mA VF 1\\.5 V",
    "${mpn} ${vz_min} ${vz} ${vz_max} ${izt_ma} ${izt2_ma} < ?${ir} < ?${ir_150} ${vr} < ?${zz} < ?${zzk} "
  ],
  "template": {
    "schema_version": 1,
    "kind": "component",
    "id": "emblink/${short}",
    "version": "1.0.0",
    "name": "${mpn}",
    "category": "diodes",
    "subcategory": "zener",
    "description": "Vishay ${mpn}, a 500 mW small-signal zener in DO-35: ${vz} V nominal (${vz_min} to ${vz_max} V) at its test current IZT of ${izt_ma} mA, the BZX55 series' ${tol} grade. The breakdown is placed so the voltage at IZT is the nominal one; the reverse current at ${vr} V stays under the datasheet's ${ir} uA and the forward voltage at 200 mA under its 1.5 V.",
    "keywords": [
      "Vishay",
      "${mpn}",
      "BZX55",
      "DO-35",
      "zener",
      "voltage reference",
      "regulator",
      "${vz} V"
    ],
    "pins": [
      {
        "name": "A",
        "number": 2,
        "model": {
          "kind": "passive"
        },
        "doc": "Anode"
      },
      {
        "name": "K",
        "number": 1,
        "model": {
          "kind": "passive"
        },
        "doc": "Cathode"
      }
    ],
    "params": {
      "vz": {
        "type": "number",
        "unit": "V",
        "default": "${vz}",
        "doc": "Zener voltage at the test current izt",
        "min": 1,
        "max": 200
      },
      "is": {
        "type": "number",
        "unit": "A",
        "default": "1e-14",
        "doc": "Forward saturation current",
        "min": "1e-20",
        "max": "1m",
        "advanced": true
      },
      "n": {
        "type": "number",
        "unit": "",
        "default": 1,
        "doc": "Forward emission coefficient",
        "min": 0.5,
        "max": 5,
        "advanced": true
      },
      "rs": {
        "type": "number",
        "unit": "ohm",
        "default": 0.5,
        "doc": "Forward series resistance",
        "min": 0,
        "advanced": true
      },
      "izt": {
        "type": "number",
        "unit": "A",
        "default": "${izt}",
        "doc": "Test current at which the voltage is vz (IZT1)",
        "min": "1u",
        "max": "0.2",
        "advanced": true
      }
    },
    "model": {
      "primitive": "zener"
    },
    "symbol": {
      "svg": "symbol.svg",
      "width": 60,
      "height": 20,
      "pins": {
        "A": {
          "x": 0,
          "y": 10,
          "side": "left"
        },
        "K": {
          "x": 60,
          "y": 10,
          "side": "right"
        }
      }
    },
    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Zener junction placed so the voltage at IZT is the nominal VZ, inside the datasheet's minimum and maximum; leakage under the table's IR at VR; forward voltage under 1.5 V at 200 mA. DC and low-frequency fixtures from the datasheet's table.",
        "omissions": [
          "the knee's softness below IZT (ZZK at IZT2): the model's knee is a sharp exponential",
          "dynamic resistance: one 0.5 ohm series resistance serves both directions, so the slope above IZT is under the table's ZZ maximum rather than at it",
          "the temperature coefficient (TKVZ) and the 150 C leakage",
          "capacitance",
          "power dissipation (500 mW) and damage",
          "device-to-device spread within the grade",
          "noise",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
      "author": "EmbSIM",
      "license": "Apache-2.0",
      "sources": [
        {
          "title": "KiCad family/package reference, revision 4e17d759",
          "url": "https://github.com/KiCad/kicad-symbols/blob/4e17d7595f9691d45d97aea8ad64572652fb5bed/Diode.lib"
        }
      ]
    },
    "tests": [
      "tests/*.json"
    ],
    "part": {
      "manufacturer": "Vishay",
      "mpn": "${mpn}",
      "package": "DO-35",
      "datasheet": "${datasheet_url}"
    },
    "artwork": {
      "svg": "artwork.svg"
    },
    "i18n": {
      "fr": {
        "description": "Vishay ${mpn}, une zener petits signaux de 500 mW en DO-35 : ${vz} V nominal (${vz_min} à ${vz_max} V) à son courant de test IZT de ${izt_ma} mA, la classe ${tol} de la série BZX55. Le claquage est placé pour que la tension à IZT soit la nominale ; le courant inverse à ${vr} V reste sous les ${ir} uA de la fiche technique et la tension directe à 200 mA sous ses 1,5 V.",
        "fidelity": {
          "electrical": {
            "claims": "Jonction zener placée pour que la tension à IZT soit la VZ nominale, entre le minimum et le maximum de la fiche technique ; fuite sous l'IR du tableau à VR ; tension directe sous 1,5 V à 200 mA. Cas de test en continu et basse fréquence tirés du tableau de la fiche technique.",
            "omissions": [
              "la douceur du coude sous IZT (ZZK à IZT2) : le coude du modèle est une exponentielle franche",
              "la résistance dynamique : une seule résistance série de 0,5 ohm sert dans les deux sens, la pente au-dessus d'IZT est donc sous le maximum ZZ du tableau plutôt qu'à sa valeur",
              "le coefficient de température (TKVZ) et la fuite à 150 °C",
              "la capacité",
              "la puissance dissipée (500 mW) et les dommages",
              "la dispersion d'un exemplaire à l'autre dans la classe",
              "le bruit",
              "aucune qualification par un modèle du fabricant"
            ]
          }
        }
      }
    }
  },
  "tests": {
    "zener": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "zener",
      "description": "IZT in reverse: the voltage within the datasheet's VZ minimum and maximum",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "I1",
            "component": "emblink/isource",
            "params": {
              "dc": "${izt}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VZ": [
            "I1.-",
            "DUT.K"
          ],
          "GND": [
            "I1.+",
            "DUT.A",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VZ": {
          "at": "50us",
          "min_v": "${vz_min}",
          "max_v": "${vz_max}"
        }
      }
    },
    "leakage": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "leakage",
      "description": "VR across it through 100 kohm: under the datasheet's IR at 25 C",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "V1",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vr}"
            }
          },
          {
            "id": "R1",
            "component": "emblink/resistor",
            "params": {
              "resistance": "100k"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VIN": [
            "V1.+",
            "R1.1"
          ],
          "VK": [
            "R1.2",
            "DUT.K"
          ],
          "GND": [
            "V1.-",
            "DUT.A",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VK": {
          "at": "50us",
          "min_v": "${vk_min}",
          "max_v": "${vr}"
        }
      }
    },
    "forward": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "forward",
      "description": "200 mA forward: under the datasheet's 1.5 V",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "I1",
            "component": "emblink/isource",
            "params": {
              "dc": 0.2
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VD": [
            "I1.-",
            "DUT.A"
          ],
          "GND": [
            "I1.+",
            "DUT.K",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VD": {
          "at": "50us",
          "min_v": 0.6,
          "max_v": 1.5
        }
      }
    }
  },
