{
  "schema_version": 1,
  "kind": "family",
  "name": "onsemi BC546, BC547 and BC548 NPN transistors",
  "datasheets": {
    "onsemi-bc546": {
      "title": "onsemi BC546B, BC547A, B, C, BC548B, C datasheet (BC546/D)",
      "url": "https://www.onsemi.com/pdf/datasheet/bc546-d.pdf",
      "rev": "8, August 2021",
      "date": "2026-11-03",
      "hash": "sha256:d39beee49b1ebf72cddb9b3deb376fdeef33ad56d1be46cb3dc62553cbebddf0",
      "notes": "Pages 1 and 2: VCEO and VCBO per type, IC 100 mA, PD 625 mW, ICES, hFE per group at 2 mA, VCE(sat), VBE(on) 0.55 to 0.7 V at 2 mA, fT, Cobo. TO-92 case 29 style 17: C1, B2, E3."
    }
  },
  "evidence": [
    "BC546B, BC547A, B, C, BC548B, C",
    "Collector Current − Continuous IC 100 mAdc",
    "V\\(BR\\)CEO V \\(IC = 1\\.0 mA, IB = 0\\) BC546 65 − − BC547 45 − − BC548 30",
    "\\(IC = 2\\.0 mA, VCE = 5\\.0 V\\) 0\\.55 − 0\\.7",
    "\\(IC = 10 mA, IB = 0\\.5 mA\\) − 0\\.09 0\\.25"
  ],
  "template": {
    "schema_version": 1,
    "kind": "component",
    "id": "emblink/${short}",
    "version": "1.0.0",
    "name": "${mpn}",
    "category": "transistors",
    "subcategory": "bipolar_npn",
    "description": "onsemi ${mpn}, a NPN general-purpose amplifier transistor in TO-92 (C1, B2, E3): VCEO ${vceo} V, 100 mA, 625 mW, hFE group ${group}: ${hfe_min} to ${hfe_max} at 2 mA and 5 V. The model's gain is the group's typical ${hfe_typ} and its VBE(on) ${vbe_typ} V at 2 mA, inside the datasheet's 0.55 to 0.7 V.",
    "keywords": [
      "onsemi",
      "${mpn}",
      "TO-92",
      "NPN",
      "BJT",
      "transistor",
      "small signal",
      "amplifier",
      "switch",
      "${series}"
    ],
    "pins": [
      {
        "name": "C",
        "number": 1,
        "model": {
          "kind": "passive"
        },
        "doc": "Collector"
      },
      {
        "name": "B",
        "number": 2,
        "model": {
          "kind": "passive"
        },
        "doc": "Base"
      },
      {
        "name": "E",
        "number": 3,
        "model": {
          "kind": "passive"
        },
        "doc": "Emitter"
      }
    ],
    "params": {
      "is": {
        "type": "number",
        "unit": "A",
        "default": "${is_a}",
        "doc": "Transport saturation current",
        "min": "1e-20",
        "max": "1m",
        "advanced": true
      },
      "bf": {
        "type": "number",
        "unit": "",
        "default": "${hfe_typ}",
        "doc": "Forward current gain",
        "min": 1,
        "max": 2000
      },
      "br": {
        "type": "number",
        "unit": "",
        "default": 4,
        "doc": "Reverse current gain",
        "min": 0.01,
        "max": 100,
        "advanced": true
      },
      "rb": {
        "type": "number",
        "unit": "ohm",
        "default": 0,
        "doc": "Base resistance",
        "min": 0,
        "advanced": true
      },
      "rc": {
        "type": "number",
        "unit": "ohm",
        "default": 0,
        "doc": "Collector resistance",
        "min": 0,
        "advanced": true
      },
      "re": {
        "type": "number",
        "unit": "ohm",
        "default": 0,
        "doc": "Emitter resistance",
        "min": 0,
        "advanced": true
      }
    },
    "model": {
      "primitive": "bjt_npn"
    },
    "symbol": {
      "svg": "symbol.svg",
      "width": 40,
      "height": 40,
      "pins": {
        "B": {
          "x": 0,
          "y": 20,
          "side": "left"
        },
        "C": {
          "x": 40,
          "y": 0,
          "side": "top"
        },
        "E": {
          "x": 40,
          "y": 40,
          "side": "bottom"
        }
      }
    },
    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Ebers-Moll transistor whose forward gain is the hFE group's typical value and whose VBE(on) at 2 mA falls inside the datasheet's limits; saturation under the datasheet's VCE(sat) maximum at 10 mA; leakage under its ICES maximum. DC and low-frequency fixtures from the datasheet's table.",
        "omissions": [
          "the Early effect (output conductance): the datasheet gives none, so the collector current does not rise with VCE",
          "the fall of hFE at high current (180 typical at 100 mA for the B group)",
          "breakdown (VCEO ${vceo} V, VCBO, VEBO 6 V) and damage past the 100 mA and 625 mW ratings",
          "capacitances (Cobo, Cibo) and fT, so no switching times or bandwidth",
          "temperature dependence",
          "device-to-device spread within the hFE group",
          "noise",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
      "author": "EmbSIM",
      "license": "Apache-2.0",
      "sources": [
        {
          "title": "KiCad family/package reference, revision 4e17d759",
          "url": "https://github.com/KiCad/kicad-symbols/blob/4e17d7595f9691d45d97aea8ad64572652fb5bed/Transistor_BJT.lib"
        }
      ]
    },
    "part": {
      "manufacturer": "onsemi",
      "mpn": "${mpn}",
      "package": "TO-92",
      "datasheet": "${datasheet_url}"
    },
    "artwork": {
      "svg": "artwork.svg"
    },
    "tests": [
      "tests/*.json"
    ],
    "i18n": {
      "fr": {
        "description": "onsemi ${mpn}, un transistor amplificateur NPN d'usage général en TO-92 (C1, B2, E3) : VCEO ${vceo} V, 100 mA, 625 mW, groupe de gain ${group} : ${hfe_min} à ${hfe_max} à 2 mA et 5 V. Le gain du modèle est la valeur typique du groupe, ${hfe_typ}, et sa VBE(on) ${vbe_typ_fr} V à 2 mA, entre les 0,55 et 0,7 V de la fiche technique.",
        "fidelity": {
          "electrical": {
            "claims": "Transistor d'Ebers-Moll dont le gain direct est la valeur typique du groupe de hFE et dont la VBE(on) à 2 mA tombe dans les limites de la fiche technique ; saturation sous le maximum de VCE(sat) de la fiche technique à 10 mA ; fuite sous son maximum d'ICES. Cas de test en continu et basse fréquence tirés du tableau de la fiche technique.",
            "omissions": [
              "l'effet Early (la conductance de sortie) : la fiche technique n'en donne pas, le courant de collecteur ne croît donc pas avec VCE",
              "la baisse de hFE à fort courant (180 typique à 100 mA pour le groupe B)",
              "le claquage (VCEO ${vceo} V, VCBO, VEBO 6 V) et les dommages au-delà des 100 mA et 625 mW nominaux",
              "les capacités (Cobo, Cibo) et fT, donc ni temps de commutation ni bande passante",
              "la dépendance à la température",
              "la dispersion d'un exemplaire à l'autre dans le groupe de hFE",
              "le bruit",
              "aucune qualification par un modèle du fabricant"
            ]
          }
        }
      }
    }
  },
  "tests": {
    "hfe": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "hfe",
      "description": "2 mA at VCE = 5 V: the collector current within the hFE group's minimum and maximum",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "VC",
            "component": "emblink/vsource",
            "params": {
              "dc": 5
            }
          },
          {
            "id": "IB",
            "component": "emblink/isource",
            "params": {
              "dc": "${ib}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VCC": [
            "VC.+",
            "DUT.C"
          ],
          "BASE": [
            "IB.-",
            "DUT.B"
          ],
          "GND": [
            "VC.-",
            "IB.+",
            "DUT.E",
            "G.GND"
          ]
        }
      },
      "expect": {
        "device:DUT.ic": {
          "at": "50us",
          "min": "${ic_min}",
          "max": "${ic_max}"
        },
        "net:BASE": {
          "at": "50us",
          "min_v": 0.55,
          "max_v": 0.7
        }
      }
    },
    "vce_sat": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "vce_sat",
      "description": "IC = 10 mA, IB = 0.5 mA: VCE(sat) under the datasheet's ${vcesat_max} V",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "IC",
            "component": "emblink/isource",
            "params": {
              "dc": 0.01
            }
          },
          {
            "id": "IB",
            "component": "emblink/isource",
            "params": {
              "dc": 0.0005
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "COLL": [
            "IC.-",
            "DUT.C"
          ],
          "BASE": [
            "IB.-",
            "DUT.B"
          ],
          "GND": [
            "IC.+",
            "IB.+",
            "DUT.E",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:COLL": {
          "at": "50us",
          "min_v": 0,
          "max_v": "${vcesat_max}"
        }
      }
    },
    "ices": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "ices",
      "description": "VCE = ${vces} V with VBE = 0: the collector current under the datasheet's 15 nA ICES",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "VC",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vces}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VCC": [
            "VC.+",
            "DUT.C"
          ],
          "GND": [
            "VC.-",
            "DUT.B",
            "DUT.E",
            "G.GND"
          ]
        }
      },
      "expect": {
        "device:DUT.ic": {
          "at": "50us",
          "min": 0,
          "max": 1.5e-08
        }
      }
    }
  },
