    "i18n": {
      "fr": {
        "description": "onsemi ${mpn}, un transistor de moyenne puissance PNP en TO-126 (E1, C2, B3) : VCEO ${vceo} V, 1,5 A, 12,5 W à 25 °C de boîtier ; groupe de gain ${group} : ${hfe_min} à ${hfe_max} à 150 mA, au moins 25 à 5 mA et 500 mA ; VCE(sat) de 0,5 V au maximum à 0,5 A, VBE(on) de 1 V au maximum. Le gain du modèle est ${bf}, au milieu du groupe.",
        "fidelity": {
          "electrical": {
            "claims": "Transistor d'Ebers-Moll à un gain constant de ${bf} (le milieu géométrique des ${hfe_min} à ${hfe_max} du groupe à 150 mA), résistances de collecteur et d'émetteur pour VCE(sat) et VBE(on) ; cas de test pour le gain à 5 mA, 150 mA et 500 mA, VCE(sat) et VBE(on) à 0,5 A.",
            "omissions": [
              "la baisse du gain à faible et fort courant : il reste ${bf}",
              "l'effet Early : le courant de collecteur ne croît pas avec VCE",
              "les capacités et fT, donc pas de temps de commutation",
              "la température : les -2 mV/°C de VBE et la hausse du gain",
              "le second claquage, l'aire de sécurité et les dommages au-delà des valeurs nominales",
              "la dispersion d'un exemplaire à l'autre dans les limites de gain",
              "aucune qualification par un modèle du fabricant"
            ]
          }
        }
      }
