  "template": {
    "schema_version": 1,
    "kind": "component",
    "id": "emblink/${short}",
    "version": "1.0.0",
    "name": "${mpn}",
    "category": "transistors",
    "subcategory": "bipolar_pnp",
    "description": "onsemi ${mpn}, a PNP medium-power transistor in TO-126 (E1, C2, B3): VCEO ${vceo} V, 1.5 A, 12.5 W at 25 C case; hFE group ${group}: ${hfe_min} to ${hfe_max} at 150 mA, at least 25 at 5 mA and 500 mA; VCE(sat) 0.5 V maximum at 0.5 A, VBE(on) 1 V maximum. The model's gain is ${bf}, the middle of the group.",
    "keywords": [
      "onsemi",
