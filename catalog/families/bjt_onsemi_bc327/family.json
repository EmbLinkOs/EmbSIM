  "tests": {
    "hfe_1": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "hfe_1",
      "description": "IC near 0.1 A at VCE = 1 V (the base fed ${ib1} A, the collector from 2 V through 10 ohm): the gain ${hfe_min} to ${hfe_max}, the datasheet's hFE there",
      "policy": "electrical",
      "until": "200us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VC",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": -2.0
            }
          },
          {
            "id": "RC",
            "component": "emblink/resistor",
            "params": {
              "resistance": 10.0,
              "tolerance": 0
            }
          },
          {
            "id": "IB",
            "component": "emblink/isource",
            "params": {
              "kind": "pulse",
              "v1": 0,
              "v2": "${nib1}",
              "td": "1u",
              "tr": "50u",
              "tf": "1u",
              "pw": "1",
              "per": "2"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VCC": [
            "VC.+",
            "RC.1"
          ],
          "COLL": [
            "RC.2",
            "DUT.C"
          ],
          "BASE": [
            "IB.-",
            "DUT.B"
          ],
          "GND": [
            "VC.-",
            "IB.+",
            "DUT.E",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:COLL": {
          "at": "150us",
          "min_v": "${hfe1_nhi}",
          "max_v": "${hfe1_nlo}"
        }
      }
    },
    "hfe_2": {
