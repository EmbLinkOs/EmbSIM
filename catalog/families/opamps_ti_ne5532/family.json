  "tests": {
    "follower": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "follower",
      "description": "Channel 1 as a follower at 1 V on +/-15 V: its output 1 V",
      "policy": "electrical",
      "until": "40us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VI",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 1
