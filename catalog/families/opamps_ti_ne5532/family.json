      "timed": {
        "claims": "As electrical.",
        "omissions": []
      },
      "electrical": {
        "claims": "Two op-amps (SPEC-004 opamp) at the datasheet's typical large-signal gain (100 V/mV), a single pole at its 12 MHz unity-gain bandwidth and its 5 V/us slew rate; fixtures on +/-15 V for a follower, the slew rate and the bandwidth. The output swing is set 5 V from each rail, the bound the datasheet's gain test guarantees (VO = +/-10 V into 600 ohm on +/-15 V); the current revision no longer gives a typical swing.",
        "omissions": [
          "the typical output swing (real parts reach about +/-13 V on +/-15 V; the model stops at +/-10 V, the guaranteed bound)",
          "input offset voltage, the bias current (200 nA typical, 800 nA max) and offset current",
          "the input protection diodes across the inputs",
          "further poles, the phase margin and the capacitive-load stability",
          "the output short-circuit current (38 mA)",
          "noise (5 nV/rtHz, 0.7 pA/rtHz)",
          "supply current (6 mA for both channels)",
          "temperature dependence",
          "device-to-device spread"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
