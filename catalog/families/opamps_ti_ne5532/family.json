      "license": "Apache-2.0",
      "sources": []
    },
    "tests": [
      "tests/*.json"
    ],
    "part": {
      "manufacturer": "Texas Instruments",
      "mpn": "${mpn}",
      "package": "${pkg}",
      "datasheet": "${datasheet_url}"
    },
    "i18n": {
      "fr": {
        "description": "Texas Instruments ${mpn}, l'amplificateur opérationnel double bipolaire à faible bruit ${device} en ${pkg} (${temp_fr}, jusqu'à ${vmax} V entre les alimentations) : gain en boucle ouverte de ${aol} V/mV, produit gain-bande de ${gbw_fr} MHz, vitesse de balayage de ${sr} V/us, décalage maximal de ${vos} mV, bruit de 5 nV/rtHz à 1 kHz, ${note_fr}. Les deux canaux sur le brochage double standard.",
        "fidelity": {
          "electrical": {
            "claims": "Deux amplificateurs opérationnels (opamp de SPEC-004) au gain grand signal typique de la fiche technique (100 V/mV), un pôle unique à sa bande passante à gain unité de 12 MHz et sa vitesse de balayage de 5 V/us ; cas de test sur +/-15 V pour un suiveur, la vitesse de balayage et la bande passante. L'excursion de sortie est fixée à 5 V de chaque rail, la borne que garantit le test de gain de la fiche technique (VO = +/-10 V sur 600 ohm sous +/-15 V) ; la révision actuelle ne donne plus d'excursion typique.",
            "omissions": [
              "l'excursion de sortie typique (les composants réels atteignent environ +/-13 V sous +/-15 V ; le modèle s'arrête à +/-10 V, la borne garantie)",
              "la tension de décalage d'entrée, le courant de polarisation (200 nA typique, 800 nA max) et le courant de décalage",
              "les diodes de protection entre les entrées",
              "les pôles suivants, la marge de phase et la stabilité sur charge capacitive",
              "le courant de court-circuit de sortie (38 mA)",
              "le bruit (5 nV/rtHz, 0,7 pA/rtHz)",
              "le courant d'alimentation (6 mA pour les deux canaux)",
              "la dépendance à la température",
              "la dispersion d'un exemplaire à l'autre"
            ]
          }
        }
      }
    }
