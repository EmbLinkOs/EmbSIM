{
  "schema_version": 1,
  "kind": "family",
  "name": "1N4001 to 1N4007 rectifiers",
  "datasheets": {
    "vishay-88503": {
      "title": "Vishay 1N4001 to 1N4007 datasheet (document 88503)",
      "url": "https://www.vishay.com/docs/88503/1n4001.pdf",
      "rev": "29 April 2020",
      "date": "2026-11-03",
      "hash": "sha256:56a77c6615c90c11993d37d94e67f335cf3a2d1fe00f25d2a1a4833834356d07",
      "notes": "Pages 1 and 2: VRRM and VDC per part, VF 1.1 V max at 1.0 A, IR 5.0 uA at VDC and 25 C, CJ 15 pF typical. DO-41, the band at the cathode; A2/K1 numbering is an ECAD convention."
    }
  },
  "evidence": [
    "1N4001, 1N4002, 1N4003, 1N4004, 1N4005, 1N4006, 1N4007",
    "PARAMETER SYMBOL 1N4001 1N4002 1N4003 1N4004 1N4005 1N4006 1N4007 UNIT",
    "Maximum repetitive peak reverse voltage VRRM (?:\\d+ ){#{col}}${vrrm} ",
    "Maximum DC blocking voltage VDC (?:\\d+ ){#{col}}${vrrm} ",
    "1\\.0 A VF 1\\.1 V",
    "TA = 25 °C 5\\.0 IR"
  ],
  "template": {
    "schema_version": 1,
    "kind": "component",
    "id": "emblink/${short}",
    "version": "1.0.0",
    "name": "${mpn}",
    "category": "diodes",
    "subcategory": "rectifiers",
    "description": "Vishay ${mpn}, a 1.0 A general-purpose rectifier in DO-41 blocking ${vrrm} V (VRRM, its DC blocking voltage). The forward curve is a fit (7 nA, n = 1.8, 42 mohm) giving 0.92 V at 1.0 A, under the datasheet's 1.1 V maximum; the reverse current at VRRM stays under its 5.0 uA. The seven parts of the family share one die and differ in their blocking voltage.",
    "keywords": [
      "Vishay",
      "${mpn}",
      "DO-41",
      "diode",
      "rectifier",
      "1N400x",
      "power supply",
      "freewheeling"
    ],
    "pins": [
      {
        "name": "A",
        "number": 2,
        "model": {
          "kind": "passive"
        },
        "doc": "Anode"
      },
      {
        "name": "K",
        "number": 1,
        "model": {
          "kind": "passive"
        },
        "doc": "Cathode"
      }
    ],
    "params": {
      "is": {
        "type": "number",
        "unit": "A",
        "default": "7n",
        "doc": "Saturation current",
        "min": "1e-20",
        "max": "1m",
        "advanced": true
      },
      "n": {
        "type": "number",
        "unit": "",
        "default": 1.8,
        "doc": "Emission coefficient",
        "min": 0.5,
        "max": 5,
        "advanced": true
      },
      "rs": {
        "type": "number",
        "unit": "ohm",
        "default": 0.042,
        "doc": "Series resistance",
        "min": 0,
        "advanced": true
      }
    },
    "model": {
      "primitive": "diode"
    },
    "symbol": {
      "svg": "symbol.svg",
      "width": 60,
      "height": 20,
      "pins": {
        "A": {
          "x": 0,
          "y": 10,
          "side": "left"
        },
        "K": {
          "x": 60,
          "y": 10,
          "side": "right"
        }
      }
    },
    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Shockley junction with series resistance fitted under the datasheet's maximum forward voltage (1.1 V at 1.0 A); blocking to VRRM with less than its 5.0 uA reverse current. DC and low-frequency fixtures from the datasheet's limits.",
        "omissions": [
          "avalanche breakdown above VRRM: the datasheet gives no breakdown voltage, so the model blocks at any reverse voltage",
          "the 15 pF junction capacitance",
          "reverse recovery",
          "temperature dependence (the 125 C leakage)",
          "surge ratings (IFSM, I2t) and damage",
          "the typical forward curve of the datasheet's figure 4: only the table's maximum is checked",
          "device-to-device spread",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
      "author": "EmbSIM",
      "license": "Apache-2.0",
      "sources": [
        {
          "title": "KiCad family/package reference, revision 4e17d759",
          "url": "https://github.com/KiCad/kicad-symbols/blob/4e17d7595f9691d45d97aea8ad64572652fb5bed/Diode.lib"
        }
      ]
    },
    "tests": [
      "tests/*.json"
    ],
    "part": {
      "manufacturer": "Vishay",
      "mpn": "${mpn}",
      "package": "DO-41",
      "datasheet": "${datasheet_url}"
    },
    "artwork": {
      "svg": "artwork.svg"
    },
    "i18n": {
      "fr": {
        "description": "Vishay ${mpn}, un redresseur d'usage général de 1,0 A en DO-41 bloquant ${vrrm} V (VRRM, sa tension de blocage continue). La courbe directe est un ajustement (7 nA, n = 1,8, 42 mohm) donnant 0,92 V à 1,0 A, sous le maximum de 1,1 V de la fiche technique ; le courant inverse à VRRM reste sous ses 5,0 uA. Les sept composants de la famille partagent une même puce et ne diffèrent que par leur tension de blocage.",
        "fidelity": {
          "electrical": {
            "claims": "Jonction de Shockley avec résistance série ajustée sous la tension directe maximale de la fiche technique (1,1 V à 1,0 A) ; blocage jusqu'à VRRM avec moins de ses 5,0 uA de courant inverse. Cas de test en continu et basse fréquence tirés des limites de la fiche technique.",
            "omissions": [
              "le claquage par avalanche au-delà de VRRM : la fiche technique ne donne pas de tension de claquage, le modèle bloque donc à toute tension inverse",
              "la capacité de jonction de 15 pF",
              "le recouvrement inverse",
              "la dépendance à la température (la fuite à 125 °C)",
              "les surintensités nominales (IFSM, I2t) et les dommages",
              "la courbe directe typique de la figure 4 de la fiche technique : seul le maximum du tableau est vérifié",
              "la dispersion d'un exemplaire à l'autre",
              "aucune qualification par un modèle du fabricant"
            ]
          }
        }
      }
    }
  },
  "tests": {
    "forward": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "forward",
      "description": "1.0 A forward: at most the datasheet's 1.1 V (VF, table 2)",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "I1",
            "component": "emblink/isource",
            "params": {
              "dc": 1.0
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VD": [
            "I1.-",
            "DUT.A"
          ],
          "GND": [
            "I1.+",
            "DUT.K",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VD": {
          "at": "50us",
          "min_v": 0.8,
          "max_v": 1.1
        }
      }
    },
    "reverse": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "reverse",
      "description": "VRRM across it through 100 kohm: under the datasheet's 5.0 uA (IR at 25 C), so under 0.5 V across the resistor",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "V1",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vrrm}"
            }
          },
          {
            "id": "R1",
            "component": "emblink/resistor",
            "params": {
              "resistance": "100k"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VIN": [
            "V1.+",
            "R1.1"
          ],
          "VK": [
            "R1.2",
            "DUT.K"
          ],
          "GND": [
            "V1.-",
            "DUT.A",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VK": {
          "at": "50us",
          "min_v": "${vk_min}",
          "max_v": "${vrrm}"
        }
      }
    }
  },
  "rows": [
