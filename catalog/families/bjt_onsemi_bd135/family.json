    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Ebers-Moll transistor at a constant gain of 100 (the geometric middle of the datasheet's 40 to 250 at 150 mA), collector and emitter resistances for VCE(sat) and VBE(on); fixtures for the gain at 5 mA, 150 mA and 500 mA, VCE(sat) and VBE(on) at 0.5 A.",
        "omissions": [
          "the gain's fall at low and high current: it stays 100",
          "the Early effect: the collector current does not rise with VCE",
          "capacitances and fT, so no switching times",
          "temperature: VBE's -2 mV/C and the gain's rise",
          "second breakdown, the safe operating area and damage past the ratings",
          "device-to-device spread within the gain limits",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
