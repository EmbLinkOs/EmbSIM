    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "The thyristor's two-transistor equivalent (a PNP of gain 0.5 and an NPN of gain 100 in a regenerative loop) with a 6.8 kohm gate-cathode shunt for the cathode's emitter shorts: it triggers at a gate current under the datasheet's 200 uA, latches and holds above a current under its 5 mA (with 1 kohm gate to cathode), drops under 1.7 V at 1.2 A, and blocks forward and reverse until its middle (or anode) junction breaks down. Fixtures for blocking at VDRM, triggering at the maximum IGT, no trigger at VGD, latching, dropping out below the holding current and VTM.",
        "omissions": [
          "the breakover voltage: set 25 % above the rated VDRM (${vbo} V); the datasheet gives only the rating",
          "dv/dt triggering and the junction capacitances, turn-on delay (3 us typical) and the turn-off time tq",
          "the gate's own reverse breakdown",
          "temperature: the gate trigger and holding currents double at -40 C",
          "the on-state voltage's curve beyond its 1.2 A point; surge and I2t ratings and damage",
          "device-to-device spread of IGT and IH",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
