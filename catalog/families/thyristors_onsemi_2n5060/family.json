  "tests": {
    "blocks": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "blocks",
      "description": "The rated ${vdrm} V across it through 100 ohm, 1 kohm gate to cathode and no gate current: it blocks, the leakage under the datasheet's 10 uA",
      "policy": "electrical",
      "until": "200us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VA",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": "${v_block}"
            }
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": 100,
              "tolerance": 0
            }
          },
          {
            "id": "RGK",
            "component": "emblink/resistor",
            "params": {
              "resistance": "1k",
              "tolerance": 0
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G0",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VCC": [
            "VA.+",
            "RL.1"
          ],
          "AN": [
            "RL.2",
            "DUT.A"
          ],
          "GATE": [
            "DUT.G",
            "RGK.1"
          ],
          "GND": [
            "VA.-",
            "RGK.2",
            "DUT.K",
            "G0.GND"
          ]
        }
      },
      "expect": {
        "net:AN": {
          "at": "100us",
          "min_v": "${v_block_lo}",
          "max_v": "${v_block}"
        }
      }
    },
