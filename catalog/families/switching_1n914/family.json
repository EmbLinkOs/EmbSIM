{
  "schema_version": 1,
  "kind": "family",
  "name": "onsemi 1N914, 1N916, 1N4148 and 1N4448 switching diodes",
  "datasheets": {
    "onsemi-1n914": {
      "title": "onsemi 1N91x, 1N4x48, FDLL914, FDLL4x48 datasheet (1N914/D)",
      "url": "https://www.onsemi.com/pdf/datasheet/1n914-d.pdf",
      "rev": "6, September 2024",
      "date": "2026-11-03",
      "hash": "sha256:af77f97304678948faca40198e6936a53433ce75fd81325cedeb805ae7cff4a8",
      "notes": "Pages 1 and 2: the parts and their DO-35 package, VRRM 100 V, VR at 100 uA and 5 uA, VF per grade, IR at 20 V and 75 V, CT per grade, trr. The text extraction prints the micro sign as m. A2/K1 numbering is an ECAD convention."
    }
  },
  "evidence": [
    "Small Signal Diode 1N91x, 1N4x48",
    "${mpn}\\S* [\\dA-Z]+ DO−204AH \\(DO−35\\)",
    "Maximum Repetitive Reverse Voltage VRRM 100 V",
    "VR Breakdown Voltage IR = 100 mA 100 V IR = 5\\.0 mA 75 V",
    "IR Reverse Leakage VR = 20 V 0\\.025 mA",
    "VR = 75 V 5\\.0 mA"
  ],
  "template": {
    "schema_version": 1,
    "kind": "component",
    "id": "emblink/${short}",
    "version": "1.0.0",
    "name": "${mpn}",
    "category": "diodes",
    "subcategory": "switching",
    "description": "onsemi ${mpn}, a small-signal fast switching diode in DO-35 (100 V VRRM, 200 mA average). ${grade} One fit serves the family (3.1 nA, n = 1.8, 0.5 ohm): 0.67 V at 5 mA, 0.70 V at 10 mA, 0.86 V at 100 mA; breakdown at the datasheet's minimum, 100 V at 100 uA.",
    "keywords": [
      "onsemi",
      "${mpn}",
      "DO-35",
      "diode",
      "switching",
      "signal",
      "1N914",
      "1N4148",
      "fast"
    ],
    "pins": [
      {
        "name": "A",
        "number": 2,
        "model": {
          "kind": "passive"
        },
        "doc": "Anode"
      },
      {
        "name": "K",
        "number": 1,
        "model": {
          "kind": "passive"
        },
        "doc": "Cathode"
      }
    ],
    "params": {
      "is": {
        "type": "number",
        "unit": "A",
        "default": "3.1n",
        "doc": "Saturation current",
        "min": "1e-20",
        "max": "1m",
        "advanced": true
      },
      "n": {
        "type": "number",
        "unit": "",
        "default": 1.8,
        "doc": "Emission coefficient",
        "min": 0.5,
        "max": 5,
        "advanced": true
      },
      "rs": {
        "type": "number",
        "unit": "ohm",
        "default": 0.5,
        "doc": "Series resistance",
        "min": 0,
        "advanced": true
      },
      "bv": {
        "type": "number",
        "unit": "V",
        "default": 100,
        "doc": "Reverse breakdown voltage",
        "min": 0.1,
        "max": 10000,
        "advanced": true
      },
      "ibv": {
        "type": "number",
        "unit": "A",
        "default": "100u",
        "doc": "Current at which the reverse voltage is bv",
        "min": "1n",
        "max": "0.1",
        "advanced": true
      }
    },
    "model": {
      "primitive": "diode"
    },
    "symbol": {
      "svg": "symbol.svg",
      "width": 60,
      "height": 20,
      "pins": {
        "A": {
          "x": 0,
          "y": 10,
          "side": "left"
        },
        "K": {
          "x": 60,
          "y": 10,
          "side": "right"
        }
      }
    },
    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Shockley junction with series resistance inside the datasheet's forward limits for the grade, leakage under 25 nA at 20 V and 5 uA at 75 V, breakdown at the 100 V minimum; DC and low-frequency fixtures from the datasheet's table.",
        "omissions": [
          "the ${ct} pF capacitance",
          "reverse recovery (4 ns trr)",
          "temperature dependence (the 150 C leakage)",
          "breakdown above its 100 V minimum: real parts break down higher",
          "surge ratings and damage",
          "device-to-device spread",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
      "author": "EmbSIM",
