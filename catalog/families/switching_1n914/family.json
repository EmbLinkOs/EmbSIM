    "artwork": {
      "svg": "artwork.svg"
    },
    "i18n": {
      "fr": {
        "description": "onsemi ${mpn}, une diode de commutation rapide petits signaux en DO-35 (100 V de VRRM, 200 mA en moyenne). ${grade_fr} Un même ajustement sert à la famille (3,1 nA, n = 1,8, 0,5 ohm) : 0,67 V à 5 mA, 0,70 V à 10 mA, 0,86 V à 100 mA ; claquage au minimum de la fiche technique, 100 V à 100 uA.",
        "fidelity": {
          "electrical": {
            "claims": "Jonction de Shockley avec résistance série dans les limites directes de la fiche technique pour la classe, fuite sous 25 nA à 20 V et 5 uA à 75 V, claquage au minimum de 100 V ; cas de test en continu et basse fréquence tirés du tableau de la fiche technique.",
            "omissions": [
              "la capacité de ${ct} pF",
              "le recouvrement inverse (trr de 4 ns)",
              "la dépendance à la température (la fuite à 150 °C)",
              "le claquage au-delà de son minimum de 100 V : les composants réels claquent plus haut",
              "les surintensités nominales et les dommages",
              "la dispersion d'un exemplaire à l'autre",
              "aucune qualification par un modèle du fabricant"
            ]
          }
        }
      }
    }
