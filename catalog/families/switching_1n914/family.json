  "tests": {
    "forward": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "forward",
      "description": "The grade's forward limit: at most 1.0 V at its test current",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "I1",
            "component": "emblink/isource",
            "params": {
              "dc": "${if_a}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VD": [
            "I1.-",
            "DUT.A"
          ],
          "GND": [
            "I1.+",
            "DUT.K",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VD": {
          "at": "50us",
          "min_v": 0.5,
          "max_v": 1.0
        }
      }
    },
    "forward_5ma": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "forward_5ma",
      "description": "The B grade's 5 mA window",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "I1",
            "component": "emblink/isource",
            "params": {
              "dc": "5m"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VD": [
            "I1.-",
            "DUT.A"
          ],
          "GND": [
            "I1.+",
            "DUT.K",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VD": {
          "at": "50us",
          "min_v": "${vf5_min}",
          "max_v": "${vf5_max}"
        }
      }
    },
    "forward_100ma": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "forward_100ma",
      "description": "100 mA: at most 1.0 V",
      "policy": "electrical",
