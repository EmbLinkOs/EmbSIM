          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          },
          {
            "id": "RF",
            "component": "emblink/resistor",
            "params": {
              "resistance": "10k",
              "tolerance": 0
            }
          },
          {
            "id": "RG",
            "component": "emblink/resistor",
            "params": {
              "resistance": "1k",
              "tolerance": 0
            }
          }
        ],
        "nets": {
          "IN": [
            "VI.+",
            "DUT.IN2+"
          ],
          "VCC": [
            "VS.+",
            "DUT.VCC"
          ],
          "GND": [
            "VI.-",
            "VS.-",
            "DUT.GND",
            "G.GND",
            "RG.2"
          ],
          "OUT": [
            "DUT.OUT2",
            "RF.1"
          ],
          "FB": [
            "DUT.IN2-",
            "RF.2",
            "RG.1"
          ]
        }
      },
      "expect": {
        "net:OUT": {
          "at": "${bw_at}",
          "min_v": "${bw_min}",
          "max_v": "${bw_max}"
        }
      }
    }
