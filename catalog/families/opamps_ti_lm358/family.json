  "tests": {
    "follower": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "follower",
      "description": "Channel 1 as a follower at 2.5 V on 5 V: its output 2.5 V (the gain's error is microvolts)",
      "policy": "electrical",
      "until": "40us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VI",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 2.5
            }
          },
          {
            "id": "VS",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 5
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "10k",
              "tolerance": 0
            }
          }
        ],
        "nets": {
          "IN": [
            "VI.+",
            "DUT.IN1+"
          ],
          "VCC": [
            "VS.+",
            "DUT.VCC"
          ],
          "GND": [
            "VI.-",
            "VS.-",
            "DUT.GND",
            "G.GND",
            "RL.2"
          ],
          "OUT": [
            "DUT.OUT1",
            "DUT.IN1-",
            "RL.1"
          ]
        }
      },
      "expect": {
        "net:OUT": {
          "at": "20us",
          "min_v": 2.49,
          "max_v": 2.51
        }
      }
    },
    "headroom": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "headroom",
      "description": "Channel 1 as a comparator driven high on 5 V: its output ${hh} V below the positive rail, the datasheet's typical swing",
      "policy": "electrical",
      "until": "40us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VI",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 2.6
            }
          },
          {
            "id": "VR",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 2.4
            }
          },
          {
            "id": "VS",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 5
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "10k",
              "tolerance": 0
            }
          }
        ],
        "nets": {
          "IN": [
            "VI.+",
            "DUT.IN1+"
          ],
          "REF": [
            "VR.+",
            "DUT.IN1-"
          ],
          "VCC": [
            "VS.+",
            "DUT.VCC"
          ],
          "GND": [
            "VI.-",
            "VR.-",
            "VS.-",
            "DUT.GND",
            "G.GND",
            "RL.2"
          ],
          "OUT": [
            "DUT.OUT1",
            "RL.1"
          ]
        }
      },
      "expect": {
        "net:OUT": {
          "at": "30us",
          "min_v": "${vtop_min}",
          "max_v": "${vtop_max}"
        }
      }
    },
    "slew": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "slew",
      "description": "Channel 2 as a follower given a 2 V step: the output slews at the datasheet's ${sr} V/us, ${slew_v} V a microsecond after the step",
      "policy": "electrical",
      "until": "40us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VI",
            "component": "emblink/vsource",
            "params": {
              "kind": "pulse",
              "v1": 1.0,
              "v2": 3.0,
              "td": "10u",
              "tr": "10n",
              "tf": "10n",
              "pw": "1m",
              "per": "2m"
            }
          },
          {
            "id": "VS",
            "component": "emblink/vsource",
            "params": {
              "kind": "dc",
              "dc": 5
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "10k",
              "tolerance": 0
            }
          }
        ],
        "nets": {
          "IN": [
            "VI.+",
            "DUT.IN2+"
          ],
          "VCC": [
            "VS.+",
            "DUT.VCC"
          ],
          "GND": [
            "VI.-",
            "VS.-",
            "DUT.GND",
            "G.GND",
            "RL.2"
          ],
          "OUT": [
            "DUT.OUT2",
            "DUT.IN2-",
            "RL.1"
          ]
        }
      },
      "expect": {
        "net:OUT": {
          "at": "11us",
          "min_v": "${slew_min}",
          "max_v": "${slew_max}"
        }
      }
    },
    "bandwidth": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "bandwidth",
      "description": "Channel 2 at a gain of 11 given a 10 mV step, too small to slew: one pole, its time constant 11 / (2 pi ${gbw} MHz), 63 % of the 110 mV step then",
      "policy": "electrical",
      "until": "40us",
      "settings": {
        "imperfections": "ideal"
      },
      "circuit": {
        "components": [
          {
            "id": "VI",
            "component": "emblink/vsource",
            "params": {
