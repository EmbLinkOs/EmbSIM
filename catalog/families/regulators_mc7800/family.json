{
  "schema_version": 1,
  "kind": "family",
  "name": "onsemi MC7800 positive voltage regulators",
  "datasheets": {
    "onsemi-mc7800": {
      "title": "onsemi MC7800, MC7800A, MC7800AE, NCV7800 datasheet (MC7800/D)",
      "url": "https://www.onsemi.com/pdf/datasheet/mc7800-d.pdf",
      "rev": "current at retrieval",
      "date": "2026-11-03",
      "hash": "sha256:fa96ab9014b7867a669ac337b77112d7fa5c58897b6242ae7149482870463095",
      "notes": "Pages 1 to 9: TO-220 pinout (1 input, 2 ground, 3 output; heatsink to pin 2), RthJA 65 C/W for TO-220; per voltage an electrical characteristics table for the B and C grades and one for the A grades: VO at 25 C, quiescent current, dropout 2.0 V typical at 1.0 A, output resistance, short-circuit current, peak output current 2.2 A; ordering codes."
    }
  },
  "evidence": [
    "MC7800, MC7800A, MC7800AE, NCV7800",
    "Pin 1\\. Input .{0,300}2\\. Ground .{0,300}3\\. Output",
    "Quiescent Current IB − ${iq} ",
    "Dropout Voltage \\(IO = 1\\.0 A, TJ = 25°C\\) Vi?I [−_] VO −? ?2\\.0",
    "Peak Output Current \\(TJ = 25°C\\) Imax − 2\\.2"
  ],
  "template": {
    "schema_version": 1,
    "kind": "component",
    "id": "emblink/${short}",
    "version": "1.0.0",
    "name": "${mpn}",
    "category": "analog_ics",
    "subcategory": "regulators",
    "description": "onsemi ${mpn}, a 1.0 A fixed ${vo_txt} V positive linear regulator in TO-220 (IN 1, GND 2, OUT 3; the tab is GND): ${vo_min} to ${vo_max} V at 25 C (${grade}), ${iq} mA typical quiescent current (${iq_max} mA maximum), 2.0 V typical dropout at 1.0 A, 2.2 A peak output current. The 78xx regulator of countless power supplies.",
    "keywords": [
      "onsemi",
      "${mpn}",
      "${order}",
      "MC78xx",
      "78${vcode}",
      "TO-220",
      "regulator",
      "linear",
      "fixed",
      "${vo_txt} V",
      "power supply"
    ],
    "pins": [
      {
        "name": "IN",
        "number": 1,
        "model": {
          "kind": "analog"
        },
        "doc": "Unregulated input"
      },
      {
        "name": "OUT",
        "number": 3,
        "model": {
          "kind": "power",
          "role": "supply",
          "nominal_v": "$vout"
        },
        "doc": "Regulated output"
      },
      {
        "name": "GND",
        "number": 2,
        "model": {
          "kind": "power",
          "role": "ground"
        },
        "aliases": [
          "ADJ"
        ],
        "doc": "Ground"
      }
    ],
    "params": {
      "vout": {
        "type": "number",
        "unit": "V",
        "default": "${vo}",
        "doc": "Regulated output voltage",
        "min": 0.5,
        "max": 50
      },
      "dropout": {
        "type": "number",
        "unit": "V",
        "default": 2.0,
        "doc": "Minimum input-output difference for regulation",
        "min": 0,
        "max": 5
      },
      "imax": {
        "type": "number",
        "unit": "A",
        "default": 2.2,
        "doc": "Current limit",
        "min": "1m",
        "max": 20
      },
      "quiescent": {
        "type": "number",
        "unit": "A",
        "default": "${iq_a}",
        "doc": "Ground pin current",
        "min": 0,
        "advanced": true
      }
    },
    "model": {
      "primitive": "regulator"
    },
    "symbol": {
      "svg": "symbol.svg",
      "width": 60,
      "height": 30,
      "pins": {
        "IN": {
          "x": 0,
          "y": 10,
          "side": "left"
        },
        "OUT": {
          "x": 60,
          "y": 10,
          "side": "right"
        },
        "GND": {
          "x": 30,
          "y": 30,
          "side": "bottom"
        }
      }
    },
    "fidelity": {
      "functional": null,
      "timed": null,
      "electrical": {
        "claims": "Fixed regulator at the table's typical output voltage (inside its 25 C minimum and maximum), dropping out below the typical 2.0 V input-output difference, limiting at the 2.2 A peak output current, its ground pin drawing the typical quiescent current. DC fixtures from the datasheet's table at its own test conditions.",
        "omissions": [
          "line and load regulation (the output does not move with input or load while regulating; the table allows tens of mV)",
          "the short-circuit current's fall at high input voltage (0.2 A at 35 V) and the safe-area compensation",
          "thermal shutdown and junction heating (TO-220: 65 C/W; the datasheet gives no shutdown temperature)",
          "ripple rejection, output noise and output resistance (${ro} mohm at 1 kHz)",
          "stability against the output capacitor and the start-up transient",
          "the temperature coefficient (-0.3 mV/C) and the output voltage over the full temperature and line range",
          "device-to-device spread within the grade",
          "no manufacturer model qualification"
        ],
        "validation": [
          "tests/*.json"
        ]
      }
    },
    "provenance": {
      "author": "EmbSIM",
      "license": "Apache-2.0",
      "sources": [
        {
          "title": "KiCad family/package reference, revision 4e17d759",
          "url": "https://github.com/KiCad/kicad-symbols/blob/4e17d7595f9691d45d97aea8ad64572652fb5bed/Regulator_Linear.lib"
        }
      ]
    },
    "tests": [
      "tests/*.json"
    ],
    "part": {
      "manufacturer": "onsemi",
      "mpn": "${mpn}",
      "package": "TO-220",
      "datasheet": "${datasheet_url}"
    },
    "artwork": {
      "svg": "artwork.svg"
    },
    "i18n": {
      "fr": {
        "description": "onsemi ${mpn}, un régulateur linéaire positif fixe de ${vo_txt_fr} V et 1,0 A en TO-220 (IN 1, GND 2, OUT 3 ; la languette est GND) : ${vo_min_fr} à ${vo_max_fr} V à 25 °C (${grade_fr}), ${iq_fr} mA de courant de repos typique (${iq_max_fr} mA au plus), 2,0 V de chute typique à 1,0 A, 2,2 A de courant de sortie crête. Le régulateur 78xx d'innombrables alimentations.",
        "fidelity": {
          "electrical": {
            "claims": "Régulateur fixe à la tension de sortie typique du tableau (entre son minimum et son maximum à 25 °C), décrochant sous la différence entrée-sortie typique de 2,0 V, limitant au courant de sortie crête de 2,2 A, sa broche de masse consommant le courant de repos typique. Cas de test en continu tirés du tableau de la fiche technique, à ses propres conditions de test.",
            "omissions": [
              "la régulation de ligne et de charge (la sortie ne bouge pas avec l'entrée ni la charge tant qu'elle régule ; le tableau admet des dizaines de mV)",
              "la baisse du courant de court-circuit à forte tension d'entrée (0,2 A à 35 V) et la compensation de zone de sécurité",
              "la coupure thermique et l'échauffement de la jonction (TO-220 : 65 °C/W ; la fiche technique ne donne pas de température de coupure)",
              "la réjection d'ondulation, le bruit de sortie et la résistance de sortie (${ro} mohm à 1 kHz)",
              "la stabilité selon le condensateur de sortie et le transitoire de démarrage",
              "le coefficient de température (-0,3 mV/°C) et la tension de sortie sur toute la plage de température et de ligne",
              "la dispersion d'un exemplaire à l'autre dans la classe",
              "aucune qualification par un modèle du fabricant"
            ]
          }
        }
      }
    }
  },
  "tests": {
    "regulation": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "regulation",
      "description": "The table's own conditions (Vin = ${vin} V, IO = 500 mA): VO inside its 25 C minimum and maximum",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "V1",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vin}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "${rl_500}"
            }
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VIN": [
            "V1.+",
            "DUT.IN"
          ],
          "VOUT": [
            "DUT.OUT",
            "RL.1"
          ],
          "GND": [
            "V1.-",
            "DUT.GND",
            "RL.2",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VOUT": {
          "at": "50us",
          "min_v": "${vo_min}",
          "max_v": "${vo_max}"
        }
      }
    },
    "full_load": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "full_load",
      "description": "1.0 A with the typical 2.0 V dropout plus 0.5 V of headroom: still regulating inside the 25 C limits",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "V1",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vin_hd}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "${rl_1a}"
            }
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VIN": [
            "V1.+",
            "DUT.IN"
          ],
          "VOUT": [
            "DUT.OUT",
            "RL.1"
          ],
          "GND": [
            "V1.-",
            "DUT.GND",
            "RL.2",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VOUT": {
          "at": "50us",
          "min_v": "${vo_min}",
          "max_v": "${vo_max}"
        }
      }
    },
    "dropout": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "dropout",
      "description": "1.0 V of headroom at 1.0 A, under the typical 2.0 V dropout: the output follows the input 2.0 V below",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "V1",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vin_do}"
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "${rl_1a}"
            }
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VIN": [
            "V1.+",
            "DUT.IN"
          ],
          "VOUT": [
            "DUT.OUT",
            "RL.1"
          ],
          "GND": [
            "V1.-",
            "DUT.GND",
            "RL.2",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VOUT": {
          "at": "50us",
          "min_v": "${vdo_min}",
          "max_v": "${vdo_max}"
        }
      }
    },
    "quiescent": {
      "schema_version": 1,
      "kind": "component_test",
      "name": "quiescent",
      "description": "Input through 100 ohm with a 10 kohm load: the drop is the load current plus the ground pin's, under the table's ${iq_max} mA maximum quiescent current",
      "policy": "electrical",
      "until": "100us",
      "circuit": {
        "components": [
          {
            "id": "V1",
            "component": "emblink/vsource",
            "params": {
              "dc": "${vin_q}"
            }
          },
          {
            "id": "RS",
            "component": "emblink/resistor",
            "params": {
              "resistance": 100
            }
          },
          {
            "id": "DUT",
            "component": "emblink/${short}"
          },
          {
            "id": "RL",
            "component": "emblink/resistor",
            "params": {
              "resistance": "10k"
            }
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "VS": [
            "V1.+",
            "RS.1"
          ],
          "VIN": [
            "RS.2",
            "DUT.IN"
          ],
          "VOUT": [
            "DUT.OUT",
            "RL.1"
          ],
          "GND": [
            "V1.-",
            "DUT.GND",
            "RL.2",
            "G.GND"
          ]
        }
      },
      "expect": {
        "net:VIN": {
          "at": "50us",
          "min_v": "${vq_min}",
          "max_v": "${vq_max}"
        }
      }
    }
  },
