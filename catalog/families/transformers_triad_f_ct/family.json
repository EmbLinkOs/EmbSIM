            "params": {
              "resistance": "${rl}",
              "tolerance": 0
            }
          },
          {
            "id": "G",
            "component": "emblink/gnd"
          }
        ],
        "nets": {
          "MAINS": [
            "V1.+",
            "DUT.P1"
          ],
          "SEC": [
            "DUT.S1",
            "RL.1"
          ],
          "GND": [
            "V1.-",
            "DUT.P2",
            "RL.2",
            "DUT.S2",
            "G.GND"
          ]
        }
      },
      "expect": {
