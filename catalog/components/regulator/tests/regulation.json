{
  "schema_version": 1,
  "kind": "component_test",
  "name": "regulation",
  "description": "5 V in, 3.3 V out into 100 Ω (33 mA).",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/regulator",
        "params": {
          "part": "LM1117-3.3"
        }
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.IN"
      ],
      "VOUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.GND",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VOUT": {
      "at": "0.5ms",
      "min_v": 3.2,
      "max_v": 3.4
    },
    "device:RL.i": {
      "at": "0.5ms",
      "min": 0.032,
      "max": 0.034
    }
  }
}
