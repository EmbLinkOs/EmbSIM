{
  "schema_version": 1,
  "kind": "component_test",
  "name": "reverse-current",
  "description": "Ammeter reversal changes sign while preserving insertion burden.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/ammeter"
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "SUPPLY": [
        "V.+",
        "DUT.-"
      ],
      "LOAD": [
        "DUT.+",
        "R.1"
      ],
      "GND": [
        "V.-",
        "R.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "device:DUT.current": {
      "at": "0.5ms",
      "min": -0.04950505049504951,
      "max": -0.049504850495049504
    },
    "device:DUT.voltage": {
      "at": "0.5ms",
      "min": -0.04951495049504951,
      "max": -0.049494950495049504
    }
  }
}
