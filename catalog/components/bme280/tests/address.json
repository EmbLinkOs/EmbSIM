        "PG2.OUT1",
        "DUT.SCK",
        "PU2.1"
      ],
      "CSB": [
        "DUT.CSB",
        "PU3.1"
      ],
      "SDO": [
        "DUT.SDO",
        "PU4.1"
      ]
    }
  },
  "inputs": [
    {
      "at": "0",
      "target": "DUT",
      "input": "temperature",
      "value": 21.37
    },
    {
      "at": "0",
      "target": "DUT",
      "input": "pressure",
      "value": 1009.82
    },
    {
      "at": "0",
      "target": "DUT",
      "input": "humidity",
      "value": 43.6
    }
