{
  "schema_version": 1,
  "kind": "component_test",
  "name": "forward_3a",
  "description": "3.1 A forward: at most the datasheet's maximum VF",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "I1",
        "component": "emblink/isource",
        "params": {
          "dc": 3.1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/diode_1n5818"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VD": [
        "I1.-",
        "DUT.A"
      ],
      "GND": [
        "I1.+",
        "DUT.K",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VD": {
      "at": "50us",
      "min_v": 0.3,
      "max_v": 0.875
    }
  }
}
