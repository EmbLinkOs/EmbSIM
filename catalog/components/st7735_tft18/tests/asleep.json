{
 "schema_version": 1,
 "kind": "component_test",
 "name": "asleep",
 "description": "After its reset the controller sleeps with its display off: the panel is blank (white) until SLPOUT and DISPON, whatever the memory holds.",
 "policy": "functional",
 "until": "20ms",
 "circuit": {
  "components": [
   {
    "id": "PG",
    "component": "emblink/pattern_generator",
    "params": {
     "pattern": "0,1,0,1,2,3,2,3,2,3,0,1,2,3,0,1,9,4,5,4,5,4,5,4,5,4,5,6,7,4,5,6,7,d",
     "period": 1e-07,
     "start": 0.006,
     "idle": 9
    }
   },
   {
    "id": "DUT",
    "component": "emblink/st7735_tft18"
   }
  ],
  "nets": {
   "SCK": [
    "PG.OUT0",
    "DUT.SCK"
   ],
   "SDA": [
    "PG.OUT1",
    "DUT.SDA"
   ],
   "DC": [
    "PG.OUT2",
    "DUT.DC"
   ],
   "CS": [
    "PG.OUT3",
    "DUT.CS"
   ]
  }
 },
 "expect": {
  "output:DUT.white_pixels": {
   "at": "19ms",
   "equals": 20480
  },
  "output:DUT.sleeping": {
   "at": "19ms",
   "equals": true
  },
  "output:DUT.colmod": {
   "at": "19ms",
   "equals": 5
  }
 }
}
