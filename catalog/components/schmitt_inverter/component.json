      "name": "A",
      "number": 1,
      "model": {
        "kind": "digital_in",
        "vih": 1.8,
        "vil": 1.0
      },
      "power_ref": "VCC"
    },
    {
      "name": "Y",
      "number": 2,
      "model": {
        "kind": "digital_out",
        "drive": "push_pull"
      },
      "power_ref": "VCC"
    },
    {
      "name": "VCC",
      "number": 14,
      "model": {
        "kind": "power",
        "role": "supply",
        "nominal_v": 3.3,
        "tolerance": 0.1
      },
      "required": false,
      "doc": "Supply (defaults to the family rail)"
    },
    {
      "name": "GND",
      "number": 7,
      "model": {
        "kind": "power",
        "role": "ground"
      },
      "required": false,
      "doc": "Ground"
    }
  ],
  "params": {},
  "model": {
    "primitive": "inverter"
  },
  "functional": {
    "primitive": "inverter"
  },
  "timed": {
    "tpd": "15ns"
  },
  "fidelity": {
    "functional": {
      "claims": "Y = not A, zero delay.",
      "omissions": [
        "delay"
      ]
    },
    "timed": {
      "claims": "Inertial propagation delay tpd.",
      "omissions": [
        "separate rise/fall delays"
      ]
    },
    "electrical": {
      "claims": "The input comparator bridge switches at the family's thresholds with the pin model's hysteresis (SPEC-004 §8).",
      "omissions": [
        "threshold spread over supply and temperature",
        "supply current"
      ],
      "range": {
        "voltage_v": [
          -0.3,
