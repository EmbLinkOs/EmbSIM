{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/schmitt_inverter",
  "version": "1.0.0",
  "name": "Schmitt-trigger inverter",
  "category": "logic",
  "description": "Inverter with hysteresis on its input (one gate of a 74HC14): slow or noisy edges give one clean output transition.",
  "keywords": [
    "logic",
    "inverter",
    "schmitt",
    "hysteresis",
    "74HC14"
  ],
  "family": "cmos_3v3",
  "pins": [
