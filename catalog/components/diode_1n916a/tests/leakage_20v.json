{
  "schema_version": 1,
  "kind": "component_test",
  "name": "leakage_20v",
  "description": "20 V through 1 Mohm: under 25 nA, so under 25 mV across the resistor",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 20
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1meg"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/diode_1n916a"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "VK": [
        "R1.2",
        "DUT.K"
      ],
      "GND": [
        "V1.-",
        "DUT.A",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VK": {
      "at": "50us",
      "min_v": 19.975,
      "max_v": 20
    }
  }
}
