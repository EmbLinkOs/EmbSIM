      "required": false
    }
  ],
  "params": {
    "pattern": {
      "type": "string",
      "default": "1,0",
      "doc": "Hexadecimal words (bit i drives OUTi), separated by commas or spaces"
    },
    "period": {
      "type": "number",
      "unit": "s",
      "default": "1u",
      "min": "1n",
      "max": 10,
      "doc": "Duration of each word"
    },
    "start": {
      "type": "number",
      "unit": "s",
      "default": 0,
      "min": 0,
      "max": 100,
      "doc": "When the first word is applied"
    },
    "idle": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 65535,
      "doc": "Word before the start (as a decimal number)"
    },
    "repeat": {
      "type": "boolean",
      "default": false,
      "doc": "Start again after the last word"
    },
    "drive": {
      "type": "enum",
      "enum": [
        "push_pull",
        "open_drain"
      ],
      "default": "push_pull",
      "doc": "Output stage"
    }
  },
  "outputs": [
    {
      "name": "step",
      "type": "integer",
      "doc": "Words played since reset"
    }
  ],
  "model": {
    "script": "model.lua",
    "api": 1
  },
  "fidelity": {
    "functional": {
      "claims": "Each word is applied at once on all outputs at its step time; open drain releases ones.",
      "omissions": [
        "output edge rates"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional; delays as stated.",
      "omissions": [
        "output edge rates"
      ]
    },
    "electrical": {
      "claims": "Pins bridge to analog nets with the family's pin-model defaults; the behaviour is the Lua model's.",
      "omissions": [
        "output edge rates",
        "supply current",
        "output current limits"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
  "provenance": {
    "author": "EmbSIM",
    "license": "Apache-2.0",
    "sources": [
