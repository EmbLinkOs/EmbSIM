  "id": "emblink/a4988",
  "version": "1.0.0",
  "name": "A4988 stepper driver",
  "category": "power",
  "description": "Microstepping bipolar stepper driver module (A4988 carrier): each STEP rising edge moves one full step or a 1/2, 1/4, 1/8 or 1/16 microstep set by MS1-MS3, in the direction of DIR, while enabled and awake; the shaft position and angle are outputs.",
  "keywords": [
    "stepper",
    "motor driver",
    "A4988",
    "microstepping",
    "step dir",
    "3d printer"
  ],
  "family": "cmos_3v3",
  "pins": [
    {
      "name": "ENABLE_N",
      "number": 1,
      "model": {
        "kind": "digital_in"
      },
      "doc": "Enable, active low",
      "power_ref": "VDD"
    },
    {
      "name": "MS1",
      "number": 2,
      "model": {
        "kind": "digital_in"
      },
      "power_ref": "VDD"
    },
    {
      "name": "MS2",
      "number": 3,
      "model": {
        "kind": "digital_in"
      },
      "power_ref": "VDD"
    },
    {
      "name": "MS3",
      "number": 4,
      "model": {
        "kind": "digital_in"
      },
      "power_ref": "VDD"
    },
    {
      "name": "RESET_N",
      "number": 5,
      "model": {
        "kind": "digital_in"
      },
      "doc": "Reset, active low",
      "power_ref": "VDD"
    },
    {
      "name": "SLEEP_N",
      "number": 6,
      "model": {
        "kind": "digital_in"
      },
      "doc": "Sleep, active low",
      "power_ref": "VDD"
    },
    {
      "name": "STEP",
      "number": 7,
      "model": {
        "kind": "digital_in"
      },
      "doc": "One microstep per rising edge",
      "power_ref": "VDD"
    },
    {
      "name": "DIR",
      "number": 8,
      "model": {
        "kind": "digital_in"
      },
      "doc": "Direction",
      "power_ref": "VDD"
    },
    {
      "name": "VMOT",
      "number": 9,
      "model": {
        "kind": "power",
        "role": "supply",
