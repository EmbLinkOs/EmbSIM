        "kind": "power",
        "role": "ground"
      },
      "required": false
    },
    {
      "name": "2B",
      "number": 11,
      "model": {
        "kind": "passive"
      },
      "required": false,
      "doc": "Coil output (not driven)"
    },
    {
      "name": "2A",
      "number": 12,
      "model": {
        "kind": "passive"
      },
      "required": false,
      "doc": "Coil output (not driven)"
    },
    {
      "name": "1A",
      "number": 13,
      "model": {
        "kind": "passive"
      },
      "required": false,
      "doc": "Coil output (not driven)"
    },
    {
      "name": "1B",
      "number": 14,
      "model": {
        "kind": "passive"
      },
      "required": false,
      "doc": "Coil output (not driven)"
    },
    {
      "name": "VDD",
      "number": 15,
      "model": {
        "kind": "power",
        "role": "supply",
        "nominal_v": 3.3,
        "tolerance": 0.1
      },
      "required": false,
      "doc": "Supply (defaults to the family rail)"
    },
    {
      "name": "GND",
      "number": 16,
      "model": {
        "kind": "power",
        "role": "ground"
      },
      "required": false,
      "doc": "Ground"
    }
  ],
  "params": {
    "steps_per_rev": {
      "type": "integer",
      "default": 200,
      "min": 4,
      "max": 10000,
      "doc": "Full steps per revolution of the motor"
    }
  },
  "outputs": [
    {
      "name": "position",
      "type": "number",
      "doc": "Full steps from the start (fractional with microstepping)"
    },
    {
      "name": "angle_deg",
      "type": "number",
      "unit": "deg"
    },
    {
      "name": "microsteps",
      "type": "integer"
    }
  ],
  "model": {
    "script": "model.lua",
    "api": 1
  },
  "fidelity": {
    "functional": {
      "claims": "STEP/DIR counting with the MS1-MS3 resolution table, ENABLE_N, RESET_N (home) and SLEEP_N; unconnected RESET_N and SLEEP_N count as inactive.",
      "omissions": [
        "coil currents and the motor (the coil pins are not driven)",
        "missed steps and acceleration limits",
        "current limiting and decay modes"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional; delays as stated.",
      "omissions": [
        "coil currents and the motor (the coil pins are not driven)",
        "missed steps and acceleration limits",
        "current limiting and decay modes"
      ]
    },
    "electrical": {
      "claims": "Pins bridge to analog nets with the family's pin-model defaults; the behaviour is the Lua model's.",
      "omissions": [
        "coil currents and the motor (the coil pins are not driven)",
        "missed steps and acceleration limits",
        "current limiting and decay modes",
        "supply current",
        "output current limits"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
