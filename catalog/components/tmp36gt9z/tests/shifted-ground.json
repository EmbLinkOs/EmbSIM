{
  "schema_version": 1,
  "kind": "component_test",
  "name": "shifted-ground",
  "policy": "electrical",
  "until": "200us",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 2.7
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tmp36gt9z"
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": "100k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "VREF",
        "component": "emblink/vsource",
        "params": {
          "dc": 1.2
        }
      }
    ],
    "nets": {
      "VCC": [
        "VS.+",
        "DUT.VS"
      ],
      "OUT": [
        "DUT.OUT",
        "R.1"
      ],
      "GND": [
        "VREF.-",
        "G.GND"
      ],
      "LOCAL_GND": [
        "VREF.+",
        "VS.-",
        "DUT.GND",
        "R.2"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "50us",
      "min_v": 1.2979999999999998,
      "max_v": 1.3019999999999998
    },
    "output:DUT.vout": {
      "at": "150us",
      "min_v": 0.09799999999999998,
      "max_v": 0.10199999999999998
    }
  },
  "inputs": [
    {
      "at": "10us",
      "target": "DUT",
      "input": "temperature",
      "value": -40
    }
  ],
  "description": "Nominal transfer at a manufacturer supply endpoint; no accuracy or supply rejection qualification."
}
