{
  "schema_version": 1,
  "kind": "component_test",
  "name": "vbe_sat",
  "description": "IC = 0.02 A with IB = 0.002 A: VBE(sat) within the datasheet's 0.5 to 0.9 V",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "IC",
        "component": "emblink/isource",
        "params": {
          "kind": "pulse",
          "v1": 0,
          "v2": -0.02,
          "td": "1u",
          "tr": "50u",
          "tf": "1u",
          "pw": "1",
          "per": "2"
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
        "params": {
          "kind": "pulse",
          "v1": 0,
          "v2": -0.002,
          "td": "1u",
          "tr": "50u",
          "tf": "1u",
          "pw": "1",
          "per": "2"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/mpsa92g"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "COLL": [
        "IC.-",
        "DUT.C"
      ],
      "BASE": [
        "IB.-",
        "DUT.B"
      ],
      "GND": [
        "IC.+",
        "IB.+",
        "DUT.E",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:BASE": {
      "at": "150us",
      "min_v": -0.9,
      "max_v": -0.5
    }
  }
}
