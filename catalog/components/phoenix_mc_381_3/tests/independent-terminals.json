{
  "schema_version": 1,
  "kind": "component_test",
  "name": "independent-terminals",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/phoenix_mc_381_3"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": 1000
        }
      }
    ],
    "nets": {
      "VCC": [
        "V.+",
        "DUT.1"
      ],
      "GND": [
        "V.-",
        "DUT.2",
        "G.GND",
        "R.2"
      ],
      "THIRD": [
        "DUT.3",
        "R.1"
      ]
    }
  },
  "expect": {
    "net:VCC": {
      "at": "500us",
      "min_v": 4.99,
      "max_v": 5.01
    },
    "net:GND": {
      "at": "500us",
      "min_v": -0.001,
      "max_v": 0.001
    }
  }
}
