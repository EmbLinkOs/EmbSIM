{
  "schema_version": 1,
  "kind": "component_test",
  "name": "on",
  "description": "EN at 3.3 V (an MCU's high), 5 V on IN and a 10 ohm load (0.5 A): OUT about 45 mV below IN (about 90 mOhm).",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 5.0
        }
      },
      {
        "id": "VE",
        "component": "emblink/vsource",
        "params": {
          "dc": 3.3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/stmps2151str"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 10.0
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "IN": [
        "VS.+",
        "DUT.IN"
      ],
      "EN": [
        "VE.+",
        "DUT.EN"
      ],
      "OUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "VS.-",
        "VE.-",
        "RL.2",
        "DUT.GND",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "1ms",
      "min_v": 4.93,
      "max_v": 4.99
    }
  }
}
