{
  "schema_version": 1,
  "kind": "component_test",
  "name": "loading-1meg",
  "description": "10 V through 1 M\u03a9: finite meter input creates a divider.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "dc": 10
        }
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1meg"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/voltmeter",
        "params": {
          "input_resistance": "1meg"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "SUPPLY": [
        "V.+",
        "R.1"
      ],
      "MEASURE": [
        "R.2",
        "DUT.+"
      ],
      "GND": [
        "V.-",
        "DUT.-",
        "G.GND"
      ]
    }
  },
  "expect": {
    "device:DUT.voltage": {
      "at": "0.5ms",
      "min": 4.9998,
      "max": 5.0002
    },
    "device:DUT.current": {
      "at": "0.5ms",
      "min": 4.999000000000001e-06,
      "max": 5.001e-06
    }
  }
}
