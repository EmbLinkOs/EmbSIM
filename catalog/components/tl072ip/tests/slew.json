{
  "schema_version": 1,
  "kind": "component_test",
  "name": "slew",
  "description": "Channel 2 as a follower given a -2 to +2 V step: the output slews at the datasheet's 20 V/us, through 0 V a tenth of a microsecond after the step",
  "policy": "electrical",
  "until": "12us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VI",
        "component": "emblink/vsource",
        "params": {
          "kind": "pulse",
          "v1": -2.0,
          "v2": 2.0,
          "td": "10u",
          "tr": "10n",
          "tf": "10n",
          "pw": "1m",
          "per": "2m"
        }
      },
      {
        "id": "VP",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 15
        }
      },
      {
        "id": "VN",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 15
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tl072ip"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": "10k",
          "tolerance": 0
        }
      }
    ],
    "nets": {
      "IN": [
        "VI.+",
        "DUT.2IN+"
      ],
      "GND": [
        "VI.-",
        "VP.-",
        "VN.+",
        "G.GND",
        "RL.2"
      ],
      "OUT": [
        "DUT.2OUT",
        "DUT.2IN-",
        "RL.1"
      ],
      "VP": [
        "VP.+",
        "DUT.VCC+"
      ],
      "VN": [
        "VN.-",
        "DUT.VCC-"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "10.105us",
      "min_v": -0.3,
      "max_v": 0.3
    }
  }
}
