{
  "schema_version": 1,
  "kind": "component_test",
  "name": "esr",
  "description": "1 V through 9 x ESR: the step across the ESR at once, 0.1 V, before the capacitance charges",
  "policy": "electrical",
  "until": "20000ns",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 1
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": 7.596,
          "tolerance": 0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/uvr1v221mpd"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "VC": [
        "R1.2",
        "DUT.+"
      ],
      "GND": [
        "V1.-",
        "DUT.-",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VC": {
      "at": "10000ns",
      "min_v": 0.10169,
      "max_v": 0.10798
    }
  }
}
