      "model": {
        "kind": "passive"
      }
    },
    {
      "name": "2",
      "number": 2,
      "model": {
        "kind": "passive"
      }
    }
  ],
  "params": {
    "inductance": {
      "type": "number",
      "unit": "H",
      "default": "1.5u",
      "min": "1n",
