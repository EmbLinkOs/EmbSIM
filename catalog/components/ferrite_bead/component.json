    "z100mhz": {
      "type": "number",
      "unit": "ohm",
      "default": 600,
      "min": 1,
      "max": 5000,
      "doc": "Impedance at 100 MHz (informative)",
      "advanced": true
    }
  },
  "model": {
    "primitive": "inductor",
    "bind": {
