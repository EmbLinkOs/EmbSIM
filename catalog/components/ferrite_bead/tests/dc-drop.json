{
  "schema_version": 1,
  "kind": "component_test",
  "name": "dc-drop",
  "description": "100 mA through 0.15 ohm: the load sees about 15 mV less than the supply.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/ferrite_bead"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 33
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.1"
      ],
      "OUT": [
        "DUT.2",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "0.5ms",
      "min_v": 3.28,
      "max_v": 3.295
    }
  }
}
