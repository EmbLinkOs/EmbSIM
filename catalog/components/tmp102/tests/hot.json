{
  "schema_version": 1,
  "kind": "component_test",
  "name": "hot",
  "description": "90 °C is above T(high) = 80 °C: ALERT pulls low; a temperature read runs on the bus.",
  "policy": "functional",
  "until": "188us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3,3,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/tmp102"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "ALERT": [
        "DUT.ALERT",
        "PU3.1"
      ]
    }
  },
  "expect": {
    "net:ALERT": {
      "at": "168us",
      "logic": "0"
    },
    "output:DUT.temperature": {
      "at": "168us",
      "equals": 90
    }
  },
  "inputs": [
    {
      "at": "0",
      "target": "DUT",
      "input": "temperature",
      "value": 90
    }
  ]
}
