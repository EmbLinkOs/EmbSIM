{
  "schema_version": 1,
  "kind": "component_test",
  "name": "ohms-law",
  "description": "3.3 V across 1 kΩ gives 3.3 mA.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.1"
      ],
      "GND": [
        "V1.-",
        "DUT.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "device:DUT.i": {
      "at": "0.5ms",
      "min": 0.00325,
      "max": 0.00335
    },
    "net:VIN": {
      "at": "0.5ms",
      "min_v": 3.29,
      "max_v": 3.31
    }
  }
}
