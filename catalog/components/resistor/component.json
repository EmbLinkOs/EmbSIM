    "tc2": {
      "type": "number",
      "unit": "1/K^2",
      "default": 0,
      "doc": "Second-order temperature coefficient",
      "advanced": true
    },
    "temp": {
      "type": "number",
      "unit": "degC",
      "default": 27,
      "doc": "Operating temperature",
      "min": -55,
      "max": 175,
      "advanced": true
    }
  },
  "model": {
    "primitive": "resistor",
    "bind": {
      "r": "resistance",
      "tc1": "tc1",
      "tc2": "tc2",
      "temp": "temp"
    }
  },
  "functional": {
    "primitive": "wire"
  },
  "symbol": {
    "svg": "symbol.svg",
    "width": 60,
    "height": 20,
    "pins": {
      "1": {
        "x": 0,
        "y": 10,
        "side": "left"
      },
      "2": {
        "x": 60,
        "y": 10,
        "side": "right"
      }
    }
  },
  "fidelity": {
