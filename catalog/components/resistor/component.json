      "name": "1",
      "number": 1,
      "model": {
        "kind": "passive"
      }
    },
    {
      "name": "2",
      "number": 2,
      "model": {
        "kind": "passive"
      }
    }
  ],
  "params": {
    "resistance": {
      "type": "number",
      "unit": "ohm",
      "default": "1k",
      "doc": "Resistance",
