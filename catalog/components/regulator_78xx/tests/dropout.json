{
  "schema_version": 1,
  "kind": "component_test",
  "name": "dropout",
  "description": "6 V in: a 7805 with 2 V dropout gives about 4 V.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 6
        }
      },
      {
        "id": "DUT",
        "component": "emblink/regulator_78xx",
        "params": {
          "part": "7805"
        }
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.IN"
      ],
      "VOUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.GND",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VOUT": {
      "at": "0.5ms",
      "min_v": 3.8,
      "max_v": 4.2
    }
  }
}
