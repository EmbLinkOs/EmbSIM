{
  "schema_version": 1,
  "kind": "component_test",
  "name": "on",
  "description": "ON low, 5 V on IN and a 10 ohm load (0.5 A): OUT about 35 mV below IN (about 70 mOhm).",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 5.0
        }
      },
      {
        "id": "VG",
        "component": "emblink/vsource",
        "params": {
          "dc": 0.0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/st890cdr"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 10.0
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "IN": [
        "VS.+",
        "DUT.IN"
      ],
      "ON": [
        "VG.+",
        "DUT.ON"
      ],
      "OUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "VS.-",
        "VG.-",
        "RL.2",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "1ms",
      "min_v": 4.95,
      "max_v": 4.99
    }
  }
}
