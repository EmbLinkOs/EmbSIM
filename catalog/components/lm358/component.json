    }
  },
  "model": {
    "composite": {
      "components": [
        {
          "id": "A1",
          "component": "emblink/opamp",
          "params": {
            "gain": "100k",
            "gbw": "700k",
            "vpos": "$vout_high",
            "vneg": "$vout_low",
            "slew": 0.3
