{
  "schema_version": 1,
  "kind": "component_test",
  "name": "two-steps",
  "description": "Turned two detents clockwise (bounce off): two quadrature cycles, CLK closing and opening twice (four edges), at 10 detents a second; count 2.",
  "policy": "functional",
  "until": "310ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/rotary_encoder",
        "params": {
          "bounce": 0
        }
      },
      {
        "id": "V",
        "component": "emblink/vcc"
      }
    ],
    "nets": {
      "A": [
        "DUT.CLK"
      ],
      "B": [
        "DUT.DT"
      ],
      "SW": [
        "DUT.SW"
      ],
      "VCC": [
        "V.VCC",
        "DUT.VCC"
      ]
    }
  },
  "inputs": [
    {
      "at": "1ms",
      "target": "DUT",
      "input": "position",
      "value": 2
    }
  ],
  "expect": {
    "net:A": {
      "between": [
        "0.5ms",
        "300ms"
      ],
      "edges": 4
    },
    "output:DUT.count": {
      "at": "300ms",
      "equals": 2
    }
  }
}
