{
  "schema_version": 1,
  "kind": "component_test",
  "name": "forward",
  "description": "3.3 V through 100 ohm: about 30 mA and a forward voltage near 0.25 V.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100
        }
      },
      {
        "id": "DUT",
        "component": "emblink/diode_schottky"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "VD": [
        "R1.2",
        "DUT.A"
      ],
      "GND": [
        "V1.-",
        "DUT.K",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VD": {
      "at": "0.5ms",
      "min_v": 0.18,
      "max_v": 0.32
    }
  }
}
