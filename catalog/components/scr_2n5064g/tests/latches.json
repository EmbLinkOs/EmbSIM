{
  "schema_version": 1,
  "kind": "component_test",
  "name": "latches",
  "description": "A 20 us gate pulse of 200 uA in the datasheet's trigger circuit, then the gate left open: 7 V through 100 ohm (about 55 mA, ten times the holding current) keeps it on",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VA",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 7
        }
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100,
          "tolerance": 0
        }
      },
      {
        "id": "IG",
        "component": "emblink/isource",
        "params": {
          "kind": "pulse",
          "v1": 0,
          "v2": 0.0002,
          "td": "10u",
          "tr": "100n",
          "tf": "100n",
          "pw": "20u",
          "per": "1"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/scr_2n5064g"
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VA.+",
        "RL.1"
      ],
      "AN": [
        "RL.2",
        "DUT.A"
      ],
      "GATE": [
        "IG.-",
        "DUT.G"
      ],
      "GND": [
        "VA.-",
        "IG.+",
        "DUT.K",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:AN": {
      "at": "150us",
      "min_v": 0.5,
      "max_v": 1.7
    }
  }
}
