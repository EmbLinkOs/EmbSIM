{
  "schema_version": 1,
  "kind": "component_test",
  "name": "blocks",
  "description": "The rated 200 V across it through 100 ohm, 1 kohm gate to cathode and no gate current: it blocks, the leakage under the datasheet's 10 uA",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VA",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 200
        }
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100,
          "tolerance": 0
        }
      },
      {
        "id": "RGK",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k",
          "tolerance": 0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/scr_2n5064g"
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VA.+",
        "RL.1"
      ],
      "AN": [
        "RL.2",
        "DUT.A"
      ],
      "GATE": [
        "DUT.G",
        "RGK.1"
      ],
      "GND": [
        "VA.-",
        "RGK.2",
        "DUT.K",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:AN": {
      "at": "100us",
      "min_v": 199.999,
      "max_v": 200
    }
  }
}
