{
  "schema_version": 1,
  "kind": "component_test",
  "name": "bandwidth",
  "description": "Channel 2 at a gain of 11 given a 10 mV step, too small to slew: one pole, its time constant 11 / (2 pi 0.7 MHz), 63 % of the 110 mV step then",
  "policy": "electrical",
  "until": "40us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VI",
        "component": "emblink/vsource",
        "params": {
          "kind": "pulse",
          "v1": 0.1,
          "v2": 0.11,
          "td": "10u",
          "tr": "10n",
          "tf": "10n",
          "pw": "1m",
          "per": "2m"
        }
      },
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/lm358dr"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "RF",
        "component": "emblink/resistor",
        "params": {
          "resistance": "10k",
          "tolerance": 0
        }
      },
      {
        "id": "RG",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k",
          "tolerance": 0
        }
      }
    ],
    "nets": {
      "IN": [
        "VI.+",
        "DUT.IN2+"
      ],
      "VCC": [
        "VS.+",
        "DUT.VCC"
      ],
      "GND": [
        "VI.-",
        "VS.-",
        "DUT.GND",
        "G.GND",
        "RG.2"
      ],
      "OUT": [
        "DUT.OUT2",
        "RF.1"
      ],
      "FB": [
        "DUT.IN2-",
        "RF.2",
        "RG.1"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "12.501us",
      "min_v": 1.1626,
      "max_v": 1.1765
    }
  }
}
