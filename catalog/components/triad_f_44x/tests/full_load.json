{
  "schema_version": 1,
  "kind": "component_test",
  "name": "full_load",
  "description": "115 V rms at 60 Hz on the primary, the rated current's load on the secondary: its peak at the fifth cycle's crest is sqrt(2) times the rated secondary voltage (within 5 %)",
  "policy": "electrical",
  "until": "75ms",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "sine",
          "vo": 0,
          "va": 162.63,
          "freq": 60
        }
      },
      {
        "id": "DUT",
        "component": "emblink/triad_f_44x"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 6.3,
          "tolerance": 0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "MAINS": [
        "V1.+",
        "DUT.P1"
      ],
      "SEC": [
        "DUT.S1",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.P2",
        "RL.2",
        "DUT.S2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:SEC": {
      "at": "70.833ms",
      "min_v": 16.9281,
      "max_v": 18.71
    }
  }
}
