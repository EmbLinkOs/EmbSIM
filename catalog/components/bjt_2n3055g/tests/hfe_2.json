{
  "schema_version": 1,
  "kind": "component_test",
  "name": "hfe_2",
  "description": "IC near 10 A at VCE = 4 V (the base fed 0.27027 A, the collector from 8 V through 0.4 ohm): the gain at least 5, the datasheet's hFE there",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 8.0
        }
      },
      {
        "id": "RC",
        "component": "emblink/resistor",
        "params": {
          "resistance": 0.4,
          "tolerance": 0
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
        "params": {
          "kind": "pulse",
          "v1": 0,
          "v2": 0.2702702702702703,
          "td": "1u",
          "tr": "50u",
          "tf": "1u",
          "pw": "1",
          "per": "2"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bjt_2n3055g"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VC.+",
        "RC.1"
      ],
      "COLL": [
        "RC.2",
        "DUT.C"
      ],
      "BASE": [
        "IB.-",
        "DUT.B"
      ],
      "GND": [
        "VC.-",
        "IB.+",
        "DUT.E",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:COLL": {
      "at": "150us",
      "min_v": 0.0,
      "max_v": 7.4595
    }
  }
}
