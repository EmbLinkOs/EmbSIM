{
  "schema_version": 1,
  "kind": "component_test",
  "name": "high-side-switch",
  "description": "Gate grounded with the source at 5 V turns the BS250 on (Vgs = -5 V, about 19 ohm in the linear region); the 220 ohm load sits near 4.6 V. At 3.3 V its 2.4 V threshold leaves too little overdrive to switch this load.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5
        }
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 220
        }
      },
      {
        "id": "DUT",
        "component": "emblink/pmos",
        "params": {
          "part": "BS250"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "V1.+",
        "DUT.S"
      ],
      "LOAD": [
        "DUT.D",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.G",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:LOAD": {
      "at": "0.5ms",
      "min_v": 4.4,
      "max_v": 5.0
    }
  }
}
