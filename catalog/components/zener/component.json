{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/zener",
  "version": "1.0.0",
  "name": "Zener diode",
  "category": "diodes",
  "subcategory": "zener",
  "description": "Zener/avalanche diode with breakdown voltage vz and dynamic resistance rz.",
  "keywords": [
    "zener",
    "diode",
    "regulator",
    "clamp"
  ],
  "pins": [
    {
      "name": "A",
      "number": 1,
      "model": {
        "kind": "passive"
      },
      "doc": "Anode"
    },
    {
      "name": "K",
      "number": 2,
      "model": {
        "kind": "passive"
      },
      "doc": "Cathode"
    }
  ],
  "params": {
    "vz": {
      "type": "number",
      "unit": "V",
      "default": 5.1,
      "doc": "Breakdown (Zener) voltage",
      "min": 1,
      "max": 200
    },
    "rz": {
      "type": "number",
      "unit": "ohm",
      "default": 5,
      "doc": "Dynamic resistance in breakdown",
      "min": 0.01,
      "max": 1000
    },
    "is": {
      "type": "number",
      "unit": "A",
      "default": "1e-14",
      "doc": "Forward saturation current",
      "min": "1e-20",
      "max": "1m",
      "advanced": true
    },
    "n": {
      "type": "number",
      "unit": "",
      "default": 1,
      "doc": "Forward emission coefficient",
      "min": 0.5,
      "max": 5,
      "advanced": true
    },
    "rs": {
      "type": "number",
      "unit": "ohm",
      "default": 0.5,
      "doc": "Forward series resistance",
      "min": 0,
      "advanced": true
    },
    "cj0": {
      "type": "number",
      "unit": "F",
      "default": 0,
      "doc": "Zero-bias junction capacitance",
      "min": 0,
      "max": "1u",
      "advanced": true
    },
    "vj": {
      "type": "number",
      "unit": "V",
      "default": 1,
      "doc": "Junction built-in potential",
      "min": 0.1,
      "max": 3,
      "advanced": true
    },
    "m": {
      "type": "number",
      "unit": "",
      "default": 0.5,
      "doc": "Junction grading coefficient",
      "min": 0.05,
      "max": 0.95,
      "advanced": true
    },
    "fc": {
      "type": "number",
      "unit": "",
      "default": 0.5,
      "doc": "Forward-bias depletion capacitance coefficient",
      "min": 0,
      "max": 0.95,
      "advanced": true
    },
    "tt": {
      "type": "number",
      "unit": "s",
      "default": 0,
      "doc": "Transit time (reverse-recovery charge per ampere)",
      "min": 0,
      "max": "1m",
      "advanced": true
    },
    "rbv": {
      "type": "number",
      "unit": "ohm",
      "default": 0,
      "doc": "Breakdown series resistance (the dynamic resistance past the knee)",
      "min": 0,
      "max": "1M",
      "advanced": true
    },
    "nbv": {
      "type": "number",
      "unit": "",
      "default": 0,
      "doc": "Breakdown emission coefficient (the knee's softness; 0: sharp)",
      "min": 0,
      "max": 1000,
      "advanced": true
    }
  },
  "model": {
    "primitive": "zener"
  },
  "functional": {
    "primitive": "wire"
  },
  "symbol": {
    "svg": "symbol.svg",
    "width": 60,
    "height": 20,
    "pins": {
      "A": {
        "x": 0,
        "y": 10,
        "side": "left"
      },
      "K": {
        "x": 60,
        "y": 10,
        "side": "right"
      }
    }
  },
  "fidelity": {
    "functional": {
      "claims": "A wire.",
      "omissions": [
        "clamping"
      ]
    },
    "timed": {
      "claims": "As electrical.",
      "omissions": []
    },
    "electrical": {
      "claims": "Forward Shockley diode plus reverse breakdown at vz: with rz alone a sharp knee and one series resistance shared by both directions; with rbv / nbv a breakdown path of its own whose knee is soft (nbv Vt / I) and whose dynamic resistance is rbv, the forward drop untouched; junction (cj0) and diffusion (tt) charge (SPEC-004 §7 zener).",
      "omissions": [
        "temperature coefficient of vz"
      ],
      "range": {
        "current_a": [
          -0.2,
          0.2
        ]
      },
      "validation": [
        "tests/*.json"
      ]
    }
  },
  "provenance": {
    "author": "EmbSIM",
    "license": "Apache-2.0",
    "sources": [
      {
        "title": "BZX55C5V1 Zener diode datasheet (Vishay)"
      }
    ]
  },
  "tests": [
    "tests/*.json"
  ],
  "i18n": {
    "fr": {
      "source": "09bc14d222c9",
      "description": "Diode zener/à avalanche avec tension de claquage vz et résistance dynamique rz.",
      "fidelity": {
        "functional": {
          "claims": "Un fil.",
          "omissions": [
            "l'écrêtage"
          ]
        },
        "timed": {
          "claims": "Comme en électrique."
        },
        "electrical": {
          "claims": "Diode de Shockley en direct plus claquage inverse à vz : avec rz seul, un coude franc et une résistance série commune aux deux sens ; avec rbv / nbv, un chemin de claquage propre dont le coude est doux (nbv Vt / I) et la résistance dynamique rbv, la chute directe inchangée ; charges de jonction (cj0) et de diffusion (tt) (SPEC-004 §7 zener).",
          "omissions": [
            "le coefficient de température de vz"
          ]
        }
      }
    }
  }
}
