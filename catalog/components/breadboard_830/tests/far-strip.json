{
  "schema_version": 1,
  "kind": "component_test",
  "name": "far-strip",
  "description": "The last strip on the bottom half works as the first: j63 reaches f63.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/breadboard_830"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "IN": [
        "V1.+",
        "DUT.j63"
      ],
      "OUT": [
        "DUT.f63",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "0.5ms",
      "min_v": 4.99,
      "max_v": 5.01
    }
  }
}
