{
  "schema_version": 1,
  "kind": "component_test",
  "name": "on-resistance",
  "description": "VGS = -4.5 V, 2 A drawn from the drain: about 0.12 V across it (60 mOhm typical, 70 maximum).",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 4.5
        }
      },
      {
        "id": "VG",
        "component": "emblink/vsource",
        "params": {
          "dc": 0.0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/fdn340p"
      },
      {
        "id": "I",
        "component": "emblink/isource",
        "params": {
          "dc": 2
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "S": [
        "VS.+",
        "DUT.S"
      ],
      "G": [
        "VG.+",
        "DUT.G"
      ],
      "D": [
        "DUT.D",
        "I.+"
      ],
      "GND": [
        "VS.-",
        "VG.-",
        "I.-",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:D": {
      "at": "1ms",
      "min_v": 4.36,
      "max_v": 4.39
    }
  }
}
