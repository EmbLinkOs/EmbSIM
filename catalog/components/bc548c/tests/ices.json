{
  "schema_version": 1,
  "kind": "component_test",
  "name": "ices",
  "description": "VCE = 35 V with VBE = 0: the collector current under the datasheet's 15 nA ICES",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "dc": 35
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bc548c"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VC.+",
        "DUT.C"
      ],
      "GND": [
        "VC.-",
        "DUT.B",
        "DUT.E",
        "G.GND"
      ]
    }
  },
  "expect": {
    "device:DUT.ic": {
      "at": "50us",
      "min": 0,
      "max": 1.5e-08
    }
  }
}
