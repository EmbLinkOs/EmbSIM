{
  "schema_version": 1,
  "kind": "component_test",
  "name": "start-clock",
  "description": "Writing 00h to the seconds register at 500 ms clears CH: the oscillator starts and the countdown chain with it, so the clock reads 00:00:01 at 1.6 s and 00:00:02 at 2.6 s, not before.",
  "policy": "functional",
  "until": "2700ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "500m"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/ds1307"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "SQW": [
        "DUT.SQW",
        "PU3.1"
      ]
    }
  },
  "expect": {
    "output:DUT.time": {
      "at": "1400ms",
      "equals": "2000-01-01 00:00:00"
    },
    "output:DUT.running": {
      "at": "600ms",
      "equals": true
    }
  }
}
