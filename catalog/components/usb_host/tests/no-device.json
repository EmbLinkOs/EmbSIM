{
  "schema_version": 1,
  "kind": "component_test",
  "name": "no-device",
  "description": "Nothing on the cable: VBUS is the port's 5 V less the cable's and its contacts' drop at the 100 ohm load's 50 mA (0.25 ohm: 4.9875 V); no device attaches, no port reset and no frames.",
  "policy": "electrical",
  "until": "300ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/usb_host"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100.0
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VBUS": [
        "DUT.VBUS",
        "RL.1"
      ],
      "GND": [
        "DUT.GND",
        "RL.2",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:VBUS": {
      "at": "250ms",
      "min_v": 4.985,
      "max_v": 4.99
    },
    "output:DUT.HOST.state": {
      "at": "290ms",
      "equals": "detached"
    },
    "output:DUT.HOST.frames": {
      "at": "290ms",
      "equals": 0
    },
    "output:DUT.HOST.resets": {
      "at": "290ms",
      "equals": 0
    },
    "output:DUT.HOST.plugged": {
      "at": "290ms",
      "equals": true
    }
  }
}
