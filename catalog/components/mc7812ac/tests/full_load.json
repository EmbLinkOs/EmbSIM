{
  "schema_version": 1,
  "kind": "component_test",
  "name": "full_load",
  "description": "1.0 A with the typical 2.0 V dropout plus 0.5 V of headroom: still regulating inside the 25 C limits",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 14.5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/mc7812ac"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 12.0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.IN"
      ],
      "VOUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.GND",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VOUT": {
      "at": "50us",
      "min_v": 11.75,
      "max_v": 12.25
    }
  }
}
