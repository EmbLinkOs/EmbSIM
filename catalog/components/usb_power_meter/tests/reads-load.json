{
  "schema_version": 1,
  "kind": "component_test",
  "name": "reads-load",
  "description": "A 50 ohm load on 5 V: 99.9 mA through its 50 mOhm, 4.995 V at its output, 0.499 W.",
  "policy": "electrical",
  "until": "600ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/usb_power_meter"
      },
      {
        "id": "HOST",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5.0
        }
      },
      {
        "id": "LOAD",
        "component": "emblink/resistor",
        "params": {
          "resistance": 50
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "HV": [
        "HOST.+",
        "DUT.IN"
      ],
      "OUT": [
        "DUT.OUT",
        "LOAD.1"
      ],
      "GND": [
        "HOST.-",
        "G.GND",
        "DUT.GND",
        "LOAD.2"
      ]
    }
  },
  "expect": {
    "output:DUT.current": {
      "at": "600ms",
      "min": 0.0998,
      "max": 0.1
    },
    "output:DUT.voltage": {
      "at": "600ms",
      "min": 4.994,
      "max": 4.996
    },
    "output:DUT.power": {
      "at": "600ms",
      "min": 0.498,
      "max": 0.5
    },
    "output:DUT.on": {
      "at": "600ms",
      "equals": true
    }
  }
}
