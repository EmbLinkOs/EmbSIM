{
  "schema_version": 1,
  "kind": "component_test",
  "name": "dark",
  "description": "At 3 V it is dark and shows nothing.",
  "policy": "electrical",
  "until": "600ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/usb_power_meter"
      },
      {
        "id": "HOST",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.0
        }
      },
      {
        "id": "LOAD",
        "component": "emblink/resistor",
        "params": {
          "resistance": 50
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "HV": [
        "HOST.+",
        "DUT.IN"
      ],
      "OUT": [
        "DUT.OUT",
        "LOAD.1"
      ],
      "GND": [
        "HOST.-",
        "G.GND",
        "DUT.GND",
        "LOAD.2"
      ]
    }
  },
  "expect": {
    "output:DUT.on": {
      "at": "600ms",
      "equals": false
    },
    "output:DUT.current": {
      "at": "600ms",
      "equals": 0
    }
  }
}
