{
  "schema_version": 1,
  "kind": "component_test",
  "name": "dropout",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 6
        }
      },
      {
        "id": "DUT",
        "component": "emblink/l7805cv"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.IN"
      ],
      "VOUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.GND",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VOUT": {
      "at": "50us",
      "min_v": 3.85,
      "max_v": 4.3
    }
  }
}
