{
  "schema_version": 1,
  "kind": "component_test",
  "name": "replaced",
  "description": "12 V through 33 ohm (0.3 A) burns the LED out within milliseconds; the supply is then turned down to 2.5 V (18 mA) and the LED replaced (its replace input): the new one lights.",
  "policy": "electrical",
  "until": "100ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/led"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "SUP",
        "component": "emblink/vsource",
        "params": {
          "kind": "pwl",
          "points": [
            [
              0,
              12
            ],
            [
              0.02,
              12
            ],
            [
              0.025,
              2.5
            ],
            [
              1,
              2.5
            ]
          ]
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": 33,
          "tolerance": 0
        }
      }
    ],
    "nets": {
      "P": [
        "SUP.+",
        "R1.1"
      ],
      "A": [
        "R1.2",
        "DUT.A"
      ],
      "GND": [
        "DUT.K",
        "SUP.-",
        "G.GND"
      ]
    }
  },
  "expect": {
    "output:DUT.damaged": {
      "at": "100ms",
      "equals": false
    },
    "output:DUT.current": {
      "at": "100ms",
      "min": 0.01,
      "max": 0.03
    }
  },
  "inputs": [
    {
      "at": "30ms",
      "target": "DUT",
      "input": "replace",
      "value": true
    }
  ]
}