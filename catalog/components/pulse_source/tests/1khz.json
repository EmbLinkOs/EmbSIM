{
  "schema_version": 1,
  "kind": "component_test",
  "name": "1khz",
  "description": "pw 500 us and per 1 ms give a 1 kHz square wave.",
  "policy": "electrical",
  "until": "10ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/pulse_source",
        "params": {
          "v1": 0,
          "v2": 3.3,
          "pw": "500u",
          "per": "1m"
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "OUT": [
        "DUT.+",
        "R1.1"
      ],
      "GND": [
        "DUT.-",
        "R1.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "between": [
        "0",
        "10ms"
      ],
      "frequency_hz": 1000,
      "tolerance": 0.01
    }
  }
}
