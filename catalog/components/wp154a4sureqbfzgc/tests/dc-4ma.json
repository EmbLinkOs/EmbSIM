{
  "schema_version": 1,
  "kind": "component_test",
  "name": "wp154a4sureqbfzgc-dc-4ma",
  "description": "Source current forces independently extracted terminal-voltage bounds. Holdout samples were not used for coefficient fitting.",
  "policy": "electrical",
  "until": "1us",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/wp154a4sureqbfzgc"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "IR",
        "component": "emblink/isource",
        "params": {
          "dc": 0.004
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
        "params": {
          "dc": 0.004
        }
      },
      {
        "id": "IG",
        "component": "emblink/isource",
        "params": {
          "dc": 0.004
        }
      }
    ],
    "nets": {
      "GND": [
        "G.GND",
        "DUT.COM",
        "IR.+",
        "IB.+",
        "IG.+"
      ],
      "DR": [
        "IR.-",
        "DUT.R"
      ],
      "DB": [
        "IB.-",
        "DUT.B"
      ],
      "DG": [
        "IG.-",
        "DUT.G"
      ]
    }
  },
  "expect": {
    "net:DR": {
      "at": "500ns",
      "min_v": 1.741528,
      "max_v": 1.861528
    },
    "output:DUT.red_current": {
      "at": "500ns",
      "min": 0.003996,
      "max": 0.004004
    },
    "net:DB": {
      "at": "500ns",
      "min_v": 2.697937,
      "max_v": 2.817937
    },
    "output:DUT.blue_current": {
      "at": "500ns",
      "min": 0.003996,
      "max": 0.004004
    },
    "net:DG": {
      "at": "500ns",
      "min_v": 2.727571,
      "max_v": 2.847571
    },
    "output:DUT.green_current": {
      "at": "500ns",
      "min": 0.003996,
      "max": 0.004004
    },
    "output:DUT.lit": {
      "at": "500ns",
      "equals": true
    }
  }
