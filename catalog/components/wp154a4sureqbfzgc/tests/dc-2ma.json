{
  "schema_version": 1,
  "kind": "component_test",
  "name": "wp154a4sureqbfzgc-dc-2ma",
  "description": "Source current forces independently extracted terminal-voltage bounds. Holdout samples were not used for coefficient fitting.",
  "policy": "electrical",
  "until": "1us",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/wp154a4sureqbfzgc"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "IR",
        "component": "emblink/isource",
        "params": {
          "dc": 0.002
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
        "params": {
          "dc": 0.002
        }
      },
      {
        "id": "IG",
        "component": "emblink/isource",
        "params": {
          "dc": 0.002
        }
      }
    ],
    "nets": {
      "GND": [
        "G.GND",
        "DUT.COM",
        "IR.+",
        "IB.+",
        "IG.+"
      ],
      "DR": [
        "IR.-",
        "DUT.R"
      ],
      "DB": [
        "IB.-",
        "DUT.B"
      ],
      "DG": [
        "IG.-",
        "DUT.G"
      ]
    }
  },
  "expect": {
    "net:DR": {
      "at": "500ns",
      "min_v": 1.701368,
      "max_v": 1.821368
    },
    "output:DUT.red_current": {
      "at": "500ns",
      "min": 0.001998,
      "max": 0.002002
    },
    "net:DB": {
      "at": "500ns",
      "min_v": 2.598662,
      "max_v": 2.718662
    },
    "output:DUT.blue_current": {
      "at": "500ns",
      "min": 0.001998,
      "max": 0.002002
    },
    "net:DG": {
      "at": "500ns",
      "min_v": 2.601819,
      "max_v": 2.721819
    },
    "output:DUT.green_current": {
      "at": "500ns",
      "min": 0.001998,
      "max": 0.002002
    },
    "output:DUT.lit": {
      "at": "500ns",
      "equals": true
    }
  }
}
