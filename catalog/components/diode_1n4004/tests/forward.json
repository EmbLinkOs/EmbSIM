{
  "schema_version": 1,
  "kind": "component_test",
  "name": "forward",
  "description": "1.0 A forward: at most the datasheet's 1.1 V (VF, table 2)",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "I1",
        "component": "emblink/isource",
        "params": {
          "dc": 1.0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/diode_1n4004"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VD": [
        "I1.-",
        "DUT.A"
      ],
      "GND": [
        "I1.+",
        "DUT.K",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VD": {
      "at": "50us",
      "min_v": 0.8,
      "max_v": 1.1
    }
  }
}
