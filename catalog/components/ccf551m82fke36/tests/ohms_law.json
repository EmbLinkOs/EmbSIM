{
  "schema_version": 1,
  "kind": "component_test",
  "name": "ohms_law",
  "description": "1 V across it: the nominal resistance's current, read across a 1 ohm sense resistor in series (an ideal part: imperfections off)",
  "policy": "electrical",
  "until": "10us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 1.0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/ccf551m82fke36"
      },
      {
        "id": "RS",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1.82M",
          "tolerance": 0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.1"
      ],
      "VS": [
        "DUT.2",
        "RS.1"
      ],
      "GND": [
        "V1.-",
        "RS.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VS": {
      "at": "5us",
      "min_v": 0.4995,
      "max_v": 0.5005
    }
  }
}
