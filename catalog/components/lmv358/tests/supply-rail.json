{
  "schema_version": 1,
  "kind": "component_test",
  "name": "supply-rail",
  "description": "The output follows its supply: at 3.3 V, high is about 3.3 V, not 5 V.",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VCC",
        "component": "emblink/vsource",
        "params": {
          "dc": 3.3
        }
      },
      {
        "id": "VP",
        "component": "emblink/vsource",
        "params": {
          "dc": 2.0
        }
      },
      {
        "id": "VN",
        "component": "emblink/vsource",
        "params": {
          "dc": 1.0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/lmv358"
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VCC.+",
        "DUT.VCC"
      ],
      "P": [
        "VP.+",
        "DUT.1IN+"
      ],
      "N": [
        "VN.+",
        "DUT.1IN-"
      ],
      "O": [
        "DUT.1OUT"
      ],
      "GND": [
        "VCC.-",
        "VP.-",
        "VN.-",
        "DUT.GND",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:O": {
      "at": "1ms",
      "min_v": 3.2,
      "max_v": 3.3
    }
  }
}
