{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/opamp",
  "version": "1.0.0",
  "name": "Operational amplifier",
  "category": "analog",
  "description": "Behavioural op-amp with open-loop gain, a dominant pole, slew rate and output saturation at the supplies.",
  "keywords": [
    "opamp",
    "amplifier",
    "analog"
  ],
  "pins": [
    {
      "name": "+",
      "number": 1,
      "model": {
        "kind": "analog"
      },
      "doc": "Non-inverting input"
    },
    {
      "name": "-",
      "number": 2,
      "model": {
        "kind": "analog"
      },
      "doc": "Inverting input"
    },
    {
      "name": "OUT",
      "number": 3,
      "model": {
        "kind": "analog"
      },
      "doc": "Output"
    },
    {
      "name": "V+",
      "number": 4,
      "model": {
        "kind": "analog"
      },
      "required": false,
      "doc": "Positive supply; vpos when unconnected"
    },
    {
      "name": "V-",
      "number": 5,
      "model": {
        "kind": "analog"
      },
      "required": false,
      "doc": "Negative supply; vneg when unconnected"
    }
  ],
  "params": {
    "gain": {
      "type": "number",
      "unit": "",
      "default": "100k",
      "doc": "Open-loop DC gain",
      "min": 1,
      "max": "1e9"
    },
    "gbw": {
      "type": "number",
      "unit": "Hz",
      "default": "1meg",
      "doc": "Gain-bandwidth product: the dominant pole at gbw/gain (0 = no pole, the output follows the input at once)",
      "min": 0,
      "advanced": true
    },
    "slew": {
      "type": "number",
      "unit": "V/us",
      "default": 0,
      "doc": "Slew rate: how fast the output can move for a large input step (0 = only the pole limits it)",
      "min": 0,
      "advanced": true
    },
    "vpos": {
      "type": "number",
      "unit": "V",
      "default": 5,
      "doc": "Positive saturation when V+ is unconnected",
      "min": -100,
      "max": 100
    },
    "vneg": {
      "type": "number",
      "unit": "V",
      "default": 0,
      "doc": "Negative saturation when V- is unconnected",
      "min": -100,
      "max": 100
    },
    "rout": {
      "type": "number",
      "unit": "ohm",
      "default": 0,
      "doc": "Output resistance",
      "min": 0,
      "advanced": true
    },
    "rin": {
      "type": "number",
      "unit": "ohm",
      "default": "1T",
      "doc": "Differential input resistance",
      "min": 1,
      "advanced": true
    },
    "headroom_high": {
      "type": "number",
      "unit": "V",
      "default": 0,
      "min": 0,
      "advanced": true,
      "doc": "DC output margin below positive supply."
    },
    "headroom_low": {
      "type": "number",
      "unit": "V",
      "default": 0,
      "min": 0,
      "advanced": true,
      "doc": "DC output margin above negative supply."
    }
  },
  "model": {
    "primitive": "opamp"
  },
  "symbol": {
    "svg": "symbol.svg",
    "width": 60,
    "height": 40,
    "pins": {
      "+": {
        "x": 0,
        "y": 10,
        "side": "left"
      },
      "-": {
        "x": 0,
        "y": 30,
        "side": "left"
      },
      "OUT": {
        "x": 60,
        "y": 20,
        "side": "right"
      },
      "V+": {
        "x": 30,
        "y": 0,
        "side": "top"
      },
      "V-": {
        "x": 30,
        "y": 40,
        "side": "bottom"
      }
    }
  },
  "fidelity": {
    "functional": null,
    "timed": {
      "claims": "As electrical.",
      "omissions": []
    },
    "electrical": {
      "claims": "Vout = gain*(V+ - V-) saturating at the supply pins or vpos/vneg, a single dominant pole at gbw/gain with the slew rate `slew` for large steps and recovery from saturation within tens of nanoseconds, rout and rin (SPEC-004 §7 opamp).",
      "omissions": [
        "input offset",
        "bias current",
        "CMRR",
        "noise",
        "rail-to-rail limits",
        "further poles and phase margin"
      ],
      "range": {
        "voltage_v": [
          -100,
          100
        ]
      },
      "validation": [
        "tests/*.json"
      ]
    }
  },
  "provenance": {
    "author": "EmbSIM",
    "license": "Apache-2.0",
    "sources": [
      {
        "title": "LM358 Low-Power Dual Operational Amplifiers datasheet (Texas Instruments)"
      }
    ]
  },
  "tests": [
    "tests/*.json"
  ]
}
