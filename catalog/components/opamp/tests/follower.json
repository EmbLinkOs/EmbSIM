{
  "schema_version": 1,
  "kind": "component_test",
  "name": "follower",
  "description": "Unity-gain follower reproduces 1 V.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/opamp",
        "params": {
          "vpos": 5,
          "vneg": 0
        }
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": "10k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "IN": [
        "V1.+",
        "DUT.+"
      ],
      "OUT": [
        "DUT.OUT",
        "DUT.-",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "0.5ms",
      "min_v": 0.99,
      "max_v": 1.01
    }
  }
}
