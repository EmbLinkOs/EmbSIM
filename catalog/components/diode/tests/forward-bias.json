{
  "schema_version": 1,
  "kind": "component_test",
  "name": "forward-bias",
  "description": "About 0.65 V across the diode and 2.65 mA through 1 kΩ from 3.3 V.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/diode"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "VD": [
        "R1.2",
        "DUT.A"
      ],
      "GND": [
        "V1.-",
        "DUT.K",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VD": {
      "at": "0.5ms",
      "min_v": 0.55,
      "max_v": 0.8
    },
    "device:DUT.i": {
      "at": "0.5ms",
      "min": 0.0024,
      "max": 0.0029
    }
  }
}
