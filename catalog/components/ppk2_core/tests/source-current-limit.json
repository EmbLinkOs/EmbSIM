{
  "schema_version": 1,
  "kind": "component_test",
  "name": "source-current-limit",
  "description": "Source meter at 3.3 V into 1 ohm: it would be 3.3 A, so the source holds its 600 mA limit and VOUT falls to 0.6 V.",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/ppk2_core",
        "params": {
          "mode": "source",
          "voltage": 3.3
        }
      },
      {
        "id": "LOAD",
        "component": "emblink/resistor",
        "params": {
          "resistance": 1
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "OUT": [
        "DUT.VOUT",
        "LOAD.1"
      ],
      "GND": [
        "DUT.GND",
        "LOAD.2",
        "G.GND"
      ]
    }
  },
  "inputs": [
    {
      "at": "0s",
      "target": "DUT",
      "input": "run",
      "value": true
    }
  ],
  "expect": {
    "output:DUT.current": {
      "at": "2ms",
      "min": 0.5999,
      "max": 0.6001
    },
    "output:DUT.limited": {
      "at": "2ms",
      "equals": true
    },
    "output:DUT.vout": {
      "at": "2ms",
      "min": 0.599,
      "max": 0.601
    }
  }
}
