{
  "schema_version": 1,
  "kind": "component_test",
  "name": "reverse",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 3.3
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/diode_1n4148"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "VD": [
        "R1.2",
        "DUT.K"
      ],
      "GND": [
        "V1.-",
        "DUT.A",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VD": {
      "at": "50us",
      "min_v": 3.25,
      "max_v": 3.31
    }
  }
}
