{
  "schema_version": 1,
  "kind": "component_test",
  "name": "a1b1",
  "description": "A=1, B=1 gives Y=0.",
  "policy": "functional",
  "until": "1us",
  "circuit": {
    "components": [
      {
        "id": "HA",
        "component": "emblink/logic_level",
        "params": {
          "level": 1
        }
      },
      {
        "id": "HB",
        "component": "emblink/logic_level",
        "params": {
          "level": 1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/nand2"
      },
      {
        "id": "P",
        "component": "emblink/logic_probe"
      }
    ],
    "nets": {
      "A": [
        "HA.OUT",
        "DUT.A"
      ],
      "B": [
        "HB.OUT",
        "DUT.B"
      ],
      "Y": [
        "DUT.Y",
        "P.IN"
      ]
    }
  },
  "expect": {
    "net:Y": {
      "at": "500ns",
      "logic": "0"
    }
  }
}
