      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VC.+",
        "RC.1"
      ],
      "COLL": [
        "RC.2",
        "DUT.C"
      ],
      "BASE": [
        "IB.-",
        "DUT.B"
      ],
      "GND": [
        "VC.-",
        "IB.+",
        "DUT.E",
        "G.GND"
      ]
