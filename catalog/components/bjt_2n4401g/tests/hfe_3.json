          "kind": "pulse",
          "v1": 0,
          "v2": 0.0008670520231213873,
          "td": "1u",
          "tr": "50u",
          "tf": "1u",
          "pw": "1",
          "per": "2"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bjt_2n4401g"
