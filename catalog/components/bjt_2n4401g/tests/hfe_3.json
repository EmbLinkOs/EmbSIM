{
  "schema_version": 1,
  "kind": "component_test",
  "name": "hfe_3",
  "description": "IC near 0.15 A at VCE = 1 V (the base fed 0.000867052 A, the collector from 2 V through 6.66667 ohm): the gain 100 to 300, the datasheet's hFE there",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 2.0
        }
      },
      {
        "id": "RC",
        "component": "emblink/resistor",
        "params": {
          "resistance": 6.666667,
          "tolerance": 0
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
