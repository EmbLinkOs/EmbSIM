{
  "schema_version": 1,
  "kind": "component_test",
  "name": "normal-triggers",
  "description": "A 1 kHz clock on channel 1, Normal sweep at 100 us/div, the edge trigger rising at 1.5 V: each rising edge more than a screen after the last triggers an acquisition; by 10 ms several, the status T'D.",
  "policy": "electrical",
  "until": "10ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/rigol_ds1054z",
        "params": {
          "timebase": "100u",
          "trig_level": 1.5,
          "sweep": "normal"
        }
      },
      {
        "id": "CLK",
        "component": "emblink/clock_source",
        "params": {
          "freq": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "C": [
        "CLK.OUT",
        "DUT.CH1"
      ],
      "GND": [
        "G.GND",
        "DUT.GND"
      ]
    }
  },
  "expect": {
    "output:DUT.acquisitions": {
      "at": "10ms",
      "min": 5,
      "max": 10
    },
    "output:DUT.status": {
      "at": "10ms",
      "equals": "T'D"
    }
  }
}
