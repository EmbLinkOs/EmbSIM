{
  "schema_version": 1,
  "kind": "component_test",
  "name": "rate-one-channel-memory",
  "description": "One channel on at 10 ms/div: 12 divisions are 120 ms, so the 12 Mpts memory holds them at 100 MSa/s, below the 1 GSa/s maximum.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/rigol_ds1054z",
        "params": {
          "timebase": "10m"
        }
      },
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 1.0
        }
      },
      {
        "id": "RS",
        "component": "emblink/resistor",
        "params": {
          "resistance": 1
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "SRC": [
        "V.+",
        "RS.1"
      ],
      "TIP": [
        "RS.2",
        "DUT.CH1"
      ],
      "GND": [
        "V.-",
        "G.GND",
        "DUT.GND"
      ]
    }
  },
  "expect": {
    "output:DUT.sample_rate": {
      "at": "1ms",
      "equals": 100000000.0
    }
  }
}
