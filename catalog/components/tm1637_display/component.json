{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/tm1637_display",
  "version": "1.1.0",
  "name": "TM1637 4-digit display module",
  "category": "optoelectronics",
  "subcategory": "seven_segment",
  "description": "The common 4-digit 7-segment LED display module on a Titan Micro TM1637: its two-wire interface (not I2C: no address, LSB first, ACK on the 9th clock), the data, address and display-control commands with the eight pulse widths, the colon (clock variant) or decimal points on SEG8, and 10 kOhm pull-ups on CLK and DIO.",
  "keywords": [
    "TM1637",
    "7-segment",
    "display",
    "4-digit",
    "clock display",
    "LED"
  ],
  "family": "cmos_5v",
  "pins": [
    {
      "name": "CLK",
      "number": 1,
      "model": {
        "kind": "digital_in",
        "pull": "up",
        "rpull": 10000
      },
      "doc": "Clock in, the module's 10 kOhm pull-up to VCC",
      "power_ref": "VCC"
    },
    {
      "name": "DIO",
      "number": 2,
      "model": {
        "kind": "digital_io",
        "out": {
          "drive": "open_drain"
        },
        "in": {
          "pull": "up",
          "rpull": 10000
        }
      },
      "doc": "Data in and out (open drain: ACK and key data), the module's 10 kOhm pull-up to VCC",
      "power_ref": "VCC"
    },
    {
      "name": "VCC",
      "number": 3,
      "model": {
        "kind": "power",
        "role": "supply",
        "nominal_v": 5.0,
        "tolerance": 0.1
      },
      "required": false,
      "doc": "Supply, 5 V (the data sheet's 4.5 to 5.5 V)"
    },
    {
      "name": "GND",
      "number": 4,
      "model": {
        "kind": "power",
        "role": "ground"
      },
      "required": false,
      "doc": "Ground"
    }
  ],
  "params": {
    "dots": {
      "type": "enum",
      "enum": [
        "colon",
        "points"
      ],
      "default": "colon",
      "doc": "What SEG8 lights: the clock variant's colon between digits 2 and 3, or each digit's decimal point"
    }
  },
  "outputs": [
    {
      "name": "text",
      "type": "string",
      "doc": "What the display shows: four characters (the colon as ':' between digits 2 and 3, decimal points as '.'), blank while off"
    },
    {
      "name": "segments",
      "type": "string",
      "doc": "The four digits' display registers in hex (C0H to C3H), bit 0 = a .. bit 6 = g, bit 7 = colon or point"
