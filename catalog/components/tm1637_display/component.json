  "fidelity": {
    "functional": {
      "claims": "The TM1637's two-wire interface (START and STOP with CLK high, LSB first on CLK's rising edges, ACK from the 8th clock's falling edge to the end of the 9th); the data command (write, auto-increment or fixed address, key read returning 0xFF), the address command (C0H..C5H, data dropped from C6H) and display control (on/off, pulse width 1/16 to 14/16); a STOP keeping acknowledged bytes; digits 1 to 4 on GRID1..4, SEG8 the colon or the decimal points; off at power-on with the address at C0H.",
      "omissions": [
        "the grid multiplexing on the module's LEDs (each digit lights at the set pulse width)",
        "the 100 pF capacitors on CLK and DIO",
        "the display RAM's content at power-up (taken as zero)",
        "test mode (data command B3)",
        "key scanning (the module wires no keys: reads 0xFF)",
        "the LEDs' current and brightness spread"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "The TM1637's two-wire interface (START and STOP with CLK high, LSB first on CLK's rising edges, ACK from the 8th clock's falling edge to the end of the 9th); the data command (write, auto-increment or fixed address, key read returning 0xFF), the address command (C0H..C5H, data dropped from C6H) and display control (on/off, pulse width 1/16 to 14/16); a STOP keeping acknowledged bytes; digits 1 to 4 on GRID1..4, SEG8 the colon or the decimal points; off at power-on with the address at C0H. ACK within 100 ns, release within 300 ns; clock pulses shorter than 400 ns reported.",
      "omissions": [
        "the grid multiplexing on the module's LEDs (each digit lights at the set pulse width)",
        "the 100 pF capacitors on CLK and DIO",
        "the display RAM's content at power-up (taken as zero)",
        "test mode (data command B3)",
        "key scanning (the module wires no keys: reads 0xFF)",
        "the LEDs' current and brightness spread"
      ]
    },
    "electrical": {
      "claims": "CLK and DIO switch at the family's thresholds with the module's 10 kOhm pull-ups; DIO sinks for ACK; the behaviour is the Lua model's.",
      "omissions": [
        "the grid multiplexing on the module's LEDs (each digit lights at the set pulse width)",
        "the 100 pF capacitors on CLK and DIO",
        "the display RAM's content at power-up (taken as zero)",
        "test mode (data command B3)",
        "key scanning (the module wires no keys: reads 0xFF)",
        "the LEDs' current and brightness spread",
        "the supply current"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
