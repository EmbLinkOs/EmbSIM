{
  "schema_version": 1,
  "kind": "component_test",
  "name": "keys",
  "description": "Data command 42H (read keys): the chip shifts out the key byte after the ACK; the module has no keys, so every bit is high (0xFF), then the ACK.",
  "policy": "functional",
  "until": "80us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,0,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tm1637_display"
      }
    ],
    "nets": {
      "N_DIO": [
        "PG.OUT0",
        "DUT.DIO"
      ],
      "N_CLK": [
        "PG.OUT1",
        "DUT.CLK"
      ]
    }
  },
  "expect": {
    "net:N_DIO": {
      "at": "32500ns",
      "logic": "1"
    },
    "pin:DUT.DIO": {
      "at": "56500ns",
      "logic": "0"
    }
  }
}
