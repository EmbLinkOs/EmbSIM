{
  "schema_version": 1,
  "kind": "component_test",
  "name": "stop",
  "description": "A STOP in the middle of the third data byte: the two acknowledged bytes stay, the partial one is dropped (the data sheet: transfers before the STOP remain effective).",
  "policy": "functional",
  "until": "300us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,0,0,2,3,3,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,1,3,0,0,2,0,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,3,3,2,0,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,1,3,1,1,3,0,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tm1637_display"
      }
    ],
    "nets": {
      "N_DIO": [
        "PG.OUT0",
        "DUT.DIO"
      ],
      "N_CLK": [
        "PG.OUT1",
        "DUT.CLK"
      ]
    }
  },
  "expect": {
    "output:DUT.segments": {
      "at": "290us",
      "equals": "3F 06 00 00"
    }
  }
}
