{
  "schema_version": 1,
  "kind": "component_test",
  "name": "power-on-off",
  "description": "The digits written but no display control sent: the display stays off after power-on, as the data sheet's display switch starts.",
  "policy": "functional",
  "until": "250us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,0,0,2,3,3,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,1,3,0,0,2,0,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,0,1,3,1,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,0,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,1,3,0,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tm1637_display"
      }
    ],
    "nets": {
      "N_DIO": [
        "PG.OUT0",
        "DUT.DIO"
      ],
      "N_CLK": [
        "PG.OUT1",
        "DUT.CLK"
      ]
    }
  },
  "expect": {
    "output:DUT.text": {
      "at": "240us",
      "equals": "    "
    },
    "output:DUT.on": {
      "at": "240us",
      "equals": false
    },
    "output:DUT.segments": {
      "at": "240us",
      "equals": "3F 06 5B 4F"
    }
  }
}
