{
  "schema_version": 1,
  "kind": "component_test",
  "name": "vbe_on",
  "description": "IC near 0.3 A at VCE = 1 V (the base fed 0.000755668 A): VBE(on) at most the datasheet's 1.2 V",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": -1.0
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
        "params": {
          "kind": "pulse",
          "v1": 0,
          "v2": -0.000755668,
          "td": "1u",
          "tr": "50u",
          "tf": "1u",
          "pw": "1",
          "per": "2"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bc32740bu"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "COLL": [
        "VC.+",
        "DUT.C"
      ],
      "BASE": [
        "IB.-",
        "DUT.B"
      ],
      "GND": [
        "VC.-",
        "IB.+",
        "DUT.E",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:BASE": {
      "at": "150us",
      "min_v": -1.2,
      "max_v": -0.5
    }
  }
}
