      "number": 15,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VCC"
    },
    {
      "name": "VCC",
      "number": 16,
      "model": {
        "kind": "power",
        "role": "supply",
        "nominal_v": 3.3,
        "tolerance": 0.1
      },
      "required": false,
      "doc": "Supply (defaults to the family rail)"
    }
  ],
  "params": {
    "address": {
      "type": "integer",
      "default": 32,
      "min": 32,
      "max": 39,
      "doc": "I2C address, 32 (0x20) + A2..A0 as wired (PCF8574A: use 56-63)"
    }
  },
  "outputs": [
    {
      "name": "latch",
      "type": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "port",
      "type": "integer",
      "min": 0,
      "max": 255,
      "doc": "Pin levels"
    }
  ],
  "model": {
    "script": "model.lua",
    "api": 1
  },
  "fidelity": {
    "functional": {
      "claims": "Quasi-bidirectional ports (weak 1, strong 0), reads of the pin levels, INT_N set on input change and cleared by a read or write.",
      "omissions": [
        "the strong pull-up pulse on a 0-to-1 write",
        "A0-A2 are not read: set the address parameter"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional; delays as stated.",
      "omissions": [
        "the strong pull-up pulse on a 0-to-1 write",
        "A0-A2 are not read: set the address parameter"
      ]
    },
    "electrical": {
      "claims": "Pins bridge to analog nets with the family's pin-model defaults; the behaviour is the Lua model's.",
      "omissions": [
        "the strong pull-up pulse on a 0-to-1 write",
        "A0-A2 are not read: set the address parameter",
        "supply current",
        "output current limits"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
