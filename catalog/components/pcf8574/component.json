    },
    {
      "name": "INT_N",
      "number": 13,
      "model": {
        "kind": "digital_out",
        "drive": "push_pull"
      },
      "doc": "Interrupt, open drain: an input changed since the last read",
      "power_ref": "VCC"
    },
    {
      "name": "SCL",
      "number": 14,
      "model": {
        "kind": "digital_in"
      },
