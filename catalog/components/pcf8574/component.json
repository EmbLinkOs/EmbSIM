  "id": "emblink/pcf8574",
  "version": "1.0.0",
  "name": "PCF8574 I2C IO expander",
  "category": "misc",
  "description": "8-bit quasi-bidirectional I/O expander on I2C (PCF8574, address 0x20): a written 1 is a weak pull-up the pin can read through, a 0 a strong low; reads return the pin levels; INT_N goes low when an input changes. Drives the common I2C LCD backpacks.",
  "keywords": [
    "io expander",
    "PCF8574",
    "i2c",
    "gpio",
    "port",
    "lcd backpack"
  ],
  "family": "cmos_3v3",
