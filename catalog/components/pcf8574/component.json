      "number": 1,
      "model": {
        "kind": "digital_in"
      },
      "doc": "Address bit 0 (see the address parameter)",
      "power_ref": "VCC"
    },
    {
      "name": "A1",
      "number": 2,
      "model": {
        "kind": "digital_in"
      },
      "power_ref": "VCC"
    },
