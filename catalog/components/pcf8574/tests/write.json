{
  "schema_version": 1,
  "kind": "component_test",
  "name": "write",
  "description": "Writing 0x0F: P0-P3 weakly high, P4-P7 low.",
  "policy": "functional",
  "until": "101us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/pcf8574"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "P0": [
        "DUT.P0"
      ],
      "P4": [
        "DUT.P4"
      ]
    }
  },
  "expect": {
    "net:P0": {
      "at": "81us",
      "logic": "1"
    },
    "net:P4": {
      "at": "81us",
      "logic": "0"
    },
    "output:DUT.latch": {
      "at": "81us",
      "equals": 15
    }
  }
}
