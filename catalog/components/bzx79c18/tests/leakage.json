{
  "schema_version": 1,
  "kind": "component_test",
  "name": "leakage",
  "description": "VR across it through 100 kohm: under the datasheet's IR at 25 C",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 12.6
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "100k"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bzx79c18"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "VK": [
        "R1.2",
        "DUT.K"
      ],
      "GND": [
        "V1.-",
        "DUT.A",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VK": {
      "at": "50us",
      "min_v": 12.595,
      "max_v": 12.6
    }
  }
}
