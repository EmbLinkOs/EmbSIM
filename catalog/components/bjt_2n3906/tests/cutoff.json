{
  "schema_version": 1,
  "kind": "component_test",
  "name": "cutoff",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "RB",
        "component": "emblink/resistor",
        "params": {
          "resistance": "10k"
        }
      },
      {
        "id": "RC",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bjt_2n3906"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "V1.+",
        "DUT.E",
        "DUT.B"
      ],
      "BASE": [
        "RB.1"
      ],
      "COLL": [
        "RC.1",
        "DUT.C"
      ],
      "GND": [
        "V1.-",
        "RB.2",
        "RC.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:COLL": {
      "at": "50us",
      "min_v": -0.01,
      "max_v": 0.1
    }
  }
}
