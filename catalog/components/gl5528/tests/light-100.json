{
  "schema_version": 1,
  "kind": "component_test",
  "name": "light-100",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": 15000
        }
      },
      {
        "id": "DUT",
        "component": "emblink/gl5528",
        "params": {
          "tolerance": 0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "V.+",
        "R.1"
      ],
      "SENSE": [
        "R.2",
        "DUT.1"
      ],
      "GND": [
        "DUT.2",
        "V.-",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:SENSE": {
      "at": "500us",
      "min_v": 0.998,
      "max_v": 1.01
    }
  },
  "inputs": [
    {
      "at": "100us",
      "target": "DUT",
      "input": "illuminance",
      "value": 100
    }
  ],
  "description": "At 100 lux the GL5528's datasheet law gives 15 kOhm x 10^-0.6 = 3.769 kOhm (tolerance 0: the nominal part): 1.004 V under 15 kOhm from 5 V."
}
