{
  "schema_version": 1,
  "kind": "component_test",
  "name": "response-rise",
  "policy": "electrical",
  "until": "40ms",
  "circuit": {
    "components": [
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": 15000
        }
      },
      {
        "id": "DUT",
        "component": "emblink/gl5528",
        "params": {
          "tolerance": 0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "V.+",
        "R.1"
      ],
      "SENSE": [
        "R.2",
        "DUT.1"
      ],
      "GND": [
        "DUT.2",
        "V.-",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:SENSE": {
      "at": "30ms",
      "min_v": 1.275,
      "max_v": 1.301
    }
  },
  "inputs": [
    {
      "at": "10ms",
      "target": "DUT",
      "input": "illuminance",
      "value": 100
    }
  ],
  "description": "The datasheet's 20 ms rise at 10 lux: from 10 lux (15 kOhm, 2.5 V under 15 kOhm from 5 V) the light goes to 100 lux at 10 ms; one rise constant later the conductance is 1 - 1/e of the way from 66.7 uS to 265.3 uS, 192.2 uS: 5.20 kOhm, 1.288 V."
}
