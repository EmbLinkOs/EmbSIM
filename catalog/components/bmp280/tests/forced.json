{
  "schema_version": 1,
  "kind": "component_test",
  "name": "forced",
  "description": "At 0x76 (SDO low): ctrl_meas x1/x1 forced. The measurement takes the typical 5.5 ms (no humidity to add), the part returns to sleep with the air's values to the 16-bit resolution.",
  "policy": "functional",
  "until": "21ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "0"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/bmp280"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDI",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCK",
        "PU2.1"
      ],
      "CSB": [
        "DUT.CSB",
        "PU3.1"
      ]
    }
  },
  "inputs": [
    {
      "at": "0",
      "target": "DUT",
      "input": "temperature",
      "value": 21.37
    },
    {
      "at": "0",
      "target": "DUT",
      "input": "pressure",
      "value": 1009.82
    }
  ],
  "expect": {
    "output:DUT.temperature": {
      "at": "20ms",
      "min": 21.36,
      "max": 21.38
    },
    "output:DUT.pressure": {
      "at": "20ms",
      "min": 1009.7,
      "max": 1009.95
    },
    "output:DUT.mode": {
      "at": "7ms",
      "equals": "sleep"
    },
    "output:DUT.measurements": {
      "at": "5ms",
      "equals": 0
    }
  }
}
