{
  "schema_version": 1,
  "kind": "component_test",
  "name": "standby",
  "description": "Normal mode at x1/x1 with t_sb code 6: the BMP280's 2 s standby (a BME280's would be 10 ms): a measurement at the start, the next 2.0055 s later, the third at 4.011 s.",
  "policy": "functional",
  "until": "4600ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3,3,2,0,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "0"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/bmp280"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDI",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCK",
        "PU2.1"
      ],
      "CSB": [
        "DUT.CSB",
        "PU3.1"
      ]
    }
  },
  "inputs": [
    {
      "at": "0",
      "target": "DUT",
      "input": "temperature",
      "value": 21.37
    },
    {
      "at": "0",
      "target": "DUT",
      "input": "pressure",
      "value": 1009.82
    }
  ],
  "expect": {
    "output:DUT.measurements": {
      "at": "4500ms",
      "equals": 3
    },
    "output:DUT.mode": {
      "at": "4500ms",
      "equals": "normal"
    }
  }
}
