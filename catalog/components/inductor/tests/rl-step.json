{
  "schema_version": 1,
  "kind": "component_test",
  "name": "rl-step",
  "description": "With tau = 1 us the current settles to 3.3 mA well before 50 us.",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/inductor",
        "params": {
          "inductance": "1m"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "R1.1"
      ],
      "MID": [
        "R1.2",
        "DUT.1"
      ],
      "GND": [
        "V1.-",
        "DUT.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "device:DUT.i": {
      "at": "50us",
      "min": 0.0031,
      "max": 0.0034
    }
  }
}
