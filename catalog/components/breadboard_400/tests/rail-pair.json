{
  "schema_version": 1,
  "kind": "component_test",
  "name": "rail-pair",
  "description": "The two rails of a pair are isolated: TP1 does not reach TN1.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/breadboard_400"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "IN": [
        "V1.+",
        "DUT.TP1"
      ],
      "OUT": [
        "DUT.TN1",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "0.5ms",
      "min_v": -0.01,
      "max_v": 0.01
    }
  }
}
