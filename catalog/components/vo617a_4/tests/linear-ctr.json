{
  "schema_version": 1,
  "kind": "component_test",
  "name": "linear-ctr",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "VIN",
        "component": "emblink/vsource",
        "params": {
          "dc": 1.51
        }
      },
      {
        "id": "VOUT",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "RI",
        "component": "emblink/resistor",
        "params": {
          "resistance": 390
        }
      },
      {
        "id": "RP",
        "component": "emblink/resistor",
        "params": {
          "resistance": 1000
        }
      },
      {
        "id": "DUT",
        "component": "emblink/vo617a_4"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "OFFSET",
        "component": "emblink/vsource",
        "params": {
          "dc": 2
        }
      }
    ],
    "nets": {
      "INPUT": [
        "VIN.+",
        "RI.1"
      ],
      "ANODE": [
        "RI.2",
        "DUT.A"
      ],
      "IG": [
        "VIN.-",
        "DUT.K",
        "OFFSET.+"
      ],
      "GND": [
        "OFFSET.-",
        "VOUT.-",
        "DUT.E",
        "G.GND"
      ],
      "VCC": [
        "VOUT.+",
        "RP.1"
      ],
      "OUT": [
        "RP.2",
        "DUT.C"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "500us",
      "min_v": 2.5900000000000003,
      "max_v": 2.61
    }
  }
}
