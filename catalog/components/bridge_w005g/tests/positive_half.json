{
  "schema_version": 1,
  "kind": "component_test",
  "name": "positive_half",
  "description": "12 V on AC1 into 10 ohm between + and −: about 1 A through two junctions, so 12 V less one drop (the − terminal and the source's return share ground) of at most 1.0 V each",
  "policy": "electrical",
  "until": "100us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": 12
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bridge_w005g"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 10,
          "tolerance": 0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.AC1"
      ],
      "VDC": [
        "DUT.+",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.AC2",
        "G.GND",
        "RL.2",
        "DUT.-"
      ]
    }
  },
  "expect": {
    "net:VDC": {
      "at": "50us",
      "min_v": 11.0,
      "max_v": 12
    }
  }
}
