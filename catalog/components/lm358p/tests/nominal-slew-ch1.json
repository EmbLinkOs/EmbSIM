{
  "schema_version": 1,
  "kind": "component_test",
  "name": "nominal-slew-ch1",
  "description": "Native LM358P channel 1: source-anchored nominal dynamics. A follower into 10 kOhm given a 2 V step: the output slews at the datasheet's 0.3 V/us (typical), 1.3 V a microsecond after the step, and settles at 3 V 7 us later.",
  "policy": "electrical",
  "until": "40us",
  "circuit": {
    "components": [
      {
        "id": "VI",
        "component": "emblink/vsource",
        "params": {
          "kind": "pulse",
          "v1": 1.0,
          "v2": 3.0,
          "td": "10u",
          "tr": "10n",
          "tf": "10n",
          "pw": "1m",
          "per": "2m"
        }
      },
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/lm358p"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": "10k"
        }
      }
    ],
    "nets": {
      "IN": [
        "VI.+",
        "DUT.IN1+"
      ],
      "VCC": [
        "VS.+",
        "DUT.VCC"
      ],
      "GND": [
        "VI.-",
        "VS.-",
        "DUT.GND",
        "G.GND",
        "RL.2"
      ],
      "OUT": [
        "DUT.OUT1",
        "DUT.IN1-",
        "RL.1"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "11us",
      "min_v": 1.255,
      "max_v": 1.345
    },
    "pin:RL.1": {
      "at": "19.6667us",
      "min_v": 2.98,
      "max_v": 3.02
    }
  }
}
