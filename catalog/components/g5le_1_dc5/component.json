{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/g5le_1_dc5",
  "version": "1.0.0",
  "name": "G5LE-1 DC5",
  "category": "mechanical",
  "description": "G5LE-1 SPDT relay with R/L coil, hysteretic pickup, 10 ms operate and 5 ms release delay; independent contact circuit.",
  "keywords": [
    "mechanical",
    "G5LE-1 DC5",
    "Omron",
    "PCB relay SPDT"
  ],
  "pins": [
    {
      "name": "COIL+",
      "number": 2,
      "model": {
        "kind": "passive"
      },
      "doc": "COIL+"
    },
    {
      "name": "COIL-",
      "number": 5,
      "model": {
        "kind": "passive"
      },
      "doc": "COIL-"
    },
    {
      "name": "COM",
      "number": 1,
      "model": {
        "kind": "passive"
      },
      "doc": "COM"
    },
    {
      "name": "NC",
      "number": 4,
      "model": {
        "kind": "passive"
      },
      "doc": "NC"
    },
    {
      "name": "NO",
      "number": 3,
      "model": {
        "kind": "passive"
      },
      "doc": "NO"
    }
  ],
  "params": {
    "coil_r": {
      "type": "number",
      "default": 70,
      "doc": "Nominal winding DC resistance; coil temperature and tolerance are omitted.",
      "unit": "ohm",
      "min": 1,
      "max": 100000
    },
    "coil_l": {
      "type": "number",
      "default": 0.1,
      "doc": "Illustrative winding inductance, not measured manufacturer data; affects pickup and flyback decay.",
      "unit": "H",
      "min": 1e-06,
      "max": 100
    },
    "pickup": {
      "type": "number",
      "default": 3.75,
      "doc": "Pickup threshold across the coil resistance (proportional to coil current), rather than across the whole inductive winding.",
      "unit": "V",
      "min": 0.01,
      "max": 1000
    },
    "dropout": {
      "type": "number",
      "default": 0.5,
      "doc": "Dropout threshold across the coil resistance; below pickup to provide hysteresis.",
      "unit": "V",
      "min": 0,
      "max": 1000
    },
    "operate_s": {
      "type": "number",
      "default": 0.01,
      "doc": "Continuous time above pickup required before closing the normally-open contact.",
      "unit": "s",
      "min": 0,
      "max": 10
    },
    "release_s": {
      "type": "number",
      "default": 0.005,
      "doc": "Continuous time below dropout required before returning to the normally-closed contact.",
      "unit": "s",
      "min": 0,
      "max": 10
    }
  },
  "model": {
    "composite": {
      "components": [
        {
          "id": "R",
          "component": "emblink/resistor",
          "params": {
            "resistance": "$coil_r"
          }
        },
        {
          "id": "L",
          "component": "emblink/inductor",
          "params": {
            "inductance": "$coil_l",
            "ic": 0
          }
        },
        {
          "id": "K",
          "component": "emblink/relay_contacts",
          "params": {
            "pickup": "$pickup",
            "dropout": "$dropout",
            "operate_s": "$operate_s",
            "release_s": "$release_s"
          }
        }
      ],
      "nets": {
        "SENSE": [
          "R.2",
          "L.1",
          "K.S-"
        ],
        "POWER": [
          "R.1",
          "K.S+"
        ],
        "RETURN": [
          "L.2"
        ],
        "COM": [
          "K.COM"
        ],
        "NC": [
          "K.NC"
        ],
        "NO": [
          "K.NO"
        ]
      },
      "ports": {
        "COIL+": "R.1",
        "COIL-": "L.2",
        "COM": "K.COM",
        "NC": "K.NC",
        "NO": "K.NO"
      }
    }
  },
