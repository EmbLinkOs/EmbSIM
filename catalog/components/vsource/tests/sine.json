{
  "schema_version": 1,
  "kind": "component_test",
  "name": "sine",
  "description": "1 kHz sine of 1 V amplitude about 1 V stays within 0 to 2 V.",
  "policy": "electrical",
  "until": "10ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/vsource",
        "params": {
          "kind": "sine",
          "vo": 1,
          "va": 1,
          "freq": "1k"
        }
      },
      {
        "id": "R1",
        "component": "emblink/resistor",
        "params": {
          "resistance": "1k"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "OUT": [
        "DUT.+",
        "R1.1"
      ],
      "GND": [
        "DUT.-",
        "R1.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "between": [
        "0",
        "10ms"
      ],
      "min_v": -0.01,
      "max_v": 2.01
    }
  }
}
