{
  "schema_version": 1,
  "kind": "component_test",
  "name": "sat-150ma",
  "description": "The datasheet's saturation point: about 150 mA from 5 V through 30 ohm, 15 mA into the base through 270 ohm: VCE(sat) at most 0.3 V and VBE(sat) 0.6 to 1.2 V.",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "G0",
        "component": "emblink/gnd"
      },
      {
        "id": "DUT",
        "component": "emblink/bsr14"
      },
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 5.0
        }
      },
      {
        "id": "RC",
        "component": "emblink/resistor",
        "params": {
          "resistance": 30
        }
      },
      {
        "id": "RB",
        "component": "emblink/resistor",
        "params": {
          "resistance": 270
        }
      }
    ],
    "nets": {
      "VCN": [
        "VC.+",
        "RC.1",
        "RB.1"
      ],
      "C": [
        "RC.2",
        "DUT.C"
      ],
      "B": [
        "RB.2",
        "DUT.B"
      ],
      "GND": [
        "VC.-",
        "DUT.E",
        "G0.GND"
      ]
    }
  },
  "inputs": [],
  "expect": {
    "net:C": {
      "at": "1ms",
      "max_v": 0.3
    },
    "net:B": {
      "at": "1ms",
      "min_v": 0.6,
      "max_v": 1.2
    }
  }
}
