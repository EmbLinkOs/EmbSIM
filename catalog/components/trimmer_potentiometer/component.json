{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/trimmer_potentiometer",
  "version": "1.0.0",
  "name": "Trimmer potentiometer",
  "category": "passives",
  "description": "Multi-turn trimmer (3296 style): a potentiometer set once with a screwdriver to calibrate a divider.",
  "keywords": [
    "trimmer",
    "potentiometer",
    "trimpot",
    "3296",
    "calibration",
    "divider"
  ],
  "pins": [
    {
      "name": "1",
      "number": 1,
      "model": {
        "kind": "passive"
      },
      "doc": "End 1 (position 0)"
    },
    {
      "name": "W",
      "number": 2,
      "model": {
        "kind": "passive"
      },
      "doc": "Wiper"
    },
    {
      "name": "2",
      "number": 3,
      "model": {
        "kind": "passive"
      },
      "doc": "End 2 (position 1)"
    }
  ],
  "params": {
    "resistance": {
      "type": "number",
      "unit": "ohm",
      "default": "10k",
      "min": 10,
      "max": "10meg",
      "doc": "End-to-end resistance"
    }
  },
  "inputs": [
    {
      "name": "position",
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "doc": "Wiper position from end 1"
    }
  ],
  "model": {
    "primitive": "potentiometer",
    "bind": {
      "r": "resistance"
    },
    "params": {
      "taper": "linear"
    }
  },
  "fidelity": {
