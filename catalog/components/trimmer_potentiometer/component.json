    "timed": {
      "claims": "As electrical.",
      "omissions": []
    },
    "electrical": {
      "claims": "Two resistors split at the wiper position, linear taper (SPEC-004 §7 potentiometer).",
      "omissions": [
        "end resistance",
        "wiper contact resistance",
        "temperature coefficient"
      ],
      "range": {
        "power_w": [
          0,
          0.5
        ]
      },
      "validation": [
        "tests/*.json"
      ]
    }
  },
  "provenance": {
    "author": "EmbSIM",
    "license": "Apache-2.0",
    "sources": [
      {
        "title": "Bourns 3296 trimming potentiometer datasheet"
      }
    ]
  },
  "symbol": {
