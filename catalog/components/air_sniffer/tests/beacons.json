{
  "schema_version": 1,
  "kind": "component_test",
  "name": "beacons",
  "description": "On channel 6 it captures the access point's ten beacons by 930 ms (every 102.4 ms from 2.048 ms, the tenth taken as it ends after 923.648 ms).",
  "policy": "functional",
  "until": "930ms",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/air_sniffer",
        "params": {
          "radio": "wifi",
          "channel": 6
        }
      },
      {
        "id": "AP",
        "component": "emblink/wifi_ap",
        "params": {
          "ssid": "Lab",
          "password": "secret123",
          "channel": 6,
          "bssid": "02:e5:00:00:00:01"
        }
      }
    ],
    "nets": {}
  },
  "expect": {
    "output:DUT.frames": {
      "at": "930ms",
      "equals": 10
    }
  }
}
