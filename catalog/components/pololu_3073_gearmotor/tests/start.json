{
 "schema_version": 1,
 "kind": "component_test",
 "name": "start",
 "description": "Powered at t = 0 from rest it draws its 1.5 A stall current, and spins up on its mechanical time constant: past half speed within 20 ms, near its 650 rpm by 100 ms.",
 "policy": "electrical",
 "until": "150ms",
 "circuit": {
  "components": [
   {
    "id": "V1",
    "component": "emblink/vsource",
    "params": {
     "kind": "dc",
     "dc": 6.0
    }
   },
   {
    "id": "DUT",
    "component": "emblink/pololu_3073_gearmotor"
   },
   {
    "id": "G",
    "component": "emblink/gnd"
   }
  ],
  "nets": {
   "VIN": [
    "V1.+",
    "DUT.+"
   ],
   "GND": [
    "V1.-",
    "DUT.-",
    "G.GND"
   ]
  }
 },
 "expect": {
  "output:DUT.current": {
   "at": "10us",
   "min": 1.3,
   "max": 1.5
  },
  "output:DUT.rpm": {
   "at": "100ms",
   "min": 620,
   "max": 660
  }
 }
}