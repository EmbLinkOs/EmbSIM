      {
        "output": "line1",
        "selector": "#line1",
        "attr": "text",
        "format": "{}"
      },
      {
        "output": "line2",
        "selector": "#line2",
        "attr": "text",
        "format": "{}"
      },
      {
        "output": "on",
        "selector": "#glass",
        "attr": "opacity",
        "true": "0.9",
        "false": "0.35"
      }
    ]
  },
  "fidelity": {
    "functional": {
      "claims": "The HD44780 instruction set and power-on reset (8-bit, one line, display off, 10 ms busy); 8-bit and 4-bit transfers; the execution times (37 us; clear and home 1.52 ms) with writes ignored while busy; reads of the busy flag, the address counter and DDRAM/CGRAM; pull-ups on RS, R/W and DB0-DB7; DDRAM in one or two lines with shift; CGRAM stored and read back; the A00 character ROM (yen, arrows, katakana, Greek); characters shown only with VDD - V0 of 3.0 V or more; the backlight on with A 2.5 V above K.",
      "omissions": [
        "the 5x10 font",
        "execution times' change with supply and temperature",
        "CGRAM characters' pixels in the line outputs (shown as #)",
        "cursor and blink drawing",
        "the backlight LED draws no current (wire an LED across A and K)",
        "the dark boxes an uninitialised module shows on row 1 with the contrast high"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional; delays as stated.",
      "omissions": [
        "the 5x10 font",
        "execution times' change with supply and temperature",
        "CGRAM characters' pixels in the line outputs (shown as #)",
        "cursor and blink drawing",
        "the backlight LED draws no current (wire an LED across A and K)",
        "the dark boxes an uninitialised module shows on row 1 with the contrast high"
      ]
    },
    "electrical": {
      "claims": "Pins bridge to analog nets with the family's pin-model defaults; the behaviour is the Lua model's.",
      "omissions": [
        "the 5x10 font",
        "execution times' change with supply and temperature",
        "CGRAM characters' pixels in the line outputs (shown as #)",
        "cursor and blink drawing",
        "supply current",
        "output current limits",
        "the backlight LED draws no current (wire an LED across A and K)",
        "the dark boxes an uninitialised module shows on row 1 with the contrast high"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
  "provenance": {
