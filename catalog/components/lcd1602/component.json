      "number": 10,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VDD"
    },
    {
      "name": "D4",
      "number": 11,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VDD"
    },
    {
      "name": "D5",
      "number": 12,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VDD"
    },
    {
      "name": "D6",
      "number": 13,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VDD"
    },
    {
      "name": "D7",
      "number": 14,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VDD"
    },
    {
      "name": "A",
      "number": 15,
      "model": {
        "kind": "passive"
      },
      "required": false,
      "doc": "Backlight anode (the model draws no current: wire the backlight LED across A and K to load it)"
    },
    {
      "name": "K",
      "number": 16,
      "model": {
        "kind": "passive"
      },
      "required": false,
      "doc": "Backlight cathode"
    }
  ],
  "params": {
    "columns": {
      "type": "integer",
      "default": 16,
      "min": 16,
      "max": 16,
      "doc": "Characters per row on the glass (fixed for this module)"
    },
    "rows": {
      "type": "integer",
      "default": 2,
      "min": 2,
      "max": 2,
      "doc": "Rows on the glass (fixed for this module)"
    }
  },
