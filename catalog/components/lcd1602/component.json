{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/lcd1602",
  "version": "1.1.0",
  "name": "16x2 character LCD",
  "category": "displays",
  "description": "HD44780-compatible 16x2 character LCD: commands and characters latched on E falling, 8-bit or 4-bit bus, each taking the controller's execution time (writes while busy are lost); the busy flag, address counter and RAM read back; the part's pull-ups on RS, R/W and DB0-DB7; the contrast voltage and backlight; the two lines show on the board view.",
  "keywords": [
    "display",
    "lcd",
    "1602",
    "16x2",
    "HD44780",
    "character",
    "alphanumeric"
  ],
  "family": "cmos_5v",
  "pins": [
    {
      "name": "VSS",
      "number": 1,
      "model": {
        "kind": "power",
        "role": "ground"
      },
      "required": false
    },
    {
      "name": "VDD",
      "number": 2,
      "model": {
        "kind": "power",
        "role": "supply",
        "nominal_v": 5.0,
        "tolerance": 0.1
      },
      "required": false
    },
    {
      "name": "V0",
      "number": 3,
      "model": {
        "kind": "analog"
      },
      "required": false,
      "doc": "Contrast: the characters show while VDD - V0 is at least 3.0 V"
    },
    {
      "name": "RS",
      "number": 4,
      "model": {
        "kind": "digital_io"
      },
      "doc": "Register select (pulled up inside)",
      "power_ref": "VDD"
    },
    {
      "name": "RW",
      "number": 5,
      "model": {
        "kind": "digital_io"
      },
      "doc": "Read/write: high reads (pulled up inside, so it must be tied low to write)",
      "power_ref": "VDD"
    },
    {
      "name": "E",
      "number": 6,
      "model": {
        "kind": "digital_in"
      },
      "doc": "Enable: data latched on the falling edge",
      "power_ref": "VDD"
    },
    {
      "name": "D0",
      "number": 7,
      "model": {
        "kind": "digital_io"
      },
      "power_ref": "VDD"
    },
    {
