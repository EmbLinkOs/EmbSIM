{
  "schema_version": 1,
  "kind": "component_test",
  "name": "temperature",
  "description": "The die temperature at 340 LSB per C from 36.53 C: 30 C reads -2220 LSB, 30.0006 C.",
  "policy": "functional",
  "until": "3ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "0"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/mpu6050"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ]
    }
  },
  "expect": {
    "output:DUT.temperature": {
      "at": "2ms",
      "min": 30.0,
      "max": 30.001
    }
  },
  "inputs": [
    {
      "at": "0",
      "target": "DUT",
      "input": "temperature",
      "value": 30
    }
  ]
}
