{
  "schema_version": 1,
  "kind": "component_test",
  "name": "address",
  "description": "AD0 pulled high: the wake-up written to 0x68 is not acknowledged; the one to 0x69 is.",
  "policy": "functional",
  "until": "4ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "0"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/mpu6050"
      },
      {
        "id": "PG2",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "2m"
        }
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1",
        "PG2.OUT0"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1",
        "PG2.OUT1"
      ],
      "AD0": [
        "DUT.AD0",
        "PU3.1"
      ]
    }
  },
  "expect": {
    "output:DUT.asleep": {
      "at": "1ms",
      "equals": true
    },
    "pin:DUT.AD0": {
      "at": "1ms",
      "logic": "1"
    },
    "output:DUT.accel_z": {
      "at": "3ms",
      "equals": 1
    }
  }
}
