{
  "schema_version": 1,
  "kind": "component_test",
  "name": "cold-holds-more",
  "description": "At -40 C the hold current rises to 0.77 A: 0.75 A is held. A current-limited supply at the datasheet's Vmax: the source's current, clamped at 15 V by a zener once the fuse trips.",
  "policy": "electrical",
  "until": "1200s",
  "circuit": {
    "components": [
      {
        "id": "I",
        "component": "emblink/isource",
        "params": {
          "dc": 0.75
        }
      },
      {
        "id": "Z",
        "component": "emblink/zener",
        "params": {
          "vz": 15,
          "rz": 0.1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/mf_msmf050"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "F": [
        "I.-",
        "Z.K",
        "DUT.1"
      ],
      "GND": [
        "I.+",
        "Z.A",
        "DUT.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "output:DUT.tripped": {
      "at": "1200s",
      "equals": false
    }
  },
  "inputs": [
    {
      "at": "0s",
      "target": "DUT",
      "input": "temperature",
      "value": -40
    }
  ]
}
