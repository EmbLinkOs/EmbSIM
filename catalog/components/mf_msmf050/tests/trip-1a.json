{
  "schema_version": 1,
  "kind": "component_test",
  "name": "trip-1a",
  "description": "The trip current: 1.0 A trips (the model: in about 100 s). A current-limited supply at the datasheet's Vmax: the source's current, clamped at 15 V by a zener once the fuse trips.",
  "policy": "electrical",
  "until": "300s",
  "circuit": {
    "components": [
      {
        "id": "I",
        "component": "emblink/isource",
        "params": {
          "dc": 1.0
        }
      },
      {
        "id": "Z",
        "component": "emblink/zener",
        "params": {
          "vz": 15,
          "rz": 0.1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/mf_msmf050"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "F": [
        "I.-",
        "Z.K",
        "DUT.1"
      ],
      "GND": [
        "I.+",
        "Z.A",
        "DUT.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "output:DUT.tripped": {
      "by": "300s",
      "equals": true
    }
  }
}
