{
  "schema_version": 1,
  "kind": "component_test",
  "name": "held-23c",
  "description": "0.6 A at 23 C: held (the threshold lies between the hold and trip currents). A current-limited supply at the datasheet's Vmax: the source's current, clamped at 15 V by a zener once the fuse trips.",
  "policy": "electrical",
  "until": "1200s",
  "circuit": {
    "components": [
      {
        "id": "I",
        "component": "emblink/isource",
        "params": {
          "dc": 0.6
        }
      },
      {
        "id": "Z",
        "component": "emblink/zener",
        "params": {
          "vz": 15,
          "rz": 0.1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/mf_msmf050"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "F": [
        "I.-",
        "Z.K",
        "DUT.1"
      ],
      "GND": [
        "I.+",
        "Z.A",
        "DUT.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "output:DUT.tripped": {
      "at": "1200s",
      "equals": false
    }
  }
}
