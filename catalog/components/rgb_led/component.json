{
  "schema_version": 1,
  "kind": "component",
  "id": "emblink/rgb_led",
  "version": "1.0.0",
  "name": "RGB LED",
  "category": "indicators",
  "description": "Four-lead RGB LED: three independent diode junctions sharing a cathode or anode. Electrical policy reports channel current, brightness and mixed color; other policies use explicitly ideal logic.",
  "keywords": [
    "led",
    "rgb",
    "colour",
    "color",
    "common cathode",
    "common anode"
  ],
  "pins": [
    {
      "name": "R",
      "number": 1,
      "model": {
        "kind": "passive"
      },
      "doc": "Red"
    },
    {
      "name": "COM",
      "number": 2,
      "model": {
        "kind": "passive"
      },
      "doc": "Common cathode or anode"
    },
    {
      "name": "G",
      "number": 3,
      "model": {
        "kind": "passive"
      },
      "doc": "Green"
    },
    {
      "name": "B",
      "number": 4,
      "model": {
        "kind": "passive"
      },
      "doc": "Blue"
    }
  ],
  "params": {
    "common": {
      "type": "enum",
      "enum": [
        "cathode",
        "anode"
      ],
      "default": "cathode",
      "doc": "Common cathode or common anode"
    },
    "red_vf": {
      "type": "number",
      "unit": "V",
      "default": 1.8,
      "min": 0.1,
      "max": 10,
      "advanced": true,
      "doc": "Illustrative junction voltage at if_nom; not a manufacturer-qualified fit."
    },
    "green_vf": {
      "type": "number",
      "unit": "V",
      "default": 2.1,
      "min": 0.1,
      "max": 10,
      "advanced": true,
      "doc": "Illustrative junction voltage at if_nom; not a manufacturer-qualified fit."
    },
    "blue_vf": {
      "type": "number",
      "unit": "V",
      "default": 2.9,
      "min": 0.1,
      "max": 10,
      "advanced": true,
      "doc": "Illustrative junction voltage at if_nom; not a manufacturer-qualified fit."
    },
    "if_nom": {
      "type": "number",
      "unit": "A",
      "default": 0.02,
      "min": 1e-06,
      "max": 1,
      "advanced": true,
      "doc": "Per-die nominal current for normalized luminance."
    },
    "rs": {
      "type": "number",
      "unit": "ohm",
      "default": 1,
      "min": 0,
      "advanced": true,
      "doc": "Per-die series resistance; external current-limiting resistors are still required."
    },
    "red_n": {
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 20,
      "advanced": true,
      "doc": "Static junction ideality factor. Generic default; not manufacturer qualification."
    },
    "red_rs": {
      "type": "number",
      "unit": "ohm",
      "min": 0,
      "advanced": true,
      "doc": "Optional channel series resistance, overriding rs.",
      "required": false
    },
    "red_if_nom": {
      "type": "number",
      "unit": "A",
      "min": 1e-06,
      "max": 1,
      "advanced": true,
      "doc": "Optional channel reference current, overriding if_nom.",
      "required": false
    },
    "green_n": {
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 20,
      "advanced": true,
      "doc": "Static junction ideality factor. Generic default; not manufacturer qualification."
    },
    "green_rs": {
      "type": "number",
      "unit": "ohm",
      "min": 0,
      "advanced": true,
      "doc": "Optional channel series resistance, overriding rs.",
      "required": false
    },
    "green_if_nom": {
      "type": "number",
      "unit": "A",
      "min": 1e-06,
      "max": 1,
      "advanced": true,
      "doc": "Optional channel reference current, overriding if_nom.",
      "required": false
    },
    "blue_n": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 20,
      "advanced": true,
      "doc": "Static junction ideality factor. Generic default; not manufacturer qualification."
    },
    "blue_rs": {
      "type": "number",
      "unit": "ohm",
      "min": 0,
      "advanced": true,
      "doc": "Optional channel series resistance, overriding rs.",
      "required": false
    },
    "blue_if_nom": {
      "type": "number",
      "unit": "A",
      "min": 1e-06,
      "max": 1,
      "advanced": true,
      "doc": "Optional channel reference current, overriding if_nom.",
      "required": false
    }
  },
  "outputs": [
    {
      "name": "red",
      "type": "boolean"
    },
    {
      "name": "green",
      "type": "boolean"
    },
    {
      "name": "blue",
      "type": "boolean"
    },
    {
      "name": "lit",
      "type": "boolean"
    },
    {
      "name": "color",
      "type": "string",
      "doc": "#rrggbb of the lit colours"
    },
    {
      "name": "luminance",
      "type": "number",
      "min": 0,
      "max": 1
    },
    {
      "name": "red_luminance",
      "type": "number",
      "min": 0,
      "max": 1
    },
    {
      "name": "green_luminance",
      "type": "number",
      "min": 0,
      "max": 1
    },
    {
      "name": "blue_luminance",
      "type": "number",
      "min": 0,
      "max": 1
    },
    {
      "name": "red_current",
      "type": "number",
      "unit": "A"
    },
    {
      "name": "green_current",
      "type": "number",
      "unit": "A"
    },
    {
      "name": "blue_current",
      "type": "number",
      "unit": "A"
    }
  ],
  "model": {
    "primitive": "rgb_led"
  },
  "artwork": {
    "svg": "artwork.svg",
    "width_mm": 5,
    "height_mm": 8.6,
    "hotspots": [],
    "states": [
      {
        "output": "color",
        "selector": "#glow",
        "attr": "fill",
        "format": "{}"
      },
      {
        "output": "luminance",
        "selector": "#glow",
        "attr": "opacity",
        "scale": {
          "from": [
            0,
            1
          ],
          "to": [
            0,
            0.9
          ]
        }
      }
    ]
  },
  "fidelity": {
    "functional": {
      "claims": "Each colour on or off from the logic levels (no PWM averaging).",
      "omissions": [
        "forward voltages per colour",
        "PWM dimming",
        "colour mixing by intensity"
      ],
      "validation": [
        "tests/*.json"
      ]
    },
    "timed": {
      "claims": "As functional; delays as stated.",
      "omissions": [
        "forward voltages per colour",
        "PWM dimming",
        "colour mixing by intensity"
      ]
    },
    "electrical": {
      "claims": "Three Shockley junctions with independent forward characteristics and series resistance, common-anode/cathode orientation, channel currents, normalized luminance and illustrative color mixing.",
      "omissions": [
        "manufacturer qualification",
        "temperature dependence and aging",
        "reverse breakdown and damage",
        "spectral/colorimetric calibration",
        "perceptual PWM averaging"
      ],
      "validation": [
        "tests/*.json"
      ]
    }
  },
  "provenance": {
    "author": "EmbSIM",
    "license": "Apache-2.0",
    "sources": [
      {
        "title": "Generic 5 mm RGB LED (common cathode, pinout R-COM-G-B)"
      }
    ]
  },
  "symbol": {
    "svg": "symbol.svg",
    "width": 50,
    "height": 40,
    "pins": {
      "R": {
        "x": 0,
        "y": 10,
        "side": "left"
      },
      "G": {
        "x": 0,
        "y": 20,
        "side": "left"
      },
      "B": {
        "x": 0,
        "y": 30,
        "side": "left"
      },
      "COM": {
        "x": 50,
        "y": 10,
        "side": "right"
      }
    }
  },
  "tests": [
    "tests/*.json"
  ],
  "functional": {
    "primitive": "rgb_indicator"
  }
}
