{
  "schema_version": 1,
  "kind": "component_test",
  "name": "electrical-floating-unequal",
  "description": "Open COM, red high, other channels grounded: no false return through reordered pins.",
  "policy": "electrical",
  "until": "1us",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/rgb_led",
        "params": {
          "common": "cathode"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "RR",
        "component": "emblink/resistor",
        "params": {
          "resistance": 159
        }
      },
      {
        "id": "VR",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "RG",
        "component": "emblink/resistor",
        "params": {
          "resistance": 144
        }
      },
      {
        "id": "VG",
        "component": "emblink/vsource",
        "params": {
          "dc": 0
        }
      },
      {
        "id": "RB",
        "component": "emblink/resistor",
        "params": {
          "resistance": 104
        }
      },
      {
        "id": "VB",
        "component": "emblink/vsource",
        "params": {
          "dc": 0
        }
      }
    ],
    "nets": {
      "GND": [
        "G.GND",
        "VR.-",
        "VG.-",
        "VB.-"
      ],
      "DR": [
        "RR.2",
        "DUT.R"
      ],
      "SR": [
        "VR.+",
        "RR.1"
      ],
      "DG": [
        "RG.2",
        "DUT.G"
      ],
      "SG": [
        "VG.+",
        "RG.1"
      ],
      "DB": [
        "RB.2",
        "DUT.B"
      ],
      "SB": [
        "VB.+",
        "RB.1"
      ]
    }
  },
  "expect": {
    "output:DUT.red_current": {
      "at": "500ns",
      "min": -1e-06,
      "max": 1e-06
    },
    "output:DUT.red": {
      "at": "500ns",
      "equals": false
    },
    "output:DUT.green_current": {
      "at": "500ns",
      "min": -1e-06,
      "max": 1e-06
    },
    "output:DUT.green": {
      "at": "500ns",
      "equals": false
    },
    "output:DUT.blue_current": {
      "at": "500ns",
      "min": -1e-06,
      "max": 1e-06
    },
    "output:DUT.blue": {
      "at": "500ns",
      "equals": false
    },
    "output:DUT.lit": {
      "at": "500ns",
      "equals": false
    },
    "output:DUT.color": {
      "at": "500ns",
      "equals": "#000000"
    }
  }
}
