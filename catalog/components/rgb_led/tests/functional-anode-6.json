{
  "schema_version": 1,
  "kind": "component_test",
  "name": "functional-anode-6",
  "description": "functional anode 6",
  "policy": "functional",
  "until": "1us",
  "circuit": {
    "components": [
      {
        "id": "H",
        "component": "emblink/logic_level",
        "params": {
          "level": 1
        }
      },
      {
        "id": "L",
        "component": "emblink/logic_level",
        "params": {
          "level": 0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/rgb_led",
        "params": {
          "common": "anode"
        }
      }
    ],
    "nets": {
      "HI": [
        "H.OUT",
        "DUT.COM",
        "DUT.R"
      ],
      "LO": [
        "L.OUT",
        "DUT.G",
        "DUT.B"
      ]
    }
  },
  "expect": {
    "output:DUT.color": {
      "at": "500ns",
      "equals": "#00ffff"
    },
    "output:DUT.lit": {
      "at": "500ns",
      "equals": true
    }
  }
}
