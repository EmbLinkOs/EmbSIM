{
  "schema_version": 1,
  "kind": "component_test",
  "name": "electrical-anode-nominal",
  "description": "electrical anode nominal",
  "policy": "electrical",
  "until": "1us",
  "circuit": {
    "components": [
      {
        "id": "DUT",
        "component": "emblink/rgb_led",
        "params": {
          "common": "anode"
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      },
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "dc": 5
        }
      },
      {
        "id": "RR",
        "component": "emblink/resistor",
        "params": {
          "resistance": 159
        }
      },
      {
        "id": "RG",
        "component": "emblink/resistor",
        "params": {
          "resistance": 144
        }
      },
      {
        "id": "RB",
        "component": "emblink/resistor",
        "params": {
          "resistance": 104
        }
      }
    ],
    "nets": {
      "GND": [
        "G.GND",
        "VC.-",
        "RR.1",
        "RG.1",
        "RB.1"
      ],
      "COM": [
        "VC.+",
        "DUT.COM"
      ],
      "DR": [
        "RR.2",
        "DUT.R"
      ],
      "DG": [
        "RG.2",
        "DUT.G"
      ],
      "DB": [
        "RB.2",
        "DUT.B"
      ]
    }
  },
  "expect": {
    "output:DUT.red_current": {
      "at": "500ns",
      "min": 0.019,
      "max": 0.021
    },
    "output:DUT.red": {
      "at": "500ns",
      "equals": true
    },
    "output:DUT.green_current": {
      "at": "500ns",
      "min": 0.019,
      "max": 0.021
    },
    "output:DUT.green": {
      "at": "500ns",
      "equals": true
    },
    "output:DUT.blue_current": {
      "at": "500ns",
      "min": 0.019,
      "max": 0.021
    },
    "output:DUT.blue": {
      "at": "500ns",
      "equals": true
    },
    "output:DUT.lit": {
      "at": "500ns",
      "equals": true
    },
    "device:DUT.p": {
      "at": "500ns",
      "min": 0.13,
      "max": 0.145
    },
    "device:VC.i": {
      "at": "500ns",
      "min": -0.061,
      "max": -0.059
    }
  }
}
