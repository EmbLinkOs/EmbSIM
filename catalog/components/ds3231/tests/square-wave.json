{
  "schema_version": 1,
  "kind": "component_test",
  "name": "square-wave",
  "description": "INTCN cleared and RS = 01: INT#/SQW gives a 1.024 kHz square wave.",
  "policy": "functional",
  "until": "46ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "0"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/ds3231"
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "INT": [
        "DUT.INT_SQW",
        "PU3.1"
      ]
    }
  },
  "expect": {
    "net:INT": {
      "between": [
        "5ms",
        "45ms"
      ],
      "frequency_hz": 1024,
      "tolerance": 0.02
    }
  }
}
