{
  "schema_version": 1,
  "kind": "component_test",
  "name": "alarm2",
  "description": "Alarm 2 on minutes = 01 (A2M3, A2M4 set): A2F sets at 00:01:00, with no interrupt as A2IE is clear.",
  "policy": "functional",
  "until": "61s",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "0"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/ds3231"
      },
      {
        "id": "PU3",
        "component": "emblink/pull_up"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "INT": [
        "DUT.INT_SQW",
        "PU3.1"
      ]
    }
  },
  "expect": {
    "output:DUT.alarm2": {
      "at": "60500ms",
      "equals": true
    },
    "pin:DUT.INT_SQW": {
      "at": "60500ms",
      "logic": "1"
    }
  }
}
