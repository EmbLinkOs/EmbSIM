{
  "schema_version": 1,
  "kind": "component_test",
  "name": "temperature",
  "description": "The power-up conversion stores 23.6 C as 23.5 (0.25 C steps); after the air cools to -7.3 C, CONV at 1 s gives -7.25 125 ms later.",
  "policy": "functional",
  "until": "1300ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "1000m"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/ds3231"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ]
    }
  },
  "expect": {
    "output:DUT.temperature": {
      "at": "1200ms",
      "equals": -7.25
    }
  },
  "inputs": [
    {
      "at": "0",
      "target": "DUT",
      "input": "temperature",
      "value": 23.6
    },
    {
      "at": "500ms",
      "target": "DUT",
      "input": "temperature",
      "value": -7.3
    }
  ]
}
