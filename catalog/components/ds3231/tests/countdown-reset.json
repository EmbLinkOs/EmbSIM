{
  "schema_version": 1,
  "kind": "component_test",
  "name": "countdown-reset",
  "description": "Writing the seconds register at 0.7 s restarts the countdown chain: the clock still reads 00:00:00 at 1.5 s (the next second comes at 1.7 s).",
  "policy": "functional",
  "until": "1600ms",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3,
          "start": "700m"
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "DUT",
        "component": "emblink/ds3231"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ]
    }
  },
  "expect": {
    "output:DUT.time": {
      "at": "1500ms",
      "equals": "2000-01-01 00:00:00"
    }
  }
}
