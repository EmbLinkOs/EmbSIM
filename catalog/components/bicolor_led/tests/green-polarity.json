{
  "schema_version": 1,
  "kind": "component_test",
  "name": "green-polarity",
  "description": "Only the forward-oriented die conducts in a resistor-limited 3.3 V circuit.",
  "policy": "electrical",
  "until": "1ms",
  "circuit": {
    "components": [
      {
        "id": "V",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": 3.3
        }
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": 220
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bicolor_led"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V.+",
        "R.1"
      ],
      "FEED": [
        "R.2",
        "DUT.2"
      ],
      "GND": [
        "V.-",
        "G.GND",
        "DUT.1"
      ]
    }
  },
  "expect": {
    "output:DUT.GREEN.luminance": {
      "at": "0.5ms",
      "min": 0.15,
      "max": 0.5
    },
    "device:DUT.GREEN.i": {
      "at": "0.5ms",
      "min": 0.003,
      "max": 0.009
    },
    "output:DUT.RED.luminance": {
      "at": "0.5ms",
      "min": 0,
      "max": 1e-06
    }
  }
}
