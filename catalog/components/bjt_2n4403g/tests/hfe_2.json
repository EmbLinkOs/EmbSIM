{
  "schema_version": 1,
  "kind": "component_test",
  "name": "hfe_2",
  "description": "IC near 0.01 A at VCE = 1 V (the base fed 5.78035e-05 A, the collector from 2 V through 100 ohm): the gain at least 100, the datasheet's hFE there",
  "policy": "electrical",
  "until": "200us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "VC",
        "component": "emblink/vsource",
        "params": {
          "kind": "dc",
          "dc": -2.0
        }
      },
      {
        "id": "RC",
        "component": "emblink/resistor",
        "params": {
          "resistance": 100.0,
          "tolerance": 0
        }
      },
      {
        "id": "IB",
        "component": "emblink/isource",
        "params": {
          "kind": "pulse",
          "v1": 0,
          "v2": -5.7803468208092484e-05,
          "td": "1u",
          "tr": "50u",
          "tf": "1u",
          "pw": "1",
          "per": "2"
        }
      },
      {
        "id": "DUT",
        "component": "emblink/bjt_2n4403g"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VC.+",
        "RC.1"
      ],
      "COLL": [
        "RC.2",
        "DUT.C"
      ],
      "BASE": [
        "IB.-",
        "DUT.B"
      ],
      "GND": [
        "VC.-",
        "IB.+",
        "DUT.E",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:COLL": {
      "at": "150us",
      "min_v": -1.422,
      "max_v": -0.0
    }
  }
}
