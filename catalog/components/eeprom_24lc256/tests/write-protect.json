{
  "schema_version": 1,
  "kind": "component_test",
  "name": "write-protect",
  "description": "WP high: the page write is not committed, but the write cycle still runs.",
  "policy": "functional",
  "until": "162us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "L",
        "component": "emblink/logic_level",
        "params": {
          "level": 0
        }
      },
      {
        "id": "H",
        "component": "emblink/logic_level",
        "params": {
          "level": 1
        }
      },
      {
        "id": "DUT",
        "component": "emblink/eeprom_24lc256",
        "params": {
          "view_at": 32704
        }
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "LO": [
        "L.OUT",
        "DUT.A0"
      ],
      "HI": [
        "H.OUT",
        "DUT.WP"
      ]
    }
  },
  "expect": {
    "output:DUT.writes": {
      "at": "152us",
      "equals": 0
    },
    "output:DUT.cycles": {
      "at": "152us",
      "equals": 1
    },
    "output:DUT.busy": {
      "at": "152us",
      "equals": true
    },
    "output:DUT.view": {
      "at": "152us",
      "contains": "FFFFFFFF"
    }
  }
}
