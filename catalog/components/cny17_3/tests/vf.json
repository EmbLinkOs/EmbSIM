{
  "schema_version": 1,
  "kind": "component_test",
  "name": "vf",
  "description": "IF = 60 mA: VF under the datasheet's 1.65 V maximum, near its 1.39 V typical",
  "policy": "electrical",
  "until": "100us",
  "settings": {
    "imperfections": "ideal"
  },
  "circuit": {
    "components": [
      {
        "id": "IF",
        "component": "emblink/isource",
        "params": {
          "dc": 0.06
        }
      },
      {
        "id": "DUT",
        "component": "emblink/cny17_3"
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "AN": [
        "IF.-",
        "DUT.A"
      ],
      "GND": [
        "IF.+",
        "DUT.K",
        "DUT.E",
        "DUT.C",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:AN": {
      "at": "50us",
      "min_v": 1.29,
      "max_v": 1.65
    }
  }
}
