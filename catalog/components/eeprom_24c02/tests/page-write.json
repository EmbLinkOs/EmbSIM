{
  "schema_version": 1,
  "kind": "component_test",
  "name": "page-write",
  "description": "Two bytes written from address 0x10: A5 then 5A in the memory.",
  "policy": "functional",
  "until": "155us",
  "circuit": {
    "components": [
      {
        "id": "PG",
        "component": "emblink/pattern_generator",
        "params": {
          "pattern": "3,3,2,0,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,1,3,1,0,2,0,0,2,0,0,2,0,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,1,3,1,0,2,0,1,3,1,0,2,0,1,3,1,0,2,3",
          "period": "1u",
          "drive": "open_drain",
          "idle": 3
        }
      },
      {
        "id": "PU1",
        "component": "emblink/pull_up"
      },
      {
        "id": "PU2",
        "component": "emblink/pull_up"
      },
      {
        "id": "L",
        "component": "emblink/logic_level",
        "params": {
          "level": 0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/eeprom_24c02"
      }
    ],
    "nets": {
      "SDA": [
        "PG.OUT0",
        "DUT.SDA",
        "PU1.1"
      ],
      "SCL": [
        "PG.OUT1",
        "DUT.SCL",
        "PU2.1"
      ],
      "LO": [
        "L.OUT",
        "DUT.WP"
      ]
    }
  },
  "expect": {
    "output:DUT.writes": {
      "at": "135us",
      "equals": 2
    },
    "output:DUT.dump": {
      "at": "135us",
      "contains": "A55A"
    },
    "output:DUT.busy": {
      "at": "135us",
      "equals": true
    }
  }
}
