{
  "schema_version": 1,
  "kind": "component_test",
  "name": "rail",
  "description": "As a follower, 3.3 V in on a 3.3 V supply into 2 kOhm: the output comes within about 60 mV of the rail (rail-to-rail, less its drop under load).",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 3.3
        }
      },
      {
        "id": "VI",
        "component": "emblink/vsource",
        "params": {
          "dc": 3.3
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tsv631"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 2000
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VS.+",
        "DUT.VCC+"
      ],
      "IN": [
        "VI.+",
        "DUT.IN+"
      ],
      "OUT": [
        "DUT.OUT",
        "DUT.IN-",
        "RL.1"
      ],
      "GND": [
        "VS.-",
        "VI.-",
        "DUT.VCC-",
        "RL.2",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "1ms",
      "min_v": 3.23,
      "max_v": 3.3
    }
  }
}
