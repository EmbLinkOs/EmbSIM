{
  "schema_version": 1,
  "kind": "component_test",
  "name": "follower",
  "description": "As a voltage follower on 3.3 V (MB1137's U7): 2.5 V in gives 2.5 V out into 2 kOhm.",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 3.3
        }
      },
      {
        "id": "VI",
        "component": "emblink/vsource",
        "params": {
          "dc": 2.5
        }
      },
      {
        "id": "DUT",
        "component": "emblink/tsv631"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 2000
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VCC": [
        "VS.+",
        "DUT.VCC+"
      ],
      "IN": [
        "VI.+",
        "DUT.IN+"
      ],
      "OUT": [
        "DUT.OUT",
        "DUT.IN-",
        "RL.1"
      ],
      "GND": [
        "VS.-",
        "VI.-",
        "DUT.VCC-",
        "RL.2",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:OUT": {
      "at": "1ms",
      "min_v": 2.49,
      "max_v": 2.51
    }
  }
}
