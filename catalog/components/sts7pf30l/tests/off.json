{
  "schema_version": 1,
  "kind": "component_test",
  "name": "off",
  "description": "VGS = 0 with 5 V across it into 1 kOhm: off.",
  "policy": "electrical",
  "until": "2ms",
  "circuit": {
    "components": [
      {
        "id": "VS",
        "component": "emblink/vsource",
        "params": {
          "dc": 5.0
        }
      },
      {
        "id": "DUT",
        "component": "emblink/sts7pf30l"
      },
      {
        "id": "R",
        "component": "emblink/resistor",
        "params": {
          "resistance": 1000
        }
      },
      {
        "id": "G0",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "S": [
        "VS.+",
        "DUT.S",
        "DUT.G"
      ],
      "D": [
        "DUT.D",
        "R.1"
      ],
      "GND": [
        "VS.-",
        "R.2",
        "G0.GND"
      ]
    }
  },
  "expect": {
    "net:D": {
      "at": "1ms",
      "max_v": 0.05
    }
  }
}
