{
  "schema_version": 1,
  "kind": "component_test",
  "name": "regulation",
  "description": "The table's own conditions (VI = -10 V, IO = 500 mA): VO inside its 25 C minimum and maximum",
  "policy": "electrical",
  "until": "100us",
  "circuit": {
    "components": [
      {
        "id": "V1",
        "component": "emblink/vsource",
        "params": {
          "dc": -10
        }
      },
      {
        "id": "DUT",
        "component": "emblink/mc7905c"
      },
      {
        "id": "RL",
        "component": "emblink/resistor",
        "params": {
          "resistance": 10.0,
          "tolerance": 0
        }
      },
      {
        "id": "G",
        "component": "emblink/gnd"
      }
    ],
    "nets": {
      "VIN": [
        "V1.+",
        "DUT.IN"
      ],
      "VOUT": [
        "DUT.OUT",
        "RL.1"
      ],
      "GND": [
        "V1.-",
        "DUT.GND",
        "RL.2",
        "G.GND"
      ]
    }
  },
  "expect": {
    "net:VOUT": {
      "at": "50us",
      "min_v": -5.2,
      "max_v": -4.8
    }
  }
}
