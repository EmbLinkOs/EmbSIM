  "version": "1.0.0",
  "name": "BPW34",
  "category": "optoelectronics",
  "description": "Silicon PIN photodiode: nominal 50 uA at 10 W/m2 and 950 nm, reverse-biased; simple forward knee.",
  "keywords": [
    "optoelectronics",
    "BPW34",
    "Vishay",
    "Leaded top-view"
  ],
  "pins": [
    {
      "name": "A",
      "number": 2,
      "model": {
        "kind": "passive"
      },
      "doc": "A"
    },
    {
      "name": "K",
      "number": 1,
      "model": {
        "kind": "passive"
      },
      "doc": "K"
    }
  ],
  "params": {
    "sensitivity": {
      "type": "number",
      "default": 5e-06,
      "doc": "Nominal reverse photocurrent per irradiance at the 950 nm reference wavelength.",
      "unit": "A/(W/m2)",
      "min": 0,
      "max": 0.01
    },
    "vf": {
      "type": "number",
      "default": 0.6,
      "doc": "Forward knee voltage of the piecewise-linear input diode approximation.",
      "unit": "V",
      "min": 0,
      "max": 5
    },
    "r_forward": {
      "type": "number",
      "default": 20,
      "doc": "Forward slope resistance above the knee; the model does not include a precision diode curve.",
      "unit": "ohm",
      "min": 0.01,
      "max": 1000000.0
    },
    "r_shunt": {
      "type": "number",
      "default": 10000000000.0,
      "doc": "Photodiode leakage shunt resistance.",
      "unit": "ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  },
  "model": {
    "primitive": "photodiode"
  },
  "inputs": [
    {
      "name": "irradiance",
      "type": "number",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "W/m2",
      "doc": "External environment; change live while running."
    }
  ],
  "outputs": [
    {
      "name": "photocurrent",
      "type": "number",
      "unit": "A"
    }
  ],
  "symbol": {
    "svg": "symbol.svg",
    "width": 160,
