{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cube-vendor",
 "description": "A Blue Pill running an application built with ST's unmodified STM32F1 HAL and CMSIS device files (tests/vendor/stm32cube/run.py puts the image beside this file as sketch.elf): a button on PA0, a terminal on PA9/PA10 at 115200 baud, a 1.0 V source on PA4, and PA6 through a 10 kOhm, 4.7 uF low-pass into PA1.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/bluepill",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 700,
    "y": 300
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "V1",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 1.0
   },
   "layout": {
    "x": 720,
    "y": 700
   }
  },
  {
   "id": "R1",
   "component": "emblink/resistor",
   "params": {
    "resistance": 10000
   },
   "layout": {
    "x": 520,
    "y": 700
   }
  },
  {
   "id": "C1",
   "component": "emblink/capacitor",
   "params": {
    "capacitance": 4.7e-06
   },
   "layout": {
    "x": 420,
    "y": 760
   }
  }
 ],
 "nets": {
  "GND": [
   "B1.GND",
   "GND1.GND",
   "SW1.2",
   "VT1.GND",
   "V1.-",
   "C1.2"
  ],
  "BTN": [
   "B1.A0",
   "SW1.1"
  ],
  "UART_TX": [
   "B1.A9",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.A10",
   "VT1.TX"
  ],
  "VIN": [
   "B1.A4",
   "V1.+"
  ],
  "PWM1": [
   "B1.A6",
   "R1.1"
  ],
  "RC": [
   "R1.2",
   "C1.1",
   "B1.A1"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "pc13",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "pwm1",
   "target": "net:PWM1",
   "kind": "digital"
  },
  {
   "id": "pwm2",
   "target": "net:B1.PA7",
   "kind": "digital"
  }
 ]
}
