{
  "schema_version": 1,
  "kind": "scenario",
  "name": "gpio_exti",
  "until": "1.2s",
  "description": "GPIO_EXTI: EXTI15_10 on PC13's falling edge (B1 pressed: active low on the NUCLEO-G474RE) toggles LD2 in its callback, once per press.",
  "inputs": [
    {
      "at": "200ms",
      "target": "B1.B1",
      "input": "pressed",
      "value": true
    },
    {
      "at": "300ms",
      "target": "B1.B1",
      "input": "pressed",
      "value": false
    },
    {
      "at": "700ms",
      "target": "B1.B1",
      "input": "pressed",
      "value": true
    },
    {
      "at": "800ms",
      "target": "B1.B1",
      "input": "pressed",
      "value": false
    }
  ],
  "assertions": [
    {
      "id": "dark",
      "between": [
        "100ms",
        "190ms"
      ],
      "probe": "led",
      "expect": {
        "logic": "0"
      }
    },
    {
      "id": "first",
      "between": [
        "250ms",
        "650ms"
      ],
      "probe": "led",
      "expect": {
        "logic": "1"
      }
    },
    {
      "id": "second",
      "between": [
        "750ms",
        "1.15s"
      ],
      "probe": "led",
      "expect": {
        "logic": "0"
      }
    }
  ]
}
