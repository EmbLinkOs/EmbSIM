{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubeg4-nucleo-g474re-tim-pwmoutput",
 "description": "A NUCLEO-G474RE running one of STM32CubeG4's examples for it, built from ST's unmodified sources (tests/vendor/stm32cubeg4/run.py puts the image beside this file as sketch.elf), on its STLINK-V3E's USB power. The console is the STLINK-V3E's virtual COM port on LPUART1; LD2 is on PA5, B1 on PC13 (active low). Probes on TIM1's channels, PA8 to PA11.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_g474re",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PA5",
   "kind": "digital"
  },
  {
   "id": "button",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "pa8",
   "target": "net:B1.PA8",
   "kind": "digital"
  },
  {
   "id": "pa9",
   "target": "net:B1.PA9",
   "kind": "digital"
  },
  {
   "id": "pa10",
   "target": "net:B1.PA10",
   "kind": "digital"
  },
  {
   "id": "pa11",
   "target": "net:B1.PA11",
   "kind": "digital"
  }
 ]
}
