{
  "schema_version": 1,
  "kind": "scenario",
  "name": "tim_octoggle",
  "until": "100ms",
  "description": "TIM_OCToggle: TIM1 at 17 MHz, its channels in toggle mode, each CC interrupt moving CCRx on by its value: 2125 Hz on PA8, 4250 Hz on PA9, 8500 Hz on PA10, 17 kHz on PA11, each at 50 %.",
  "inputs": [],
  "assertions": [
    {
      "id": "pa8-f",
      "between": [
        "20ms",
        "90ms"
      ],
      "probe": "pa8",
      "expect": {
        "frequency_hz": 2125
      },
      "tolerance": 0.01
    },
    {
      "id": "pa9-f",
      "between": [
        "20ms",
        "90ms"
      ],
      "probe": "pa9",
      "expect": {
        "frequency_hz": 4250
      },
      "tolerance": 0.01
    },
    {
      "id": "pa10-f",
      "between": [
        "20ms",
        "90ms"
      ],
      "probe": "pa10",
      "expect": {
        "frequency_hz": 8500
      },
      "tolerance": 0.01
    },
    {
      "id": "pa11-f",
      "between": [
        "20ms",
        "90ms"
      ],
      "probe": "pa11",
      "expect": {
        "frequency_hz": 17000
      },
      "tolerance": 0.01
    },
    {
      "id": "pa8-duty",
      "between": [
        "20ms",
        "90ms"
      ],
      "probe": "pa8",
      "expect": {
        "min": 0.49,
        "max": 0.51
      },
      "measure": "duty_cycle"
    }
  ]
}
