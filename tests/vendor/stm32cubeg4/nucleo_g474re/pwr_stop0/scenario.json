{
  "schema_version": 1,
  "kind": "scenario",
  "name": "pwr_stop0",
  "until": "11s",
  "description": "PWR_STOP0: LD2 toggled from SysTick for 5 s at 170 MHz, then every port but C put in analog mode (LD2 dark) and Stop 0 entered by WFI with SysTick suspended; B1's press (a falling edge on EXTI13) wakes the part on HSI16, SYSCLKConfig_STOP brings the PLL back and LD2 toggles for 5 s more.",
  "inputs": [
    {
      "at": "7500ms",
      "target": "B1.B1",
      "input": "pressed",
      "value": true
    },
    {
      "at": "7600ms",
      "target": "B1.B1",
      "input": "pressed",
      "value": false
    }
  ],
  "assertions": [
    {
      "id": "run",
      "between": [
        "500ms",
        "4.8s"
      ],
      "probe": "led",
      "expect": {
        "min": 0.3,
        "max": 0.7
      },
      "measure": "duty_cycle"
    },
    {
      "id": "stop",
      "between": [
        "5.3s",
        "7.4s"
      ],
      "probe": "pa5v",
      "expect": {
        "max_v": 0.5
      }
    },
    {
      "id": "woken",
      "between": [
        "8s",
        "10.9s"
      ],
      "probe": "led",
      "expect": {
        "min": 0.3,
        "max": 0.7
      },
      "measure": "duty_cycle"
    }
  ]
}
