{
  "schema_version": 1,
  "kind": "scenario",
  "name": "example-rtc",
  "until": "1.5s",
  "description": "software/example-rtc: the always-on RTC on the 32.768 kHz clock, its compare a second away, its interrupt through the PLIC (source 2) a second after the RTC starts, not before; then exit 0.",
  "assertions": [
    {
      "id": "started",
      "at": "900ms",
      "probe": "terminal",
      "expect": {
        "equals": "Starting RTC\n\n"
      }
    },
    {
      "id": "caught",
      "at": "1.1s",
      "probe": "terminal",
      "expect": {
        "contains": "Starting RTC\n\nCaught RTC interrupt"
      }
    },
    {
      "id": "exit",
      "at": "1.5s",
      "probe": "terminal",
      "expect": {
        "contains": "exit 0"
      }
    },
    {
      "id": "clean",
      "always": true,
      "diagnostics": {
        "forbid": [
          "mcu.fault",
          "mcu.bus_error",
          "mcu.lockup"
        ]
      }
    }
  ]
}
