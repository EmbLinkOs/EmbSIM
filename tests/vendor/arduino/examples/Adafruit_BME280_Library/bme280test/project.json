{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-bme280",
 "description": "Adafruit's bme280test as its breakout wires it: a BME280 on the Uno's I2C pins (A4/A5) powered from the board's 3.3 V, SDO pulled up to 3.3 V (address 0x77, the library's default), CSB pulled up (I2C), 4.7 kOhm pull-ups on SDA and SCL to 3.3 V (the Uno reads 3.3 V as high: VIH is 0.6 VCC, 3.0 V), and a terminal on D0/D1 at 9600 baud.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 9600
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "U1",
   "component": "emblink/bme280",
   "layout": {
    "x": 120,
    "y": 700
   }
  },
  {
   "id": "RSDA",
   "component": "emblink/resistor",
   "params": {
    "resistance": 4700
   },
   "layout": {
    "x": 220,
    "y": 640
   }
  },
  {
   "id": "RSCL",
   "component": "emblink/resistor",
   "params": {
    "resistance": 4700
   },
   "layout": {
    "x": 250,
    "y": 640
   }
  },
  {
   "id": "RSDO",
   "component": "emblink/resistor",
   "params": {
    "resistance": 10000
   },
   "layout": {
    "x": 280,
    "y": 640
   }
  },
  {
   "id": "RCSB",
   "component": "emblink/resistor",
   "params": {
    "resistance": 10000
   },
   "layout": {
    "x": 310,
    "y": 640
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "VT1.GND",
   "U1.GND",
   "U1.GND2"
  ],
  "V3V3": [
   "B1.3V3",
   "U1.VDD",
   "U1.VDDIO",
   "RSDA.1",
   "RSCL.1",
   "RSDO.1",
   "RCSB.1"
  ],
  "UART_TX": [
   "B1.D1",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.D0",
   "VT1.TX"
  ],
  "I2C_SDA": [
   "B1.SDA",
   "U1.SDI",
   "RSDA.2"
  ],
  "I2C_SCL": [
   "B1.SCL",
   "U1.SCK",
   "RSCL.2"
  ],
  "SDO": [
   "U1.SDO",
   "RSDO.2"
  ],
  "CSB": [
   "U1.CSB",
   "RCSB.2"
  ]
 },
 "probes": [
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "measurements",
   "target": "output:U1.measurements",
   "kind": "value"
  },
  {
   "id": "v3v3",
   "target": "net:V3V3",
   "kind": "analog"
  }
 ]
}
