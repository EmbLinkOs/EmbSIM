{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-neo6m",
 "description": "TinyGPSPlus's DeviceExample as its comments wire it: a GPS on SoftwareSerial, its TX to D4 (RX) and its RX from D3 (TX). The GPS is a NEO-6M breakout powered from 5 V, configured (as with u-center, saved to its battery-backed RAM) to the 4800 baud the sketch expects, after a recent fix (hot start). The sketch prints to a terminal on D0/D1 at 115200 baud.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "GPS",
   "component": "emblink/neo6m",
   "params": {
    "baud": 4800,
    "start": "hot"
   },
   "layout": {
    "x": 120,
    "y": 700
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V",
   "GPS.VCC"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "VT1.GND",
   "GPS.GND"
  ],
  "UART_TX": [
   "B1.D1",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.D0",
   "VT1.TX"
  ],
  "GPS_TX": [
   "GPS.TXD",
   "B1.D4"
  ],
  "GPS_RX": [
   "B1.D3",
   "GPS.RXD"
  ]
 },
 "probes": [
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "fix",
   "target": "output:GPS.fix",
   "kind": "value"
  }
 ]
}
