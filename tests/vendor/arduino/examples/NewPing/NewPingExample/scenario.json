{
  "schema_version": 1,
  "kind": "scenario",
  "name": "NewPingExample",
  "until": "2600ms",
  "inputs": [
    {
      "at": "0ms",
      "target": "U1",
      "input": "distance_cm",
      "value": 100
    },
    {
      "at": "500ms",
      "target": "U1",
      "input": "distance_cm",
      "value": 30
    },
    {
      "at": "1000ms",
      "target": "U1",
      "input": "distance_cm",
      "value": 250
    },
    {
      "at": "1500ms",
      "target": "U1",
      "input": "distance_cm",
      "value": 1
    },
    {
      "at": "2000ms",
      "target": "U1",
      "input": "distance_cm",
      "value": 100
    },
    {
      "at": "2000ms",
      "target": "U1",
      "input": "temperature",
      "value": 0
    }
  ],
  "assertions": [
    {
      "id": "100cm",
      "at": "450ms",
      "probe": "terminal",
      "expect": {
        "contains": "Ping: 102cm\r\nPing: 102cm\r\n"
      }
    },
    {
      "id": "30cm",
      "at": "950ms",
      "probe": "terminal",
      "expect": {
        "contains": "Ping: 102cm\r\nPing: 30cm\r\n"
      }
    },
    {
      "id": "out-of-range",
      "at": "1950ms",
      "probe": "terminal",
      "expect": {
        "contains": "Ping: 30cm\r\nPing: 0cm\r\n"
      }
    },
    {
      "id": "cold-air",
      "at": "2600ms",
      "probe": "terminal",
      "expect": {
        "contains": "Ping: 0cm\r\nPing: 105cm\r\n"
      }
    },
    {
      "id": "echo-cold",
      "at": "2500ms",
      "probe": "echo_us",
      "expect": {
        "equals": 6037
      }
    },
    {
      "id": "clean",
      "always": true,
      "diagnostics": {
        "forbid": [
          "mcu.fault",
          "mcu.bus_error",
          "mcu.unsupported_access"
        ]
      }
    }
  ],
  "description": "NewPing's NewPingExample, unmodified, pinging every 50 ms. At 100 cm in air at 20 C the echo is 5824 us, which NewPing (57 us per cm, truncated) prints as 102 cm; at 30 cm, 1747 us, 30 cm; at 250 cm, past the sketch's 200 cm maximum, and at 1 cm, under the module's 2 cm (its 38 ms timeout), 0; at 100 cm in air at 0 C, where sound is slower (331.3 m/s), 6037 us, 105 cm."
}
