{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-hc-sr04",
 "description": "NewPing's NewPingExample as its comments wire it: an Arduino Uno with an HC-SR04 powered from the board's 5V, TRIG on D12 and ECHO on D11, and a terminal on D0/D1 at 115200 baud. The sensor stands at the bench's origin facing the back of the bench, a wall 100 cm in front of it in the room at 20 C (ADR-026).",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "U1",
   "component": "emblink/hc_sr04",
   "layout": {
    "x": 120,
    "y": 700
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V",
   "U1.VCC"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "VT1.GND",
   "U1.GND"
  ],
  "UART_TX": [
   "B1.D1",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.D0",
   "VT1.TX"
  ],
  "TRIG": [
   "B1.D12",
   "U1.TRIG"
  ],
  "ECHO": [
   "B1.D11",
   "U1.ECHO"
  ]
 },
 "probes": [
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "echo",
   "target": "net:ECHO",
   "kind": "digital"
  },
  {
   "id": "echo_us",
   "target": "output:U1.echo_us",
   "kind": "value"
  }
 ],
 "layout": {
  "bench": {
   "parts": {
    "U1": {
     "x": 0,
     "y": 0,
     "rotation": 0
    }
   }
  }
 },
 "world": {
  "fields": {
   "temperature": 20
  },
  "bodies": [
   {
    "id": "wall",
    "name": "A wall",
    "shape": "box",
    "at": [
     0,
     -1005,
     100
    ],
    "size": [
     2000,
     10,
     1000
    ]
   }
  ]
 }
}
