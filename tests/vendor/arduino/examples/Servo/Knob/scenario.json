{
  "schema_version": 1,
  "kind": "scenario",
  "name": "Knob",
  "until": "2s",
  "inputs": [
    {
      "at": "1s",
      "target": "POT",
      "input": "position",
      "value": 0.25
    },
    {
      "at": "1500ms",
      "target": "POT",
      "input": "position",
      "value": 1.0
    }
  ],
  "assertions": [
    {
      "id": "half",
      "at": "900ms",
      "probe": "angle",
      "expect": {
        "min": 88.7,
        "max": 89.1
      }
    },
    {
      "id": "turning",
      "at": "1040ms",
      "probe": "angle",
      "expect": {
        "min": 72.34,
        "max": 72.94
      }
    },
    {
      "id": "quarter",
      "at": "1100ms",
      "probe": "angle",
      "expect": {
        "min": 43.74,
        "max": 44.14
      }
    },
    {
      "id": "held",
      "at": "1500ms",
      "probe": "angle",
      "expect": {
        "min": 43.74,
        "max": 44.14
      }
    },
    {
      "id": "on-its-way",
      "at": "1600ms",
      "probe": "angle",
      "expect": {
        "min": 96.48,
        "max": 97.08
      }
    },
    {
      "id": "full",
      "at": "1900ms",
      "probe": "angle",
      "expect": {
        "min": 179.79,
        "max": 180.19
      }
    },
    {
      "id": "clean",
      "always": true,
      "diagnostics": {
        "forbid": [
          "mcu.fault",
          "mcu.bus_error",
          "mcu.unsupported_access"
        ]
      }
    }
  ],
  "description": "The Servo library's Knob, unmodified: analogRead(A0) mapped to 0..180 deg every 15 ms. The knob at half gives 2.500 V, on the 511/512 boundary, read as 511: 89 deg, a 1459 us pulse (the library's 2 us trim) that its interrupt's latency makes 1461 us, 88.9 deg. Turned to a quarter at 1 s, the horn turns at 625 deg/s to 43.94 deg (72.6 deg 40 ms in); turned fully at 1.5 s, to 179.99 deg, still on its way at 1.6 s (96.8 deg)."
}
