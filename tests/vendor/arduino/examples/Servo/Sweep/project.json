{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-servo-sweep",
 "description": "The Servo library's Sweep example as wired in its tutorial: an Arduino Uno with an SG90-class servo on D9, powered from the board's 5V. The servo's pulse-to-angle mapping is the library's (544 to 2400 us for 0 to 180 deg), as an SG90's is.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "M1",
   "component": "emblink/servo",
   "params": {
    "min_pulse": "544u",
    "max_pulse": "2400u",
    "initial": 90
   },
   "layout": {
    "x": 120,
    "y": 700
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V",
   "M1.V+"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "M1.GND"
  ],
  "SERVO_SIG": [
   "B1.D9",
   "M1.SIG"
  ]
 },
 "probes": [
  {
   "id": "angle",
   "target": "output:M1.angle",
   "kind": "value"
  },
  {
   "id": "target",
   "target": "output:M1.target",
   "kind": "value"
  },
  {
   "id": "pulse",
   "target": "output:M1.pulse_us",
   "kind": "value"
  },
  {
   "id": "sig",
   "target": "net:SERVO_SIG",
   "kind": "digital"
  }
 ]
}
