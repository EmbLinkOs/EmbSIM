{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-ssd1306",
 "description": "Adafruit SSD1306's ssd1306_128x64_i2c example: a 0.96-inch 128x64 SSD1306 module on the Uno's I2C pins (A4/A5), powered from 5 V (its own regulator), its SA0 jumper at 0x3D as on Adafruit's breakout (the sketch's address), the module's 4.7 kOhm pull-ups, and a terminal on D0/D1 at 9600 baud.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 9600
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "RSDA",
   "component": "emblink/resistor",
   "params": {
    "resistance": 4700
   },
   "layout": {
    "x": 220,
    "y": 640
   }
  },
  {
   "id": "RSCL",
   "component": "emblink/resistor",
   "params": {
    "resistance": 4700
   },
   "layout": {
    "x": 250,
    "y": 640
   }
  },
  {
   "id": "OLED",
   "component": "emblink/ssd1306",
   "params": {
    "address": 61
   },
   "layout": {
    "x": 120,
    "y": 700
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V",
   "OLED.VCC",
   "RSDA.1",
   "RSCL.1"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "VT1.GND",
   "OLED.GND"
  ],
  "UART_TX": [
   "B1.D1",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.D0",
   "VT1.TX"
  ],
  "I2C_SDA": [
   "B1.SDA",
   "OLED.SDA",
   "RSDA.2"
  ],
  "I2C_SCL": [
   "B1.SCL",
   "OLED.SCL",
   "RSCL.2"
  ]
 },
 "probes": [
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "checksum",
   "target": "output:OLED.checksum",
   "kind": "value"
  },
  {
   "id": "lit",
   "target": "output:OLED.lit_pixels",
   "kind": "value"
  },
  {
   "id": "on",
   "target": "output:OLED.on",
   "kind": "value"
  }
 ]
}
