{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-ky040",
 "description": "PJRC Encoder's Basic example as its comments wire it: a KY-040 rotary encoder module with CLK on D5 and DT on D6 (the sketch's pins: no interrupt pins, so the library polls), + on 5 V for its pull-ups, and a terminal on D0/D1 at 9600 baud.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/arduino_uno",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 9600
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  },
  {
   "id": "ENC",
   "component": "emblink/rotary_encoder",
   "layout": {
    "x": 120,
    "y": 700
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.5V",
   "ENC.VCC"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "VT1.GND",
   "ENC.GND"
  ],
  "UART_TX": [
   "B1.D1",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.D0",
   "VT1.TX"
  ],
  "ENC_A": [
   "B1.D5",
   "ENC.CLK"
  ],
  "ENC_B": [
   "B1.D6",
   "ENC.DT"
  ]
 },
 "probes": [
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "count",
   "target": "output:ENC.count",
   "kind": "value"
  }
 ]
}
