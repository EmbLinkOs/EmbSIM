{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-esp32-ESP32_DigitalReadSerial",
 "description": "DigitalReadSerial as its comment wires it: a push button from 3V3 to IO2 (pin 2), 10 kohm from IO2 to ground. On the ESP32-DevKitC V4 (pin 2 is GPIO2).",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32_devkitc",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 120,
    "y": 460
   }
  },
  {
   "id": "R1",
   "component": "emblink/resistor",
   "params": {
    "resistance": 10000
   },
   "layout": {
    "x": 260,
    "y": 460
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND1",
   "R1.2"
  ],
  "3V3": [
   "B1.3V3",
   "SW1.1"
  ],
  "BTN": [
   "SW1.2",
   "B1.IO2",
   "R1.1"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  }
 ]
}