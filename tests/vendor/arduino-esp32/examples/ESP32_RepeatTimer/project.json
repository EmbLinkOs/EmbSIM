{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-esp32-ESP32_RepeatTimer",
 "description": "RepeatTimer on the ESP32-DevKitC V4: BTN_STOP_ALARM is GPIO0, the board's own Boot button (SW1).",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32_devkitc",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  }
 ],
 "nets": {
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND1"
  ],
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  }
 ]
}