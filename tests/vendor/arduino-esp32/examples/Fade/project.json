{
 "schema_version": 1,
 "kind": "project",
 "name": "arduino-esp32-Fade",
 "description": "Fade as its comment wires it: an LED and 220 ohm from IO9 (pin 9; also the board's BOOT button and its pull-up) to ground.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32c3_devkitm1",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "R1",
   "component": "emblink/resistor",
   "params": {
    "resistance": 220
   },
   "layout": {
    "x": 120,
    "y": 460
   }
  },
  {
   "id": "D1",
   "component": "emblink/led",
   "layout": {
    "x": 260,
    "y": 460
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "D1.K"
  ],
  "PWM": [
   "B1.IO9",
   "R1.1"
  ],
  "LED_A": [
   "R1.2",
   "D1.A"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "pwm",
   "target": "net:B1.GPIO9",
   "kind": "digital"
  }
 ]
}
