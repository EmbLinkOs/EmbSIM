{
 "schema_version": 1,
 "kind": "project",
 "name": "esp-idf-http_request",
 "description": "An ESP32-C3-DevKitM-1 running ESP-IDF's protocols/http_request, plugged into USB, 5 m from a home router (myssid, WPA2-PSK mypassword, channel 6) whose WAN side reaches the internet, where example.com's web server is. A USB power meter sits between the port and the cable.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32c3_devkitm1",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "ROUTER",
   "component": "emblink/wifi_ap",
   "params": {
    "ssid": "myssid",
    "password": "mypassword",
    "channel": 6,
    "bssid": "02:e5:00:00:00:02"
   },
   "layout": {
    "x": 640,
    "y": 260
   }
  },
  {
   "id": "WEB",
   "component": "emblink/web_server",
   "layout": {
    "x": 640,
    "y": 260
   }
  },
  {
   "id": "METER",
   "component": "emblink/usb_power_meter",
   "layout": {
    "x": 240,
    "y": 160
   }
  }
 ],
 "nets": {
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "METER.GND"
  ],
  "HOSTV": [
   "USB.+",
   "METER.IN"
  ],
  "USB5V": [
   "METER.OUT",
   "B1.VBUS"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "router",
   "target": "output:ROUTER.log",
   "kind": "value"
  },
  {
   "id": "web",
   "target": "output:WEB.log",
   "kind": "value"
  },
  {
   "id": "requests",
   "target": "output:WEB.requests",
   "kind": "value"
  },
  {
   "id": "usb_current",
   "target": "output:METER.current",
   "kind": "value"
  },
  {
   "id": "usb_voltage",
   "target": "output:METER.voltage",
   "kind": "value"
  }
 ],
 "layout": {
  "bench": {
   "parts": {
    "B1": {
     "x": 0.0,
     "y": 0.0,
     "rotation": 0
    },
    "ROUTER": {
     "x": 0.0,
     "y": 5000.0,
     "rotation": 0
    }
   }
  }
 }
}
