{
 "schema_version": 1,
 "kind": "project",
 "name": "esp-idf-adc_oneshot_read",
 "description": "ESP-IDF's adc/oneshot_read on the ESP32-C3-DevKitM-1: 1.1 V on IO2 and 2.2 V on IO3 from two sources.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32c3_devkitm1",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "V2",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 1.1
   },
   "layout": {
    "x": 120,
    "y": 440
   }
  },
  {
   "id": "V3",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 2.2
   },
   "layout": {
    "x": 120,
    "y": 560
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "V2.-",
   "V3.-"
  ],
  "IO2": [
   "V2.+",
   "B1.IO2"
  ],
  "IO3": [
   "V3.+",
   "B1.IO3"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  }
 ]
}
