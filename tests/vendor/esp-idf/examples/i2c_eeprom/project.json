{
 "schema_version": 1,
 "kind": "project",
 "name": "esp-idf-i2c_eeprom",
 "description": "ESP-IDF's i2c/i2c_eeprom on the ESP32-C3-DevKitM-1: a 24LC256 at 0x50 (A0-A2 and WP grounded) on SCL IO4 and SDA IO5 at 400 kHz, the example's defaults, with 4.7 kohm pull-ups to 3V3 (the example enables no internal pull-ups). The part's write cycle is set to 2 ms, a part faster than the datasheet's 5 ms maximum: the example waits pdMS_TO_TICKS(10), one tick at FreeRTOS's 100 Hz, which ends at the next tick (here 2.4 ms after the write), and a part taking its maximum would NACK the read, on a real bench too.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32c3_devkitm1",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "U2",
   "component": "emblink/eeprom_24lc256",
   "params": {
    "view_at": 16,
    "twr": "2m"
   },
   "layout": {
    "x": 120,
    "y": 460
   }
  },
  {
   "id": "R1",
   "component": "emblink/resistor",
   "params": {
    "resistance": 4700
   },
   "layout": {
    "x": 300,
    "y": 440
   }
  },
  {
   "id": "R2",
   "component": "emblink/resistor",
   "params": {
    "resistance": 4700
   },
   "layout": {
    "x": 340,
    "y": 440
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "U2.GND",
   "U2.A0",
   "U2.A1",
   "U2.A2",
   "U2.WP"
  ],
  "3V3": [
   "B1.3V3",
   "U2.VCC",
   "R1.1",
   "R2.1"
  ],
  "I2C_SCL": [
   "B1.IO4",
   "U2.SCL",
   "R1.2"
  ],
  "I2C_SDA": [
   "B1.IO5",
   "U2.SDA",
   "R2.2"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "eeprom",
   "target": "output:U2.view",
   "kind": "value"
  },
  {
   "id": "cycles",
   "target": "output:U2.cycles",
   "kind": "value"
  }
 ]
}
