{
 "schema_version": 1,
 "kind": "project",
 "name": "esp-idf-nvs_encryption_hmac",
 "description": "ESP-IDF's security/nvs_encryption_hmac on the ESP32-C3-DevKitM-1: NVS encrypted under keys the HMAC peripheral derives from an eFuse key block, burnt at the first boot.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32c3_devkitm1",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "METER",
   "component": "emblink/usb_power_meter",
   "layout": {
    "x": 240,
    "y": 160
   }
  }
 ],
 "nets": {
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "METER.GND"
  ],
  "HOSTV": [
   "USB.+",
   "METER.IN"
  ],
  "USB5V": [
   "METER.OUT",
   "B1.VBUS"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "usb_current",
   "target": "output:METER.current",
   "kind": "value"
  },
  {
   "id": "usb_voltage",
   "target": "output:METER.voltage",
   "kind": "value"
  }
 ]
}
