{
 "schema_version": 1,
 "kind": "project",
 "name": "esp-idf-bleprph",
 "description": "An ESP32-C3-DevKitM-1 running ESP-IDF's bluetooth/nimble/bleprph, plugged into USB, with a phone's BLE scanner app 2 m from the board and a tablet with a GATT browser 1 m from it, told to connect to nimble-bleprph.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/esp32c3_devkitm1",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "flash.bin",
    "format": "bin"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "PHONE",
   "component": "emblink/ble_scanner",
   "layout": {
    "x": 640,
    "y": 120
   }
  },
  {
   "id": "TABLET",
   "component": "emblink/ble_central",
   "params": {
    "target": "nimble-bleprph"
   },
   "layout": {
    "x": 640,
    "y": 260
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "phone",
   "target": "output:PHONE.list",
   "kind": "value"
  },
  {
   "id": "phone-devices",
   "target": "output:PHONE.devices",
   "kind": "value"
  },
  {
   "id": "tablet-state",
   "target": "output:TABLET.state",
   "kind": "value"
  },
  {
   "id": "tablet-services",
   "target": "output:TABLET.services",
   "kind": "value"
  },
  {
   "id": "tablet-gatt",
   "target": "output:TABLET.gatt",
   "kind": "value"
  }
 ],
 "layout": {
  "bench": {
   "parts": {
    "B1": {
     "x": 0.0,
     "y": 0.0,
     "rotation": 0
    },
    "PHONE": {
     "x": 2000.0,
     "y": 0.0,
     "rotation": 0
    },
    "TABLET": {
     "x": 0.0,
     "y": 1000.0,
     "rotation": 0
    }
   }
  }
 }
}
