   "kind": "value"
  },
  {
   "id": "drive_read",
   "target": "output:DRIVE.sectors_read",
   "kind": "value"
  },
  {
   "id": "drive_written",
   "target": "output:DRIVE.sectors_written",
   "kind": "value"
  }
 ]
}
