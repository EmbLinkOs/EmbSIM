{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubef4-nucleo-f446ze-usb-dfu",
 "description": "A NUCLEO-F446ZE running STM32CubeF4's USB_Device/DFU_Standalone, built from ST's unmodified sources (sketch.elf), with a computer's USB port (PC) on CN13 that downloads app.dfu, ST's GPIOToggle in DfuSe format (UM0391), as DfuSe Demo or dfu-util would.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446ze",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "PC",
   "component": "emblink/usb_host",
   "layout": {
    "x": 120,
    "y": 480
   },
   "params": {
    "dfu_file": "app.dfu"
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "PC.GND"
  ],
  "OTG_VBUS": [
   "PC.VBUS",
   "B1.USB_VBUS"
  ],
  "OTG_DM": [
   "PC.DM",
   "B1.USB_DM"
  ],
  "OTG_DP": [
   "PC.DP",
   "B1.USB_DP"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PB0",
   "kind": "digital"
  },
  {
   "id": "led2",
   "target": "net:B1.PB7",
   "kind": "digital"
  },
  {
   "id": "led3",
   "target": "net:B1.PB14",
   "kind": "digital"
  },
  {
   "id": "button",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "usb_state",
   "target": "output:PC.HOST.state",
   "kind": "value"
  },
  {
   "id": "usb_vid",
   "target": "output:PC.HOST.vid",
   "kind": "value"
  },
  {
