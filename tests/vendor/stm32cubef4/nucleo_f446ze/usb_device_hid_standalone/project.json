{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubef4-nucleo-f446ze-usb-device",
 "description": "A NUCLEO-F446ZE running one of STM32CubeF4's USB device applications for it, built from ST's unmodified sources (tests/vendor/stm32cubef4/run.py --board nucleo_f446ze puts the image beside this file as sketch.elf), on its ST-LINK's USB power, with a computer's USB port (PC) on CN13, the USB OTG FS connector: its VBUS, D-, D+ and GND. Its contacts are ideal (settings.imperfections \"ideal\"): on the board B1 has no filter capacitor (C52 not fitted), so a real press reaches EXTI13 with the switch's bounce and ST's example acts on every bounce; how many depends on the switch, so the scenarios check ST's code against one clean edge per press and release.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446ze",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "PC",
   "component": "emblink/usb_host",
   "layout": {
    "x": 120,
    "y": 480
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "PC.GND"
  ],
  "OTG_VBUS": [
   "PC.VBUS",
   "B1.USB_VBUS"
  ],
  "OTG_DM": [
   "PC.DM",
   "B1.USB_DM"
  ],
  "OTG_DP": [
   "PC.DP",
   "B1.USB_DP"
  ]
 },
