{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubef4-tim_pwminput",
 "description": "A NUCLEO-F446RE running STM32CubeF4's TIM_PWMInput on USB power, a 20 kHz, 25 % pulse generator on D8 (PA9, TIM1_CH2).",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446re",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "GEN",
   "component": "emblink/vsource",
   "params": {
    "kind": "pulse",
    "v1": 0,
    "v2": 3.3,
    "td": "1m",
    "tr": "10n",
    "tf": "10n",
    "pw": "12.5u",
    "per": "50u"
   },
   "layout": {
    "x": 700,
    "y": 200
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "GEN.-"
  ],
  "SIG": [
   "GEN.+",
   "B1.D8"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PA5",
   "kind": "digital"
  },
  {
   "id": "button",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "frequency",
   "target": "var:B1:uwFrequency",
   "kind": "value"
  },
  {
   "id": "duty",
   "target": "var:B1:uwDutyCycle",
   "kind": "value"
  }
 ]
}
