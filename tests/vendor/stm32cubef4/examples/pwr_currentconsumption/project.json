{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubef4-pwr",
 "description": "A NUCLEO-F446RE running STM32CubeF4's PWR_CurrentConsumption in one of its low-power modes, built from ST's unmodified sources, on its ST-LINK's USB power. LD2 is on PA5, the USER button B1 on PC13; the WKUP button SW1 joins PA0 (A0, WKUP1) to 3V3, as the example's readme asks of a wire for Standby's wake-up.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446re",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  },
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 720,
    "y": 160
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND"
  ],
  "WKUP": [
   "SW1.1",
   "B1.A0"
  ],
  "V3V3": [
   "SW1.2",
   "B1.3V3"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PA5",
   "kind": "digital"
  },
  {
   "id": "button",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "wkup",
   "target": "net:B1.PA0",
   "kind": "digital"
  },
  {
   "id": "counter",
   "target": "var:B1:uwCounter",
   "kind": "value"
  },
  {
   "id": "pwr_csr",
   "target": "reg:B1.PWR.CSR",
   "kind": "value"
  },
  {
   "id": "rcc_csr",
   "target": "reg:B1.RCC.CSR",
   "kind": "value"
  },
  {
   "id": "rcc_cfgr",
   "target": "reg:B1.RCC.CFGR",
   "kind": "value"
  }
 ]
}
