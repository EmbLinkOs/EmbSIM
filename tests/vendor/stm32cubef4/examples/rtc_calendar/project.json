{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubef4-rtc_calendar",
 "description": "A NUCLEO-F446RE running STM32CubeF4's RTC_Calendar on USB power, its variables aShowTime and aShowDate probed.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446re",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.PA5",
   "kind": "digital"
  },
  {
   "id": "button",
   "target": "net:B1.PC13",
   "kind": "digital"
  },
  {
   "id": "showtime",
   "target": "var:B1:aShowTime",
   "kind": "value"
  },
  {
   "id": "showdate",
   "target": "var:B1:aShowDate",
   "kind": "value"
  },
  {
   "id": "bkp1r",
   "target": "reg:B1.RTC.BKP1R",
   "kind": "value"
  }
 ]
}
