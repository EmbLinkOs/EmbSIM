{
 "schema_version": 1,
 "kind": "project",
 "name": "stm32cubef4-two-boards",
 "description": "Two NUCLEO-F446RE boards running one of STM32CubeF4's I2C_TwoBoards examples, built from ST's unmodified sources: B1 the master (sketch.elf, the example as it is), B2 the slave (slave.elf, its main.c's #define MASTER_BOARD commented out as its readme asks). As the readme's figure wires them, I2C1's SCL (PB6, D10) and SDA (PB9, D14) join, with the grounds; the lines are held up only by the pins' own pull-ups, which the example's MSP turns on. Both boards run from one USB supply.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/nucleo_f446re",
   "layout": {
    "x": 360,
    "y": 120
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  },
  {
   "id": "B2",
   "board": "emblink/nucleo_f446re",
   "layout": {
    "x": 900,
    "y": 120
   },
   "firmware": {
    "image": "slave.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 120,
    "y": 160
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 120,
    "y": 320
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.U5V",
   "B2.U5V"
  ],
  "GND": [
   "USB.-",
   "GND1.GND",
   "B1.GND",
   "B2.GND"
  ],
  "SCL": [
   "B1.D10",
   "B2.D10"
  ],
  "SDA": [
   "B1.D14",
   "B2.D14"
  ]
 },
 "probes": [
  {
   "id": "led1",
   "target": "net:B1.PA5",
   "kind": "digital"
  },
  {
   "id": "led2",
   "target": "net:B2.PA5",
   "kind": "digital"
  },
  {
   "id": "scl",
   "target": "net:B1.PB6",
   "kind": "digital"
  },
  {
   "id": "sda",
   "target": "net:B1.PB9",
   "kind": "digital"
  },
  {
   "id": "master_rx",
   "target": "var:B1:aRxBuffer",
   "kind": "value"
  },
  {
   "id": "slave_rx",
   "target": "var:B2:aRxBuffer",
   "kind": "value"
  }
 ]
}
