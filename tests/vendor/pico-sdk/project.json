{
 "schema_version": 1,
 "kind": "project",
 "name": "pico-sdk-vendor",
 "description": "A Raspberry Pi Pico running an application built with the unmodified Pico SDK (tests/vendor/pico-sdk/run.py puts the image beside this file as sketch.elf): USB power, a button on GP15, a terminal on GP0/GP1 at 115200 baud.",
 "policy": "electrical",
 "boards": [
  {
   "id": "B1",
   "board": "emblink/pico",
   "layout": {
    "x": 300,
    "y": 260
   },
   "firmware": {
    "image": "sketch.elf",
    "format": "elf"
   }
  }
 ],
 "components": [
  {
   "id": "USB",
   "component": "emblink/vsource",
   "params": {
    "kind": "dc",
    "dc": 5
   },
   "layout": {
    "x": 720,
    "y": 60
   }
  },
  {
   "id": "SW1",
   "component": "emblink/push_button",
   "layout": {
    "x": 700,
    "y": 300
   }
  },
  {
   "id": "VT1",
   "component": "emblink/virtual_terminal",
   "params": {
    "baud": 115200
   },
   "layout": {
    "x": 720,
    "y": 520
   }
  },
  {
   "id": "GND1",
   "component": "emblink/gnd",
   "layout": {
    "x": 900,
    "y": 200
   }
  }
 ],
 "nets": {
  "USB5V": [
   "USB.+",
   "B1.VBUS"
  ],
  "GND": [
   "B1.GND",
   "GND1.GND",
   "USB.-",
   "SW1.2",
   "VT1.GND"
  ],
  "BTN": [
   "B1.GP15",
   "SW1.1"
  ],
  "UART_TX": [
   "B1.GP0",
   "VT1.RX"
  ],
  "UART_RX": [
   "B1.GP1",
   "VT1.TX"
  ]
 },
 "probes": [
  {
   "id": "console",
   "target": "serial:B1",
   "kind": "serial"
  },
  {
   "id": "terminal",
   "target": "serial:VT1",
   "kind": "serial"
  },
  {
   "id": "led",
   "target": "net:B1.GPIO25",
   "kind": "digital"
  }
 ]
}
